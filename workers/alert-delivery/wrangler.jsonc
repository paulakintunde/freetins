{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "freetins-alert-delivery",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freetins-app",
      "database_id": "c32f1ddb-45a5-4057-b42b-14fbd9ca24dc",
      "migrations_dir": "../../migrations"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "freetins-alert-email",
        "max_batch_size": 1,
        "max_batch_timeout": 10,
        "max_retries": 8,
        "retry_delay": 60,
        "max_concurrency": 1,
        "dead_letter_queue": "freetins-alert-email-dlq"
      },
      {
        "queue": "freetins-release-delivery",
        "max_batch_size": 1,
        "max_batch_timeout": 10,
        "max_retries": 8,
        "retry_delay": 60,
        "max_concurrency": 1,
        "dead_letter_queue": "freetins-release-delivery-dlq"
      }
    ]
  },
  "vars": {
    "SITE_URL": "https://www.freetins.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
