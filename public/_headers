/*
  # Cloudflare Web Analytics is injected at the edge, after this build's HTML is
  # written, so the beacon is a third-party script as far as the browser is concerned.
  # `script-src 'self'` blocked it on every page load, which meant the site's only
  # measurement collected nothing at all. Two origins are needed and no more:
  #   script-src   static.cloudflareinsights.com  — serves `beacon.min.js`
  #   connect-src  cloudflareinsights.com         — receives the `/cdn-cgi/rum` POST
  # `'unsafe-inline'` is deliberately NOT added. The beacon is injected as an external
  # `<script src>` with a `data-cf-beacon` attribute, so allowing the origin is enough,
  # and an inline allowance would reopen the whole class of injection this header exists
  # to close. If a future analytics vendor needs inline execution, it needs a nonce.
  #
  # The Google origins are AdSense (src/content/operations.json,
  # services.advertising; docs/ADVERTISING.md). They are listed whether or not
  # advertising is switched on, because the alternative is the failure this file
  # already describes twice: a header quietly blocking the thing an operator just
  # turned on, with the console the only place that says so. They are not a
  # licence to run — src/scripts/ads.ts requests nothing without consent, and a
  # page with no ad block requests nothing at all. pnpm check:routes fails the
  # build if advertising is enabled and these origins are missing.
  #   script-src   pagead2 / tpc / adservice / partner / googleads / tagservices
  #                — the loader and the scripts it pulls in
  #   frame-src    googleads.g.doubleclick.net, tpc, www.google.com — every
  #                creative is drawn in a cross-origin iframe from one of these,
  #                which is also why this list can stay short: the creative's own
  #                subresources are governed by that frame, not by this page
  #   connect-src  the ad request itself and the ad-traffic-quality pings
  #   img-src      widened to `https:` — AdSense writes creative images and
  #                measurement pixels into this document, from hosts no list can
  #                enumerate. Images are the one class where that trade is worth
  #                making; script-src stays enumerated
  # `'unsafe-inline'` is still NOT in script-src, for the reason given above. Some
  # ad formats want it; if a unit reports a CSP violation rather than an empty
  # inventory, that is the first thing to check and a nonce is the answer, not a
  # blanket allowance.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://tpc.googlesyndication.com https://adservice.google.com https://partner.googleadservices.com https://googleads.g.doubleclick.net https://www.googletagservices.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://cloudflareinsights.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://csi.gstatic.com; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # The old WordPress site sent `max-age=15552000; includeSubDomains; preload`.
  # Shipping the replacement without HSTS would be a straight security regression
  # against the site it replaces. `preload` is deliberately omitted: freetins.com is
  # not on the preload list today (hstspreload.org status `unknown`), and submitting
  # it is a separate, effectively irreversible decision that should be taken on its
  # own rather than smuggled into a domain cutover.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/api/*
  Cache-Control: no-store

# The sitemap stylesheet. `X-Content-Type-Options: nosniff` is set for every path
# above, so the browser takes the declared type and refuses to guess: served as
# anything but XSL the stylesheet is dropped silently and the sitemap renders as raw
# markup, with no console error to say why. `text/xsl` is the type every browser
# that implements XSLT accepts, and the one WordPress served this file under for
# the whole of the site's previous life.
/main-sitemap.xsl
  Content-Type: text/xsl; charset=utf-8
  Cache-Control: public, max-age=3600

# --- Staging hostnames: never indexable ------------------------------------
# `robots.txt` is one file served on every hostname, so it cannot say "index the
# custom domain, ignore the build host". The header can, because these rules match
# on hostname and the custom domain does not match either pattern.
#
# Without this, `freetins.pages.dev` is crawlable while every page on it canonicals
# to the custom domain — pointing crawlers at a URL that, until cutover, 301s to the
# old WordPress homepage. This stays in place after cutover so the build host and the
# live host never compete for the same queries.
#
# First pattern: the project host (`freetins.pages.dev`).
# Second: per-deployment preview hosts (`<branch-or-hash>.freetins.pages.dev`).
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:preview.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
