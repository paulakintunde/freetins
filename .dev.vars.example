# Copy to .dev.vars for local server-route development. Never commit real values.
# This salt prevents stored rate-limit fingerprints from being reversible.
RATE_LIMIT_SALT="replace-with-at-least-32-random-bytes"
# Pages and the delivery Worker must share this value so confirmation links validate.
ALERT_CONFIRMATION_SECRET="replace-with-at-least-32-random-bytes"
