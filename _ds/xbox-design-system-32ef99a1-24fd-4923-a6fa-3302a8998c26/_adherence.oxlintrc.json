{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/actions/**",
              "components/catalog/**",
              "components/commerce/**",
              "components/content/**",
              "components/disclosure/**",
              "components/shell/**",
              "ui_kits/catalog/**",
              "ui_kits/game-pass/**",
              "ui_kits/marketing-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|content|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: id, title, content."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|neutral|discount|outline)$/]",
        "message": "<Badge> tone must be one of 'brand' | 'neutral' | 'discount' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|onClick|disabled|fullWidth|type|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, onClick, disabled, fullWidth, type, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Carousel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|perView|gap|label|key|ref|className|style|children)$/]",
        "message": "<Carousel> doesn't accept that prop. Declared props: children, perView, gap, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onSelect|title|key|ref|className|style|children)$/]",
        "message": "<CategoryList> doesn't accept that prop. Declared props: items, active, onSelect, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|key|ref|className|style|children)$/]",
        "message": "<ComparisonColumn> doesn't accept that prop. Declared props: title, subtitle."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentPlacement'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageAlt|title|body|actions|layout|key|ref|className|style|children)$/]",
        "message": "<ContentPlacement> doesn't accept that prop. Declared props: image, imageAlt, title, body, actions, layout."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentPlacement'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stack|row)$/]",
        "message": "<ContentPlacement> layout must be one of 'stack' | 'row'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageAlt|headline|body|actionLabel|onAction|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: image, imageAlt, headline, body, actionLabel, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|separator|tone|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: items, separator, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|brand)$/]",
        "message": "<Eyebrow> tone must be one of 'default' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageAlt|title|body|actions|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: image, imageAlt, title, body, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|key|ref|className|style|children)$/]",
        "message": "<FilterOption> doesn't accept that prop. Declared props: label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footnote'] > JSXAttribute > JSXIdentifier[name!=/^(?:marker|title|children|key|ref|className|style|children)$/]",
        "message": "<Footnote> doesn't accept that prop. Declared props: marker, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlobalNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|active|onNavigate|showMicrosoftBar|actions|sticky|key|ref|className|style|children)$/]",
        "message": "<GlobalNav> doesn't accept that prop. Declared props: links, active, onNavigate, showMicrosoftBar, actions, sticky."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|alt|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, src, size, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:mail|facebook|x|instagram|whatsapp|tiktok|youtube|linkedin|accordion|arrowLeft|arrowRight|close|compare|gift|renew|g4eBadge)$/]",
        "message": "<Icon> name must be one of 'mail' | 'facebook' | 'x' | 'instagram' | 'whatsapp' | 'tiktok' | 'youtube' | 'linkedin' | 'accordion' | 'arrowLeft' | 'arrowRight' | 'close' | 'compare' | 'gift' | 'renew' | 'g4eBadge'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadMore'] > JSXAttribute > JSXIdentifier[name!=/^(?:canLoadMore|canLoadFewer|onLoadMore|onLoadFewer|moreLabel|fewerLabel|key|ref|className|style|children)$/]",
        "message": "<LoadMore> doesn't accept that prop. Declared props: canLoadMore, canLoadFewer, onLoadMore, onLoadFewer, moreLabel, fewerLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageAlt|scrim|align|minHeight|eyebrow|title|body|actions|key|ref|className|style|children)$/]",
        "message": "<PageHero> doesn't accept that prop. Declared props: image, imageAlt, scrim, align, minHeight, eyebrow, title, body, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHero'] > JSXAttribute[name.name='scrim'] > Literal[value!=/^(?:left|bottom|flat)$/]",
        "message": "<PageHero> scrim must be one of 'left' | 'bottom' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHero'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<PageHero> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|previousPrice|period|size|key|ref|className|style|children)$/]",
        "message": "<PriceTag> doesn't accept that prop. Declared props: price, previousPrice, period, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<PriceTag> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageAlt|title|subtitle|price|previousPrice|discount|href|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: image, imageAlt, title, subtitle, price, previousPrice, discount, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|onSubmit|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: label, placeholder, value, onChange, onSubmit."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|caps|align|title|description|eyebrow|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: level, caps, align, title, description, eyebrow."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|href|key|ref|className|style|children)$/]",
        "message": "<SocialLink> doesn't accept that prop. Declared props: name, label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkuCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|priceLine|footnoteMarker|badge|image|imageAlt|libraryLine|features|ctaLabel|ctaHref|terms|featured|key|ref|className|style|children)$/]",
        "message": "<SkuCard> doesn't accept that prop. Declared props: name, priceLine, footnoteMarker, badge, image, imageAlt, libraryLine, features, ctaLabel, ctaHref, terms, featured."
      },
      {
        "selector": "JSXOpeningElement[name.name='SortSelect'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|options|onChange|key|ref|className|style|children)$/]",
        "message": "<SortSelect> doesn't accept that prop. Declared props: label, value, options, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|variant|showChevron|children|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: href, variant, showChevron, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:cta|inline)$/]",
        "message": "<TextLink> variant must be one of 'cta' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tile'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|image|imageAlt|title|href|eyebrow|cta|key|ref|className|style|children)$/]",
        "message": "<Tile> doesn't accept that prop. Declared props: size, image, imageAlt, title, href, eyebrow, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tile'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:large|medium|small)$/]",
        "message": "<Tile> size must be one of 'large' | 'medium' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|defaultOpen|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: label, children, defaultOpen."
      }
    ]
  },
