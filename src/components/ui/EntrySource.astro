---
/**
 * The evidence line under a code or daily link.
 *
 * First-party publisher evidence can be linked. Community and aggregator evidence
 * remains in the operational data for audit and verification, but is not emitted as
 * a public outbound link from a code or reward row.
 *
 */
import { citationFor, type EvidenceTier } from '../../data/operations';

interface Props {
  entry: { publisherSourceUrl?: string | null; publisherTier?: EvidenceTier; sourceUrls?: string[] };
}

const { entry } = Astro.props;
const citation = citationFor(entry);
---

{citation
  ? citation.evidenceLabel === 'publisher-confirmed'
    ? <a
        href={citation.url}
        rel="noopener"
        data-evidence-tier={citation.evidenceLabel}
        data-evidence-rung={citation.tier}
      >{citation.label}</a>
    : <span class="tier-chip" data-evidence-tier={citation.evidenceLabel} data-evidence-rung={citation.tier}>Community-reported</span>
  : <span class="tier-chip">No source recorded</span>}
