---
/**
 * The evidence line under a code or daily link.
 *
 * Two states, never a bare negative. A publisher post links to the channel the
 * publisher controls. Anything else names the outlet that reported it, because the
 * entry is uncorroborated rather than unsourced and the page should say which of
 * those two things is true. Only an entry with no usable URL at all falls through
 * to "No source recorded".
 *
 * Reported links carry `nofollow`: these are aggregators the site is citing, not
 * endorsing, and several of them republish each other.
 */
import { citationFor } from '../../data/operations';

interface Props {
  entry: { publisherSourceUrl?: string | null; sourceUrls?: string[] };
}

const { entry } = Astro.props;
const citation = citationFor(entry);
---

{citation
  ? <a
      href={citation.url}
      rel={citation.tier === 'publisher-confirmed' ? 'noopener' : 'nofollow noopener'}
      data-evidence-tier={citation.tier}
    >{citation.label}</a>
  : <span class="tier-chip">No source recorded</span>}
