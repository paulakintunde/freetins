---
/**
 * The body served with a `410 Gone` for the deliberately removed legacy URLs listed
 * in `src/data/gone.ts`.
 *
 * The status is what search engines act on; this markup is for the person who
 * followed an old link. It says plainly that the page was removed and why, then
 * offers the surfaces the site actually covers — rather than pretending a redirect
 * to a game hub answered their question.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  /**
   * `topic` is the default: a page whose subject is outside what Freetins covers,
   * listed in `src/data/gone.ts`. `archive` is a WordPress listing surface matched
   * by one of the prefixes in the same file. The distinction is worth drawing
   * because the honest explanation differs: a removed topic has no successor, an
   * archive's contents mostly moved and the reader can go and find them.
   */
  variant?: 'topic' | 'archive';
}

const { variant = 'topic' } = Astro.props;
const isArchive = variant === 'archive';

Astro.response.status = 410;
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
// A removal is permanent, so it is safe to cache at the edge. Kept short enough that
// restoring a path stays a deploy rather than a cache-purge exercise.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600');
---

<BaseLayout
  title={isArchive ? 'Archive removed | Freetins' : 'Page removed | Freetins'}
  description={isArchive
    ? 'This archive listing no longer exists. Freetins covers game codes, cheats, answers and guides.'
    : 'This page has been permanently removed. Freetins now covers game codes, cheats, answers and guides only.'}
  noindex
>
  <article class="route-page" data-route-kind="gone">
    <header class="page-head content-boundary">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Freetins</a>
        <span aria-current="page">{isArchive ? 'Archive removed' : 'Page removed'}</span>
      </nav>
      <p class="eyebrow">Permanently removed</p>
      <h1>{isArchive ? 'This archive page no longer exists' : 'This page has been removed'}</h1>
      <p class="lede">
        {isArchive
          ? 'It was a category, tag or feed listing generated by the old site software. Those listings were not rebuilt, but the pages they indexed are still here and reachable from the hubs below.'
          : 'It covered a topic outside what Freetins publishes. The site is now game codes, cheats, answers and guides only, so the page was retired rather than rewritten or redirected somewhere unrelated.'}
      </p>
    </header>

    <section class="page-section content-boundary">
      <div class="notice">
        <span>Why there is no redirect</span>
        <h2>{isArchive ? 'No single page replaced it' : 'Nothing here replaced it'}</h2>
        <p>
          {isArchive
            ? 'An archive listed many pages at once, so there is no one page to send you to. Search finds the individual page you were after faster than any hub could.'
            : 'Sending you to a game page you did not ask for would waste your time. If you are looking for something Freetins does cover, start from the search box or a hub below.'}
        </p>
      </div>
    </section>

    <nav class="next-links content-boundary" aria-label="Related pages">
      <a href="/search/">Search Freetins</a>
      <a href="/codes/">Game codes</a>
      <a href="/cheats/">Cheats</a>
      <a href="/answers/">Answers</a>
      <a href="/guides/">Guides</a>
    </nav>
  </article>
</BaseLayout>
