---
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import { dailyLinkCatalogue, gameCatalogue } from '../../data/home';
import {
  dailyArtwork,
  gameArtwork,
  gearArtwork,
  requireArtwork,
} from '../../data/site-images';
import type { RouteDefinition } from '../../data/routes';
import type { CheckerSnapshot } from '../../lib/checker-status';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  definition: RouteDefinition;
  checkerSnapshot?: CheckerSnapshot;
}

const { definition, checkerSnapshot } = Astro.props;
const game = gameCatalogue.find((item) => item.slug === definition.slug);
const dailyGame = dailyLinkCatalogue.find((item) => item.slug === definition.slug);
const gameRoot = game ? `/codes/${game.slug}/` : '/codes/grow-a-garden/';
const isGamePage = ['codes', 'values', 'archive', 'updates'].includes(definition.kind) && Boolean(game);
const gameArt = game
  ? requireArtwork(gameArtwork, game.slug, 'game')
  : undefined;
const dailyArt = dailyGame
  ? requireArtwork(dailyArtwork, dailyGame.slug, 'daily reward')
  : undefined;
const productArt = definition.kind === 'gearProduct' && definition.slug
  ? requireArtwork(gearArtwork, definition.slug, 'gear product')
  : undefined;
const categoryGearSlug = definition.kind === 'gearCategory'
  ? {
      roblox: 'roblox-gift-card-25-cad',
      mobile: 'controller-for-mobile-play',
      'pc-and-console': 'wired-gaming-headset-mid-range',
    }[definition.slug ?? '']
  : undefined;
const collectionArt = definition.kind === 'daily'
  ? requireArtwork(dailyArtwork, 'monopoly-go', 'daily reward')
  : definition.kind === 'gearCategory'
    ? categoryGearSlug
      ? requireArtwork(gearArtwork, categoryGearSlug, 'gear product')
      : undefined
    : undefined;
const guideArt = definition.kind === 'guide'
  ? requireArtwork(gameArtwork, 'grow-a-garden', 'game')
  : undefined;
const routeArtwork = gameArt ?? dailyArt ?? productArt ?? collectionArt ?? guideArt;
const showHeaderArtwork = ['browse', 'codes', 'values', 'archive', 'dailyGame', 'guide'].includes(definition.kind)
  && Boolean(routeArtwork);

const stats = (() => {
  switch (definition.kind) {
    case 'daily': return [['Games tracked', '6'], ['Links live now', '45'], ['Median link age', '38 min'], ['Checked every', '1 to 3 h']];
    case 'browse': return [['Games tracked', String(gameCatalogue.length)], ['With live codes', '52'], ['Checked this hour', '41'], ['Platform', 'Game platform']];
    case 'codes': return [['Last checked', `${game?.age ?? '4 min'} ago`], ['Next check', 'in 56 min'], ['Live now', `${game?.live ?? 6} codes`], ['Verification', '2 sources']];
    case 'az': return [['Games listed', String(gameCatalogue.length + dailyLinkCatalogue.length)], ['With live codes', '52'], ['Checked this hour', '41'], ['Cheats confirmed', '362']];
    case 'values': return [['Items tracked', '84'], ['Trades, 7 d', '1,240'], ['Updated', '2 h ago'], ['Refresh', 'Daily']];
    case 'archive': return [['Codes archived', '4,318'], ['Median life', '6 d'], ['Longest lived', '214 d'], ['Oldest entry', 'Jul 2023']];
    case 'search': return [['Pages indexed', '434'], ['Games', String(gameCatalogue.length)], ['Daily links', String(dailyLinkCatalogue.length)], ['Guides', '6']];
    default: return [];
  }
})();

const liveCodes = [
  ['GARDEN500', '500 sheckles', 'Developer X post', '4 min ago'],
  ['RARESEED', 'Rare seed pack', 'Official Discord', '12 min ago'],
  ['GROWFAST', '2x growth, 30 min', 'Developer X post', '26 min ago'],
  ['SHECKLES1000', '1,000 sheckles', 'Official Discord', '48 min ago'],
  ['WATERINGCAN', 'Watering can skin', 'Update announcement', '1 h ago'],
  ['COMMUNITY250', '250 sheckles', 'Community submission', '2 h ago'],
] as const;

const expiredCodes = [
  ['SPRINGSEED', 'Summer event seed', 'Expired 1 d ago'],
  ['SHECKLES750', '750 sheckles', 'Expired 2 d ago'],
  ['GOLDSPRINKLER', 'Golden sprinkler', 'Expired 3 d ago'],
] as const;

const cheatGames = [
  ['GTA 5', 'gta-5', '28', 'PS5, Xbox Series, PC'],
  ['GTA San Andreas', 'gta-san-andreas', '91', 'PS, Xbox, PC'],
  ['GTA Vice City', 'gta-vice-city', '62', 'PS, Xbox, PC'],
  ['Red Dead Redemption 2', 'red-dead-redemption-2', '37', 'PS, Xbox, PC'],
  ['The Sims 4', 'the-sims-4', '40', 'PC, Mac, console'],
  ['Skyrim', 'skyrim', '45', 'PC only'],
  ['Fallout 4', 'fallout-4', '33', 'PC only'],
  ['Minecraft', 'minecraft', '26', 'All platforms'],
] as const;

const cheatRows = [
  ['Invincibility, 5 minutes', 'PAINKILLER'],
  ['Max health and armour', 'TURTLE'],
  ['Fast run', 'CATCHME'],
  ['Super jump', 'HOPTOIT'],
  ['Give weapons and ammo', 'TOOLUP'],
  ['Raise wanted level', 'FUGITIVE'],
  ['Change weather', 'MAKEITRAIN'],
  ['Slow motion', 'SLOWMO'],
] as const;

const authors = [
  { slug: 'paul-a', name: 'Paul A', role: 'Editor', owns: 'Owns the check schedule for every page that goes live.', metric: '1,412 codes verified' },
] as const;

const gear = [
  ['Roblox gift card, 25 CAD', '$25.00', '/gear/roblox/roblox-gift-card-25-cad'],
  ['Wired gaming headset, mid range', '$59.99', '/gear/pc-and-console/wired-gaming-headset-mid-range'],
  ['Controller for mobile play', '$44.50', '/gear/mobile/controller-for-mobile-play'],
  ['Phone cooling clip', '$21.99', '/gear/mobile/phone-cooling-clip'],
  ['Mechanical keypad, 24 key', '$38.00', '/gear/pc-and-console/mechanical-keypad-24-key'],
  ['Charging dock, two bay', '$32.99', '/gear/pc-and-console/charging-dock-two-bay'],
] as const;

const values = [
  ['Golden sprinkler', 'Divine', '2.4m', '+8%', '1,240 trades'],
  ['Dragonfly pet', 'Divine', '1.9m', '-3%', 'Official trade log'],
  ['Candy blossom seed', 'Mythic', '740k', '+14%', '860 trades'],
  ['Beanstalk seed', 'Mythic', '512k', 'Flat', '720 trades'],
  ['Master sprinkler', 'Legendary', '180k', '-6%', 'Patch market sample'],
  ['Bee pet', 'Legendary', '96k', '+2%', '544 trades'],
] as const;

const updates = [
  ['18 Aug 2026', 'v3.4', 'Harvest event, three new seeds', 'Event runs two weeks. Three limited seeds enter the pool and the shop rotates daily.'],
  ['11 Aug 2026', 'v3.3', 'Sprinkler rebalance and shop rotation', 'Master sprinkler radius changed; the values table was updated the same evening.'],
  ['02 Aug 2026', 'v3.2', 'New pet tier and trade window changes', 'Divine tier was added above Mythic and the trade confirmation changed.'],
  ['24 Jul 2026', 'v3.1', 'Mutation rework', 'Mutation triggers changed and the guide was rewritten with the patch.'],
] as const;

const legalCopy: Record<string, Array<[string, string]>> = {
  privacy: [
    ['What we collect', 'We collect the information you submit, aggregate page counts and the minimum delivery data needed to keep the site secure.'],
    ['How it is used', 'Submitted codes enter verification. Contact details are used only to answer the request or deliver an alert.'],
    ['Who we share data with', 'Cloudflare delivers the site, Plausible provides aggregate analytics, and Discord can deliver alerts you request.'],
    ['Your choices', 'Cookie choices can be reopened from the footer. You can ask us to delete information you submitted.'],
  ],
  affiliate: [
    ['Which links pay us', 'Some Gear links pay Freetins a commission when a purchase is completed. Those links are marked before you click.'],
    ['What money never buys', 'Payment never changes a code result, verification result, tier position or editorial recommendation.'],
    ['How a paid thing is labelled', 'Sponsored and affiliate placements carry a visible label in the module that contains them.'],
    ['How products get picked', 'A product must solve the specific problem named on the page before its commercial terms are considered.'],
  ],
  terms: [
    ['Using the site', 'You may read, link to and share individual Freetins pages. Automated extraction and republication require permission.'],
    ['Codes and links', 'A game developer controls whether a code or link works. We publish the result of our most recent check.'],
    ['Corrections', 'Report an error through Contact. Corrections skip the general queue and are actioned the same day.'],
    ['Governing law', 'These terms are governed by the law of Ontario, Canada, without removing rights you hold where you live.'],
  ],
};

const infoCopy: Record<string, Array<[string, string]>> = {
  answers: [
    ['What this page is', 'A compact answer hub for levels, puzzles and short-form questions that need a direct destination.'],
    ['How entries are ordered', 'The most recent verified answer sits first, and older calls remain visible for comparison.'],
    ['How we source them', 'We only publish an answer after we can cross-check the result against the current game state.'],
  ],
  guideIndex: [
    ['What lives here', 'Long-form explainers, patch notes and process pages that are not one game’s code table.'],
    ['What stays out', 'We do not mix in retired pages, monitoring pages or legacy archive shells.'],
    ['How to use it', 'Jump from the guide index to the specific walkthrough or reference you need.'],
  ],
  resources: [
    ['For editors', 'Launch notes, routing references and the internal map of the new information architecture.'],
    ['For readers', 'A direct path into codes, daily links, cheats, guides and verification.'],
    ['What changed', 'The new structure favors the shortest route to a useful page instead of a redirect chain.'],
  ],
  about: [
    ['Why the site exists', 'Freetins is built to help players find working codes and daily links quickly.'],
    ['What changed in the relaunch', 'We narrowed the surface area so the pages that remain are the ones that earn their place.'],
    ['What we will not do', 'We will not keep dead-end routes or legacy shells just to preserve old navigation.'],
  ],
};

const pageLinks: Record<string, Array<[string, string]>> = {
  verify: [['Submit a code', '/submit/'], ['Report a correction', '/contact/?topic=Correction'], ['Blog', '/blog/']],
  alerts: [['Manage alerts', '/alerts/'], ['Privacy', '/privacy/']],
  contact: [['How we verify', '/how-we-verify/'], ['Disclosure', '/disclosure/'], ['Blog', '/blog/']],
  search: [['Browse all codes', '/codes/'], ['All games A-Z', '/games/'], ['How we verify', '/how-we-verify/']],
  updates: [['How we verify', '/how-we-verify/'], ['Resources', '/resources/']],
  notTracked: [['Request this game', '/submit/'], ['Browse every game', '/games/'], ['Search Freetins', '/search/']],
  guide: [['Guides', '/guides/'], ['Resources', '/resources/'], ['How we verify', '/how-we-verify/']],
};

const relatedLinks = pageLinks[definition.kind] ?? [];
const legalSections = legalCopy[definition.kind] ?? [];
const infoSections = infoCopy[definition.routeId] ?? [];

const crumbs = isGamePage
  ? [['Home', '/'], ['Codes', '/codes/'], [game?.name ?? 'Game', gameRoot]]
  : [['Home', '/']];
---

<BaseLayout
  title={definition.title}
  description={definition.description}
  noindex={definition.noindex ?? false}
  checkerStatus={checkerSnapshot?.state ?? 'Live'}
  image={routeArtwork?.socialImage}
  imageAlt={routeArtwork?.alt}
>
  <article class="route-page" data-route-kind={definition.kind}>
    <header class="page-head content-boundary">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {crumbs.map(([label, href]) => <a href={href}>{label}</a>)}
        <span aria-current="page">{definition.heading}</span>
      </nav>
      {definition.eyebrow && <p class="eyebrow">{definition.eyebrow}</p>}
      <h1>{definition.heading}</h1>
      <p class="lede">{definition.description}</p>
      {isGamePage && (
        <nav class="game-tabs" aria-label={`${game?.name} sections`}>
          <a href={gameRoot} aria-current={definition.kind === 'codes' ? 'page' : undefined}>Codes</a>
          <a href={`${gameRoot}values/`} aria-current={definition.kind === 'values' ? 'page' : undefined}>Values</a>
          <a href={`${gameRoot}expired/`} aria-current={definition.kind === 'archive' ? 'page' : undefined}>Archive</a>
          <a href={`${gameRoot}updates/`} aria-current={definition.kind === 'updates' ? 'page' : undefined}>Updates</a>
        </nav>
      )}
      {stats.length > 0 && (
        <div class="stats">
          {stats.map(([label, value]) => <div><span>{label}</span><strong>{value}</strong></div>)}
        </div>
      )}
      {showHeaderArtwork && routeArtwork && (
        <div class="entity-art">
          <Picture
            src={routeArtwork.src}
            alt={routeArtwork.alt}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[480, 768, 1080, 1440, 1536]}
            sizes="(max-width: 767px) calc(100vw - (2 * var(--page-gutter))), min(100vw - (2 * var(--page-gutter)), 1672px)"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}
    </header>

    {(definition.kind === 'browse' || definition.kind === 'az') && (
      <section class="page-section content-boundary">
        <div class="section-title">
          <h2>{definition.kind === 'az' ? 'Every game we track' : 'Freshest first'}</h2>
          <span>{gameCatalogue.length} games</span>
        </div>
        <div class:list={['catalogue', { columns: definition.kind === 'az' }]}>
          {gameCatalogue.map((item) => (
            <a href={`/codes/${item.slug}/`}>
              <span>{item.name}</span>
              <strong>{item.live} live</strong>
              <time>{item.age} ago</time>
            </a>
          ))}
        </div>
      </section>
    )}

    {definition.kind === 'daily' && (
      <section class="page-section content-boundary">
        <h2>Games we track</h2>
        <div class="card-grid">
          {dailyLinkCatalogue.map((item) => {
            const art = requireArtwork(dailyArtwork, item.slug, 'daily reward');
            return (
              <a class="media-card" href={`/daily/${item.slug}/`}>
                <div class="media">
                  <Picture
                    src={art.src}
                    alt={art.alt}
                    formats={['avif']}
                    fallbackFormat="webp"
                    widths={[320, 528, 792, 1056]}
                    sizes="(max-width: 767px) calc(100vw - (2 * var(--page-gutter))), (max-width: 1199px) 50vw, 33vw"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="card-copy"><h3>{item.name}</h3><p>{item.live} links live · checked {item.age} ago</p></div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {definition.kind === 'dailyGame' && (
      <section class="page-section content-boundary split-layout">
        <div>
          <h2>Working links</h2>
          <div class="link-list">
            {Array.from({ length: Math.min(dailyGame?.live ?? 8, 8) }, (_, index) => (
              <a href={`https://example.com/${dailyGame?.slug}/${index + 1}`} rel="nofollow">
                <span>{index % 2 === 0 ? 'Free dice and rolls' : 'Daily reward bundle'}</span>
                <strong>Opened {index * 7 + 6} min ago</strong>
              </a>
            ))}
          </div>
        </div>
        <aside><h2>How these links work</h2><p>We open each reward link on the interval shown above. A link moves to the expired list as soon as it fails twice.</p><a href="/daily/">All daily link games</a></aside>
      </section>
    )}

    {definition.kind === 'codes' && (
      <section class="page-section content-boundary split-layout wide-main">
        <div>
          <div class="section-title"><h2>Working codes</h2><span>{game?.live ?? 6} live</span></div>
          <p class="visually-hidden" aria-live="polite" data-copy-live></p>
          <div class="code-table" aria-label={`Working ${game?.name} codes`}>
            {liveCodes.slice(0, Math.max(1, Math.min(game?.live ?? 6, liveCodes.length))).map(([code, reward, source, checked]) => (
              <div class="code-row">
                <div><code>{code}</code><span>{reward}</span></div>
                <div><small>{source} · {checked}</small><button type="button" data-copy-code={code}>Copy</button></div>
              </div>
            ))}
          </div>
          <h2 class="subhead">Expired codes</h2>
          <div class="expired-list">
            {expiredCodes.map(([code, reward, checked]) => <div><s>{code}</s><span>{reward}</span><time>{checked}</time></div>)}
          </div>
        </div>
        <aside><h2>Verification</h2><p>Every code is opened against two sources before it appears as live. Expired codes stay visible.</p><a href="/how-we-verify/">How we verify</a><a href={`${gameRoot}expired/`}>Full archive</a></aside>
      </section>
    )}

    {definition.kind === 'cheats' && (
      <section class="page-section content-boundary"><h2>Games with cheats</h2><div class="catalogue">{cheatGames.map(([name, slug, count, systems]) => <a href={`/cheats/${slug}`}><span>{name}<small>{systems}</small></span><strong>{count} cheats</strong></a>)}</div></section>
    )}

    {definition.kind === 'cheat' && (
      <section class="page-section content-boundary split-layout wide-main">
        <div><h2>Player and world cheats</h2><div class="code-table">{cheatRows.map(([name, code]) => <div class="code-row"><div><strong>{name}</strong><code>{code}</code></div><button type="button" data-copy-code={code}>Copy</button></div>)}</div></div>
        <aside><h2>Confirmed build</h2><p>Each sequence was entered on retail hardware and PC against the current patch.</p><a href="/cheats">All cheat games</a></aside>
      </section>
    )}

    {definition.kind === 'author' && (
      <section class="page-section content-boundary">
        <div class="profile-detail"><div><h2>Experience</h2><p>{authors.find((person) => person.slug === definition.slug)?.owns}</p><p>Every page carries a named author and a published verification schedule. Recent work remains linked to the source and check log.</p><a href="/about/">About Freetins</a></div></div>
      </section>
    )}

    {definition.kind === 'gearCategory' && (
      <section class="page-section content-boundary">
        <h2>Picked this month</h2>
        <div class="card-grid">{gear.map(([name, price, href]) => {
          const slug = href.split('/').at(-1) ?? '';
          const art = requireArtwork(gearArtwork, slug, 'gear product');
          return <a class="media-card" href={href}><div class="media"><Picture src={art.src} alt={art.alt} formats={['avif']} fallbackFormat="webp" widths={[320, 528, 792, 1056]} sizes="(max-width: 767px) calc(100vw - (2 * var(--page-gutter))), (max-width: 1199px) 50vw, 33vw" loading="lazy" decoding="async" /></div><div class="card-copy"><h3>{name}</h3><p>{price}</p></div></a>;
        })}</div>
      </section>
    )}

    {definition.kind === 'gearProduct' && (
      <section class="page-section content-boundary product-layout">{productArt && <div class="product-media"><Picture src={productArt.src} alt={productArt.alt} formats={['avif']} fallbackFormat="webp" widths={[480, 768, 1080, 1536]} sizes="(max-width: 767px) calc(100vw - (2 * var(--page-gutter))), 55vw" loading="eager" fetchpriority="high" decoding="async" /></div>}<div><p class="eyebrow">Freetins pick</p><h2>Why we picked it</h2><p>It solves a specific gaming problem without adding an account, subscription or unnecessary setup step.</p><dl><div><dt>Delivery</dt><dd>In stock</dd></div><div><dt>Checked</dt><dd>21 August 2026</dd></div><div><dt>Disclosure</dt><dd>Affiliate link</dd></div></dl><Button href="/disclosure/" variant="secondary">Read the disclosure</Button></div></section>
    )}

    {definition.kind === 'values' && (
      <section class="page-section content-boundary"><div class="section-title"><h2>{game?.name}, current trade values</h2><span>Source on every row</span></div><div class="data-table">{values.map(([name, tier, value, trend, source]) => <div><strong>{name}</strong><span>{tier}</span><b>{value}</b><em>{trend}</em><small>{source}</small></div>)}</div></section>
    )}

    {(definition.kind === 'privacy' || definition.kind === 'affiliate' || definition.kind === 'terms') && (
      <section class="page-section content-boundary prose"><p class="updated">Last updated 21 August 2026</p>{legalSections.map(([heading, copy], index) => <section><span>{String(index + 1).padStart(2, '0')}</span><div><h2>{heading}</h2><p>{copy}</p></div></section>)}</section>
    )}

    {definition.kind === 'info' && infoSections.length > 0 && (
      <section class="page-section content-boundary prose"><p class="updated">Last updated 21 August 2026</p>{infoSections.map(([heading, copy], index) => <section><span>{String(index + 1).padStart(2, '0')}</span><div><h2>{heading}</h2><p>{copy}</p></div></section>)}</section>
    )}

    {definition.kind === 'verify' && (
      <section class="page-section content-boundary"><h2>How often we check</h2><div class="process-grid">{[['01', 'Find the source', 'A developer channel or game surface starts the check.'], ['02', 'Open it twice', 'Two sources must agree before a code is marked live.'], ['03', 'Publish the time', 'The page shows the minute of the latest successful check.'], ['04', 'Keep the record', 'Failed codes move to the archive instead of disappearing.']].map(([num, title, copy]) => <div><strong>{num}</strong><h3>{title}</h3><p>{copy}</p></div>)}</div></section>
    )}

    {definition.kind === 'updates' && (
      <section class="page-section content-boundary timeline">{updates.map(([date, version, title, copy]) => <article><time>{date}</time><span>{version}</span><div><h2>{title}</h2><p>{copy}</p></div></article>)}</section>
    )}

    {definition.kind === 'archive' && (
      <section class="page-section content-boundary"><div class="section-title"><h2>{game ? `${game.name}, every pulled code` : 'Every game, archived counts'}</h2><span>Never deleted</span></div><div class="data-table archive-table">{expiredCodes.concat(expiredCodes).map(([code, reward, checked], index) => <div><s>{code}{index > 2 ? `-${index + 1}` : ''}</s><span>{reward}</span><b>{checked}</b><small>Source retained</small></div>)}</div></section>
    )}

    {definition.kind === 'guide' && (
      <section class="page-section content-boundary guide-layout"><aside><strong>On this page</strong><a href="#what-it-is">What it is</a><a href="#full-list">The full list</a><a href="#unconfirmed">What we could not confirm</a></aside><div class="prose-body"><h2 id="what-it-is">What a mutation actually is</h2><p>A mutation changes the sale multiplier of a crop. Weather, pets and limited events can each trigger one, and compatible effects stack.</p><h2 id="full-list">The full list</h2>{values.slice(0, 5).map(([name, tier, value]) => <div class="guide-row"><strong>{name}</strong><span>{tier}</span><b>{value}</b></div>)}<h2 id="unconfirmed">What we could not confirm</h2><p>Community reports without a repeatable trigger remain outside the table until a second source reproduces them.</p></div></section>
    )}

    {(definition.kind === 'search' || definition.kind === 'submit' || definition.kind === 'alerts' || definition.kind === 'contact') && (
      <section class="page-section content-boundary form-layout">
        <form method="get" action={definition.kind === 'search' ? '/search/' : undefined}>
          <label>{definition.kind === 'search' ? 'Game, guide or code' : definition.kind === 'alerts' ? 'Email or Discord handle' : 'Your email'}<input type={definition.kind === 'search' ? 'search' : 'text'} name={definition.kind === 'search' ? 'q' : 'contact'} placeholder={definition.kind === 'search' ? 'Grow a Garden' : 'you@example.com'} /></label>
          {definition.kind !== 'search' && <label>Details<textarea name="message" rows={5} placeholder="Tell us what you need"></textarea></label>}
          <button type="submit">{definition.kind === 'search' ? 'Search' : 'Continue'}</button>
        </form>
        <aside><h2>What happens next</h2><p>{definition.kind === 'search' ? 'Results include games, guides and daily-link pages.' : 'A person or the verification checker handles the request. Nothing publishes automatically.'}</p></aside>
      </section>
    )}

    {definition.kind === 'notTracked' && (
      <section class="page-section content-boundary"><div class="notice"><span>{definition.eyebrow ?? 'Freetins'}</span><h2>Request the game and it enters validation</h2><p>{definition.description}</p></div></section>
    )}

    {relatedLinks.length > 0 && <nav class="next-links content-boundary" aria-label="Related pages">{relatedLinks.map(([label, href]) => <a href={href}>{label}</a>)}</nav>}
  </article>

</BaseLayout>

<style>
  .route-page { padding-bottom: clamp(54px, 7vw, 92px); }
  .page-head { padding: clamp(28px, 4vw, 52px) var(--page-gutter) 0; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; color: var(--text-tertiary); font: 400 13px / 1.4 var(--font-core); }
  .breadcrumbs a { color: var(--text-tertiary); }
  .breadcrumbs a::after { margin-left: 6px; content: '/'; color: var(--text-disabled); }
  .eyebrow { margin: 0 0 12px; color: var(--text-brand); font: 700 12px / 1.4 var(--font-core); letter-spacing: .12em; text-transform: uppercase; }
