---
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import EditorialArticle from './EditorialArticle.astro';
import { requireArticleArtwork } from '../../data/article-images';
import { editorialArticles, getArticleByPath } from '../../data/articles';
import {
  dailyLinkCatalogue,
  gameCatalogue,
  plannedGameCatalogue,
  publishedDailyLinkCatalogue,
  publishedGameCatalogue,
} from '../../data/home';
import {
  dailyArtwork,
  gameArtwork,
  gearArtwork,
  requireArtwork,
} from '../../data/site-images';
import type { RouteDefinition } from '../../data/routes';
import {
  formatAbsoluteTimestamp,
  getCheatOperationalPage,
  getGameOperationalPage,
  getProduct,
  operationalSummary,
  operations,
  type CodeEntry,
  type DailyLinkEntry,
  type EntryState,
  type ResolvedEntry,
} from '../../data/operations';
import type { CheckerSnapshot } from '../../lib/checker-status';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  definition: RouteDefinition;
  checkerSnapshot?: CheckerSnapshot;
}

const { definition, checkerSnapshot } = Astro.props;
const article = getArticleByPath(definition.path);
const hubArticles = definition.routeId === 'answers'
  ? editorialArticles.filter((item) => item.section === 'answers')
  : definition.routeId === 'guideIndex'
    ? editorialArticles.filter((item) => item.section === 'guides')
    : definition.routeId === 'cheats'
      ? editorialArticles.filter((item) => item.section === 'cheats')
      : definition.routeId === 'daily'
        ? editorialArticles.filter((item) => item.section === 'daily')
    : [];
const publishedHeading = {
  answers: 'Published Answers',
  guideIndex: 'Published Guides',
  cheats: 'Published Cheats',
  daily: 'Published Daily Guides',
}[definition.routeId];
const game = gameCatalogue.find((item) => item.slug === definition.slug);
const dailyGame = dailyLinkCatalogue.find((item) => item.slug === definition.slug);
const operationalPage = definition.slug ? getGameOperationalPage(definition.slug) : null;
const cheatPage = definition.slug ? getCheatOperationalPage(definition.slug) : null;
const product = definition.slug ? getProduct(definition.slug) : undefined;
const operationalStats = operationalSummary();
const codeEntries = (operationalPage?.entries ?? []).filter(
  (item): item is ResolvedEntry<CodeEntry> => 'code' in item.entry,
);
const activeCodeEntries = codeEntries.filter((item) => item.state !== 'expired');
const expiredCodeEntries = codeEntries.filter((item) => item.state === 'expired');
const dailyEntries = (operationalPage?.entries ?? []).filter(
  (item): item is ResolvedEntry<DailyLinkEntry> => 'url' in item.entry,
);
const timelineEntries = definition.slug ? operationalPage?.updates ?? [] : operations.updates;
const entryStateLabels: Record<EntryState, string> = {
  verified: 'Verified active',
  reported: 'Officially reported',
  stale: 'Needs recheck',
  expired: 'Expired',
  unverified: 'Not verified',
};
const gameRoot = game ? `/codes/${game.slug}/` : '/codes/grow-a-garden/';
const isGamePage = ['codes', 'values', 'archive', 'updates'].includes(definition.kind) && Boolean(game);
const gameArt = game
  ? requireArtwork(gameArtwork, game.slug, 'game')
  : undefined;
const dailyArt = dailyGame
  ? requireArtwork(dailyArtwork, dailyGame.slug, 'daily reward')
  : undefined;
const productArt = definition.kind === 'gearProduct' && definition.slug
  ? requireArtwork(gearArtwork, definition.slug, 'gear product')
  : undefined;
const categoryGearSlug = definition.kind === 'gearCategory'
  ? {
      roblox: 'roblox-gift-card-25-cad',
      mobile: 'controller-for-mobile-play',
      'pc-and-console': 'wired-gaming-headset-mid-range',
    }[definition.slug ?? '']
  : undefined;
const collectionArt = definition.kind === 'daily'
  ? requireArtwork(dailyArtwork, 'monopoly-go', 'daily reward')
  : definition.kind === 'gearCategory'
    ? categoryGearSlug
      ? requireArtwork(gearArtwork, categoryGearSlug, 'gear product')
      : undefined
    : undefined;
const guideArt = definition.kind === 'guide'
  ? requireArtwork(gameArtwork, 'grow-a-garden', 'game')
  : undefined;
const routeArtwork = gameArt ?? dailyArt ?? productArt ?? collectionArt ?? guideArt;
const showHeaderArtwork = ['browse', 'codes', 'values', 'archive', 'dailyGame', 'guide'].includes(definition.kind)
  && Boolean(routeArtwork);

const stats = (() => {
  switch (definition.kind) {
    case 'daily': return [['Configured', String(dailyLinkCatalogue.length)], ['Published', String(publishedDailyLinkCatalogue.length)], ['Active links', String(publishedDailyLinkCatalogue.reduce((total, item) => total + item.activeCount, 0))], ['Checks today', String(operationalStats.checksToday)]];
    case 'browse': return [['Configured', String(gameCatalogue.length)], ['Published', String(publishedGameCatalogue.length)], ['Active records', String(publishedGameCatalogue.reduce((total, item) => total + item.activeCount, 0))], ['Checks today', String(operationalStats.checksToday)]];
    case 'codes': return [['Publication', operationalPage?.isPublished ? 'Published' : 'Pending'], ['Last check', operationalPage?.latestCheckedAt ? formatAbsoluteTimestamp(operationalPage.latestCheckedAt) : 'Not recorded'], ['Active records', String(operationalPage ? operationalPage.verifiedCount + operationalPage.reportedCount : 0)], ['Needs recheck', String(operationalPage?.staleCount ?? 0)]];
    case 'az': return [['Published games', String(publishedGameCatalogue.length + publishedDailyLinkCatalogue.length)], ['Code pages', String(publishedGameCatalogue.length)], ['Daily-link pages', String(publishedDailyLinkCatalogue.length)], ['Cheat sheets', String(operations.cheatGames.filter((item) => item.publicationState === 'published').length)]];
    case 'values': return [['Items published', String(operationalPage?.values.length ?? 0)], ['Source required', 'Every row'], ['Updated', operationalPage?.values[0] ? formatAbsoluteTimestamp(operationalPage.values[0].observedAt) : 'Not recorded'], ['State', operationalPage?.values.length ? 'Published' : 'Pending']];
    case 'archive': return [['Codes archived', String(operationalPage?.expiredCount ?? 0)], ['Source retained', operationalPage?.expiredCount ? 'Yes' : 'No records'], ['Last check', operationalPage?.latestCheckedAt ? formatAbsoluteTimestamp(operationalPage.latestCheckedAt) : 'Not recorded'], ['State', operationalPage?.expiredCount ? 'Published' : 'Pending']];
    case 'search': return [['Published pages', String(editorialArticles.length + publishedGameCatalogue.length + publishedDailyLinkCatalogue.length)], ['Code games', String(publishedGameCatalogue.length)], ['Daily links', String(publishedDailyLinkCatalogue.length)], ['Editorial', String(editorialArticles.length)]];
    default: return [];
  }
})();

const legalCopy: Record<string, Array<[string, string]>> = {
  privacy: [
    ['What we collect', 'The published site does not currently collect alert subscriptions or code submissions. If you email us, we receive the information you choose to send. Cloudflare processes the technical request data needed to deliver and secure the site.'],
    ['How it is used', 'Information sent by email is used to answer the message, investigate a correction or review a source.'],
    ['Who we share data with', 'Cloudflare delivers and secures the site. No optional analytics, advertising or alert-delivery provider is configured in the current operational record.'],
    ['Your choices', 'Cookie choices can be reopened from the footer. You can ask us to delete information you submitted.'],
  ],
  affiliate: [
    ['Which links pay us', 'Some Gear links pay Freetins a commission when a purchase is completed. Those links are marked before you click.'],
    ['What money never buys', 'Payment never changes a code result, verification result, tier position or editorial recommendation.'],
    ['How a paid thing is labelled', 'Sponsored and affiliate placements carry a visible label in the module that contains them.'],
    ['How products get picked', 'A product must solve the specific problem named on the page before its commercial terms are considered.'],
  ],
  terms: [
    ['Using the site', 'You may read, link to and share individual Freetins pages. Automated extraction and republication require permission.'],
    ['Codes and links', 'A game developer controls whether a code or link works. When we publish a verification result, the record includes its source and absolute check time.'],
    ['Corrections', 'Report an error through Contact. We review the page, supplied source and current operational record before publishing a correction.'],
    ['Governing law', 'These terms are governed by the law of Ontario, Canada, without removing rights you hold where you live.'],
  ],
};

const pageLinks: Record<string, Array<[string, string]>> = {
  verify: [['Submit a code', '/submit/'], ['Report a correction', '/contact/?topic=Correction'], ['Blog', '/blog/']],
  alerts: [['Manage alerts', '/alerts/'], ['Privacy', '/privacy/']],
  contact: [['How we verify', '/how-we-verify/'], ['Disclosure', '/disclosure/'], ['Blog', '/blog/']],
  search: [['Browse all codes', '/codes/'], ['All games A-Z', '/games/'], ['How we verify', '/how-we-verify/']],
  updates: [['How we verify', '/how-we-verify/'], ['Resources', '/resources/']],
  notTracked: [['Request this game', '/submit/'], ['Browse every game', '/games/'], ['Search Freetins', '/search/']],
  guide: [['Guides', '/guides/'], ['Resources', '/resources/'], ['How we verify', '/how-we-verify/']],
};

const relatedLinks = pageLinks[definition.kind] ?? [];
const legalSections = legalCopy[definition.kind] ?? [];

const crumbs = isGamePage
  ? [['Home', '/'], ['Codes', '/codes/'], [game?.name ?? 'Game', gameRoot]]
  : [['Home', '/']];
---

{article ? (
  <EditorialArticle article={article} />
) : (
<BaseLayout
  title={definition.title}
  description={definition.description}
  noindex={definition.noindex ?? false}
  checkerStatus={operations.services.checker.enabled ? checkerSnapshot?.state ?? 'Degraded' : 'Unconfigured'}
  image={routeArtwork?.socialImage}
  imageAlt={routeArtwork?.alt}
>
  <article class="route-page" data-route-kind={definition.kind}>
    <header class="page-head content-boundary">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {crumbs.map(([label, href]) => <a href={href}>{label}</a>)}
        <span aria-current="page">{definition.heading}</span>
      </nav>
      {definition.eyebrow && <p class="eyebrow">{definition.eyebrow}</p>}
      <h1>{definition.heading}</h1>
      <p class="lede">{definition.description}</p>
      {isGamePage && (
        <nav class="game-tabs" aria-label={`${game?.name} sections`}>
          <a href={gameRoot} aria-current={definition.kind === 'codes' ? 'page' : undefined}>Codes</a>
          <a href={`${gameRoot}values/`} aria-current={definition.kind === 'values' ? 'page' : undefined}>Values</a>
          <a href={`${gameRoot}expired/`} aria-current={definition.kind === 'archive' ? 'page' : undefined}>Archive</a>
          <a href={`${gameRoot}updates/`} aria-current={definition.kind === 'updates' ? 'page' : undefined}>Updates</a>
        </nav>
      )}
      {stats.length > 0 && (
        <div class="stats">
          {stats.map(([label, value]) => <div><span>{label}</span><strong>{value}</strong></div>)}
        </div>
      )}
      {showHeaderArtwork && routeArtwork && (
        <div class="entity-art">
          <Picture
            src={routeArtwork.src}
            alt={routeArtwork.alt}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[480, 768, 1080, 1440, 1536]}
            sizes="(max-width: 767px) calc(100vw - (2 * var(--page-gutter))), min(100vw - (2 * var(--page-gutter)), 1672px)"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}
    </header>

    {definition.kind === 'browse' && (
      <section class="page-section content-boundary">
        <div class="section-title">
          <h2>Published Codes</h2>
          <span>{publishedGameCatalogue.length} games</span>
        </div>
        {publishedGameCatalogue.length > 0 ? <div class="card-grid code-card-grid">
          {publishedGameCatalogue.map((item) => (
            <a class="media-card" href={`/codes/${item.slug}/`}>
              <div class="media">
                <Picture
                  src={requireArtwork(gameArtwork, item.slug, 'game').src}
                  alt={requireArtwork(gameArtwork, item.slug, 'game').alt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[320, 528, 792, 1056]}
                  sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 50vw, 25vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="card-copy"><h3>{item.name}</h3><p>{item.activeCount} active records · {item.checkedLabel}</p></div>
            </a>
          ))}
        </div> : <div class="data-empty"><strong>No code page is published yet</strong><p>The route structure is configured, but a page appears here only after its source URLs, redemption steps and verification events pass validation.</p></div>}
        {plannedGameCatalogue.length > 0 && (
          <div class="verification-queue">
            <h2>Verification queue</h2>
            <p>{plannedGameCatalogue.length} configured game pages are waiting for evidence-backed records. These drafts are not presented as working-code pages or included in search indexing.</p>
          </div>
        )}
      </section>
    )}

    {definition.kind === 'az' && (
      <section class="page-section content-boundary">
        <div class="section-title"><h2>Published game pages</h2><span>{publishedGameCatalogue.length + publishedDailyLinkCatalogue.length} games</span></div>
        {publishedGameCatalogue.length + publishedDailyLinkCatalogue.length > 0 ? <div class="catalogue columns">
          {[...publishedGameCatalogue, ...publishedDailyLinkCatalogue].sort((left, right) => left.name.localeCompare(right.name)).map((item) => (
            <a href={item.platform === 'Mobile' ? `/daily/${item.slug}/` : `/codes/${item.slug}/`}><span>{item.name}</span><strong>{item.activeCount} active</strong><time>{item.checkedLabel}</time></a>
          ))}
        </div> : <div class="data-empty"><strong>No operational game page is published yet</strong><p>Configured drafts remain outside this index until they contain valid sources and verification records.</p></div>}
      </section>
    )}

    {definition.kind === 'daily' && (
      <section class="page-section content-boundary">
        <h2>Published daily-link games</h2>
        {publishedDailyLinkCatalogue.length > 0 ? <div class="card-grid">
          {publishedDailyLinkCatalogue.map((item) => {
            const art = requireArtwork(dailyArtwork, item.slug, 'daily reward');
            return (
              <a class="media-card" href={`/daily/${item.slug}/`}>
                <div class="media">
                  <Picture
                    src={art.src}
                    alt={art.alt}
                    formats={['avif']}
                    fallbackFormat="webp"
                    widths={[320, 528, 792, 1056]}
                    sizes="(max-width: 767px) calc(100vw - (2 * var(--page-gutter))), (max-width: 1199px) 50vw, 33vw"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="card-copy"><h3>{item.name}</h3><p>{item.activeCount} active links · {item.checkedLabel}</p></div>
              </a>
            );
          })}
        </div> : <div class="data-empty"><strong>No daily-link page is published yet</strong><p>The configured games remain in the upload model, but no link appears until it has a real destination, source URL and verification event.</p></div>}
        {hubArticles.length > 0 && (
          <div class="published-articles">
            <h2>{publishedHeading}</h2>
            <div class="card-grid article-card-grid">
            {hubArticles.map((item) => (
              <a class="media-card" href={item.path}>
                <div class="media">
                  <Picture
                    src={requireArticleArtwork(item.routeId).src}
                    alt={requireArticleArtwork(item.routeId).alt}
                    formats={['avif']}
                    fallbackFormat="webp"
                    widths={[320, 528, 792, 1056]}
                    sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 50vw, 33vw"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="card-copy"><h3>{item.heading}</h3><p>{item.description}</p></div>
              </a>
            ))}
            </div>
          </div>
        )}
      </section>
    )}

    {definition.kind === 'dailyGame' && (
      <section class="page-section content-boundary split-layout">
        <div>
          <h2>Published links</h2>
          {dailyEntries.filter((item) => item.state !== 'expired').length > 0 ? <div class="daily-records">
            {dailyEntries.filter((item) => item.state !== 'expired').map((item) => (
              <div class="daily-record">
                <a href={item.entry.url} rel="nofollow noopener">
                  <span>{item.entry.label}<small>{entryStateLabels[item.state]}</small></span>
                  {item.latestEvent ? <time datetime={item.latestEvent.checkedAt} data-relative-time={item.latestEvent.checkedAt}>{formatAbsoluteTimestamp(item.latestEvent.checkedAt)}</time> : <strong>Not checked</strong>}
                </a>
                <span class="record-sources">Evidence: {item.entry.sourceUrls.map((url, index) => <a href={url} rel="noopener">Source {index + 1}</a>)}</span>
              </div>
            ))}
          </div> : <div class="data-empty"><strong>No reward link is published</strong><p>This page is configured, but it will not display a claim link until the URL, source and verification event are present in the operational data.</p></div>}
        </div>
        <aside><h2>Claim and verification</h2><p>{operationalPage?.game.redeemSteps.length ? 'Follow the recorded claim steps for this game. Each link shows its latest evidence state and absolute check time.' : 'Claim instructions have not passed publication validation yet.'}</p>{operationalPage?.game.redeemSteps.map((step, index) => <p><strong>{index + 1}.</strong> {step}</p>)}{operationalPage?.game.officialSourceUrl && <a href={operationalPage.game.officialSourceUrl} rel="noopener">Official source</a>}<a href="/daily/">All daily link games</a></aside>
      </section>
    )}

    {definition.kind === 'codes' && (
      <section class="page-section content-boundary split-layout wide-main">
        <div>
          <div class="section-title"><h2>Published codes</h2><span>{activeCodeEntries.length} records</span></div>
          <p class="visually-hidden" aria-live="polite" data-copy-live></p>
          {activeCodeEntries.length > 0 ? <div class="code-table" aria-label={`Published ${game?.name} codes`}>
            {activeCodeEntries.map((item) => (
              <div class="code-row">
                <div><code>{item.entry.code}</code><span>{item.entry.reward}</span><small>{entryStateLabels[item.state]}</small></div>
                <div>
                  {item.latestEvent ? <time datetime={item.latestEvent.checkedAt} data-relative-time={item.latestEvent.checkedAt}>{formatAbsoluteTimestamp(item.latestEvent.checkedAt)}</time> : <small>No verification recorded</small>}
                  <span class="record-sources">{item.entry.sourceUrls.map((url, index) => <a href={url} rel="noopener">Source {index + 1}</a>)}</span>
                  <button type="button" data-copy-code={item.entry.code}>Copy</button>
                </div>
              </div>
            ))}
          </div> : <div class="data-empty"><strong>No code is published</strong><p>This configured page remains `noindex` until a code, reward, source URL, redemption path and verification event pass validation.</p></div>}
          {expiredCodeEntries.length > 0 && <><h2 class="subhead">Expired codes</h2><div class="expired-list">
            {expiredCodeEntries.map((item) => <div><s>{item.entry.code}</s><span>{item.entry.reward}</span>{item.latestEvent ? <time datetime={item.latestEvent.checkedAt}>{formatAbsoluteTimestamp(item.latestEvent.checkedAt)}</time> : <span>Check not recorded</span>}</div>)}
          </div></>}
        </div>
        <aside><h2>Redeem and verify</h2><p>{operationalPage?.game.redeemSteps.length ? 'Use the recorded redemption path below. A successful redemption is labeled verified; an official announcement without redemption is labeled reported.' : 'Redemption instructions have not passed publication validation yet.'}</p>{operationalPage?.game.redeemSteps.map((step, index) => <p><strong>{index + 1}.</strong> {step}</p>)}{operationalPage?.game.officialSourceUrl && <a href={operationalPage.game.officialSourceUrl} rel="noopener">Official game source</a>}<a href="/how-we-verify/">How we verify</a>{expiredCodeEntries.length > 0 && <a href={`${gameRoot}expired/`}>Full archive</a>}</aside>
      </section>
    )}

    {definition.kind === 'cheats' && (
      <section class="page-section content-boundary">
        <h2>{publishedHeading}</h2>
        <div class="card-grid article-card-grid">
          {hubArticles.map((item) => (
            <a class="media-card" href={item.path}>
              <div class="media">
                <Picture
                  src={requireArticleArtwork(item.routeId).src}
                  alt={requireArticleArtwork(item.routeId).alt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[320, 528, 792, 1056]}
                  sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 50vw, 33vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="card-copy"><h3>{item.heading}</h3><p>{item.description}</p></div>
            </a>
          ))}
        </div>
        <h2 class="secondary-list-heading">More cheat pages</h2>
        <div class="catalogue">{operations.cheatGames.map((item) => {
          const page = getCheatOperationalPage(item.slug);
          return <a href={`/cheats/${item.slug}/`}><span>{item.name}<small>{item.platforms.join(', ')}</small></span><strong>{page?.isPublished ? `${page.verifiedCount + page.reportedCount} published` : 'Verification pending'}</strong></a>;
        })}</div>
      </section>
    )}

    {definition.kind === 'cheat' && (
      <section class="page-section content-boundary split-layout wide-main">
        <div><h2>Published cheats</h2>{cheatPage?.entries.length ? <div class="code-table">{cheatPage.entries.map((item) => <div class="code-row"><div><strong>{item.entry.name}</strong><code>{item.entry.input}</code><small>{item.entry.platforms.join(', ')} · {entryStateLabels[item.state]}</small></div><div>{item.latestEvent && <time datetime={item.latestEvent.checkedAt}>{formatAbsoluteTimestamp(item.latestEvent.checkedAt)}</time>}<span class="record-sources">{item.entry.sourceUrls.map((url, index) => <a href={url} rel="noopener">Source {index + 1}</a>)}</span><button type="button" data-copy-code={item.entry.input}>Copy</button></div></div>)}</div> : <div class="data-empty"><strong>No cheat record is published</strong><p>The route remains configured, but counts and rows stay hidden until platform scope, sources, confirmed build and verification events are present.</p></div>}</div>
        <aside><h2>Confirmed build</h2><p>{cheatPage?.game.confirmedBuild ?? 'No build has been confirmed for publication.'}</p><p>{cheatPage?.game.sourceUrls.length ? 'The sheet has game-level source records in addition to the source on every row.' : 'Game-level sources are still pending.'}</p><a href="/cheats/">All cheat games</a></aside>
      </section>
    )}

    {definition.kind === 'author' && (
      <section class="page-section content-boundary">
        <div class="profile-detail"><div><h2>Editorial responsibility</h2><p>Paul A owns the review and correction process for published Freetins pages.</p><p>{operations.verificationEvents.filter((event) => event.checkedBy === definition.slug).length} operational verification events are currently attributed to this profile. This number is calculated from the event log rather than entered as biography copy.</p><a href="/about/">About Freetins</a></div></div>
      </section>
    )}

    {definition.kind === 'gearCategory' && (
      <section class="page-section content-boundary">
        <h2>Checked product records</h2>
        {operations.products.filter((item) => item.category === definition.slug).length ? <div class="card-grid">{operations.products.filter((item) => item.category === definition.slug).map((item) => {
          const art = requireArtwork(gearArtwork, item.slug, 'gear product');
          return <a class="media-card" href={`/gear/${item.category}/${item.slug}/`}><div class="media"><Picture src={art.src} alt={art.alt} formats={['avif']} fallbackFormat="webp" widths={[320, 528, 792, 1056]} sizes="(max-width: 767px) calc(100vw - (2 * var(--page-gutter))), (max-width: 1199px) 50vw, 33vw" loading="lazy" decoding="async" /></div><div class="card-copy"><h3>{item.name}</h3><p>{item.price} {item.currency} · checked {formatAbsoluteTimestamp(item.checkedAt)}</p></div></a>;
        })}</div> : <div class="data-empty"><strong>No product recommendation is published</strong><p>The category remains configured. A card appears only after price, currency, merchant URL, check timestamp and disclosure pass validation.</p></div>}
      </section>
    )}

    {definition.kind === 'gearProduct' && (
      <section class="page-section content-boundary product-layout">{productArt && <div class="product-media"><Picture src={productArt.src} alt={productArt.alt} formats={['avif']} fallbackFormat="webp" widths={[480, 768, 1080, 1536]} sizes="(max-width: 767px) calc(100vw - (2 * var(--page-gutter))), 55vw" loading="eager" fetchpriority="high" decoding="async" /></div>}<div>{product ? <><p class="eyebrow">Checked listing</p><h2>Published product record</h2><dl><div><dt>Price</dt><dd>{product.price} {product.currency}</dd></div><div><dt>Checked</dt><dd>{formatAbsoluteTimestamp(product.checkedAt)}</dd></div><div><dt>Disclosure</dt><dd>{product.disclosure}</dd></div></dl><a href={product.merchantUrl} rel="sponsored noopener">Open merchant source</a><br /><Button href="/disclosure/" variant="secondary">Read the disclosure</Button></> : <div class="data-empty"><strong>This listing is not published</strong><p>The product surface is preserved, but no price, stock or recommendation is asserted until a validated merchant record exists.</p></div>}</div></section>
    )}

    {definition.kind === 'values' && (
      <section class="page-section content-boundary"><div class="section-title"><h2>{game?.name}, published values</h2><span>Source on every row</span></div>{operationalPage?.values.length ? <div class="data-table">{operationalPage.values.map((item) => <div><strong>{item.item}</strong><span>{item.tier}</span><b>{item.value}</b><time datetime={item.observedAt}>{formatAbsoluteTimestamp(item.observedAt)}</time><a href={item.sourceUrl} rel="noopener">Source</a></div>)}</div> : <div class="data-empty"><strong>No value row is published</strong><p>The values surface remains configured, but it cannot display estimates, trends or trade counts without a timestamped source record.</p></div>}</section>
    )}

    {(definition.kind === 'privacy' || definition.kind === 'affiliate' || definition.kind === 'terms') && (
      <section class="page-section content-boundary prose"><p class="updated">Last updated 21 August 2026</p>{legalSections.map(([heading, copy], index) => <section><span>{String(index + 1).padStart(2, '0')}</span><div><h2>{heading}</h2><p>{copy}</p></div></section>)}</section>
    )}

    {definition.kind === 'info' && hubArticles.length > 0 && (
      <section class="page-section content-boundary">
        <h2>{publishedHeading}</h2>
        <div class="card-grid article-card-grid">
          {hubArticles.map((item) => (
            <a class="media-card" href={item.path}>
              <div class="media">
                <Picture
                  src={requireArticleArtwork(item.routeId).src}
                  alt={requireArticleArtwork(item.routeId).alt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[320, 528, 792, 1056]}
                  sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 50vw, 33vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="card-copy"><h3>{item.heading}</h3><p>{item.description}</p></div>
            </a>
          ))}
        </div>
      </section>
    )}

    {definition.kind === 'verify' && (
      <section class="page-section content-boundary"><h2>Evidence and publication flow</h2><div class="process-grid">{[['01', 'Record the source', 'Every operational entry needs a real HTTPS source URL.'], ['02', 'Perform the right check', 'A redemption, opened link, entered cheat or official-source review becomes a verification event.'], ['03', 'Store the result', 'The event records an ISO timestamp, method, result and responsible editor.'], ['04', 'Derive the page', 'Counts, freshness, archive state and author totals are calculated from those records.']].map(([num, title, copy]) => <div><strong>{num}</strong><h3>{title}</h3><p>{copy}</p></div>)}</div><div class="data-empty"><strong>Automated checker: {operations.services.checker.enabled ? 'configured' : 'not configured'}</strong><p>{operations.services.checker.enabled ? `The configured schedule is every ${operations.services.checker.scheduleMinutes} minutes. Runtime status still comes from the checker status store.` : 'Manual verification records can be published now. The site does not claim an automated schedule until the checker service is enabled.'}</p></div></section>
    )}

    {definition.kind === 'updates' && (
      <section class="page-section content-boundary">{timelineEntries.length ? <div class="timeline">{timelineEntries.map((item) => <article><time datetime={item.publishedAt}>{formatAbsoluteTimestamp(item.publishedAt)}</time><span>{item.version}</span><div><h2>{item.title}</h2><p>{item.summary}</p><a href={item.sourceUrl} rel="noopener">Source</a></div></article>)}</div> : <div class="data-empty"><strong>No timeline entry is published</strong><p>The timeline remains configured. An entry appears only with a version, summary, absolute publication time and source URL.</p></div>}</section>
    )}

    {definition.kind === 'archive' && (
      <section class="page-section content-boundary"><div class="section-title"><h2>{game ? `${game.name}, expired code records` : 'Expired code records'}</h2><span>{expiredCodeEntries.length} archived</span></div>{expiredCodeEntries.length ? <div class="data-table archive-table">{expiredCodeEntries.map((item) => <div><s>{item.entry.code}</s><span>{item.entry.reward}</span>{item.latestEvent ? <time datetime={item.latestEvent.checkedAt}>{formatAbsoluteTimestamp(item.latestEvent.checkedAt)}</time> : <span>No removal check</span>}<small>{item.entry.sourceUrls.map((url, index) => <a href={url} rel="noopener">Source {index + 1}</a>)}</small></div>)}</div> : <div class="data-empty"><strong>No expired code is recorded</strong><p>The archive route remains configured, but it does not clone sample rows or invent a historical count.</p></div>}</section>
    )}

    {definition.kind === 'guide' && (
      <section class="page-section content-boundary"><div class="data-empty"><strong>This guide is configured but not published</strong><p>The route is preserved for editorial work and remains `noindex`. It will move into the published Guides index only after the full article and its sources are added to the editorial data.</p></div></section>
    )}

    {definition.kind === 'search' && (
      <section class="page-section content-boundary form-layout">
        <form method="get" action="/search/">
          <label>Game, guide or code<input type="search" name="q" placeholder="Grow a Garden" /></label>
          <button type="submit">Search</button>
        </form>
        <aside><h2>Published content only</h2><p>Search results should point to published editorial pages and evidence-backed operational pages, not configured drafts.</p></aside>
      </section>
    )}

    {definition.kind === 'alerts' && (
      <section class="page-section content-boundary">{operations.services.alerts.enabled && operations.services.alerts.subscriptionEndpoint ? <div class="form-layout"><form method="post" action={operations.services.alerts.subscriptionEndpoint}><label>Your email<input type="email" name="contact" autocomplete="email" required /></label><button type="submit">Subscribe</button></form><aside><h2>Active channels</h2><p>{operations.services.alerts.channels.join(', ')}</p></aside></div> : <div class="data-empty"><strong>Alerts are configured but not active</strong><p>No contact details are collected. The form will appear only after a delivery channel and HTTPS subscription endpoint pass configuration validation.</p></div>}</section>
    )}

    {definition.kind === 'submit' && (
      <section class="page-section content-boundary"><div class="data-empty"><strong>Submission intake is not active</strong><p>No form data is collected or queued. For a correction to an existing page, email <a href="mailto:hello@freetins.com">hello@freetins.com</a> with the page URL and source.</p></div></section>
    )}

    {definition.kind === 'notTracked' && (
      <section class="page-section content-boundary"><div class="notice"><span>{definition.eyebrow ?? 'Freetins'}</span><h2>Request the game and it enters validation</h2><p>{definition.description}</p></div></section>
    )}

    {relatedLinks.length > 0 && <nav class="next-links content-boundary" aria-label="Related pages">{relatedLinks.map(([label, href]) => <a href={href}>{label}</a>)}</nav>}
  </article>

</BaseLayout>
)}

