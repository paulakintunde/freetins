    {definition.kind === 'gearCategory' && (
      <section class="page-section content-boundary">
        <h2>Checked product records</h2>
        {operations.products.filter((item) => item.category === definition.slug).length ? <div class="card-grid">{operations.products.filter((item) => item.category === definition.slug).map((item) => {
          const art = requireArtwork(gearArtwork, item.slug, 'gear product');
          return <a class="media-card" href={`/gear/${item.category}/${item.slug}/`}><div class="media"><Picture src={art.src} alt={art.alt} formats={['avif']} fallbackFormat="webp" widths={[320, 528, 792, 1056]} sizes="(max-width: 767px) calc(100vw - (2 * var(--page-gutter))), (max-width: 1199px) 50vw, 33vw" loading="lazy" decoding="async" /></div><div class="card-copy"><h3>{item.name}</h3><p>{item.price} {item.currency} · checked {formatAbsoluteTimestamp(item.checkedAt)}</p></div></a>;
        })}</div> : <div class="data-empty"><strong>No product recommendation is published</strong><p>The category remains configured. A card appears only after price, currency, merchant URL, check timestamp and disclosure pass validation.</p></div>}
      </section>
    )}

    {definition.kind === 'gearProduct' && (
      <section class="page-section content-boundary product-layout">{productArt && <div class="product-media"><Picture src={productArt.src} alt={productArt.alt} formats={['avif']} fallbackFormat="webp" widths={[480, 768, 1080, 1536]} sizes="(max-width: 767px) calc(100vw - (2 * var(--page-gutter))), 55vw" loading="eager" fetchpriority="high" decoding="async" /></div>}<div>{product ? <><p class="eyebrow">Checked listing</p><h2>Published product record</h2><dl><div><dt>Price</dt><dd>{product.price} {product.currency}</dd></div><div><dt>Checked</dt><dd>{formatAbsoluteTimestamp(product.checkedAt)}</dd></div><div><dt>Disclosure</dt><dd>{product.disclosure}</dd></div></dl><a href={product.merchantUrl} rel="sponsored noopener">Open merchant source</a><br /><Button href="/disclosure/" variant="secondary">Read the disclosure</Button></> : <div class="data-empty"><strong>This listing is not published</strong><p>The product surface is preserved, but no price, stock or recommendation is asserted until a validated merchant record exists.</p></div>}</div></section>
    )}

    {definition.kind === 'values' && (
      <section class="page-section content-boundary"><div class="section-title"><h2>{game?.name}, published values</h2><span>Source on every row</span></div>{operationalPage?.values.length ? <div class="data-table">{operationalPage.values.map((item) => <div><strong>{item.item}</strong><span>{item.tier}</span><b>{item.value}</b><time datetime={item.observedAt}>{formatAbsoluteTimestamp(item.observedAt)}</time><a href={item.sourceUrl} rel="noopener">Source</a></div>)}</div> : <div class="data-empty"><strong>No value row is published</strong><p>The values surface remains configured, but it cannot display estimates, trends or trade counts without a timestamped source record.</p></div>}</section>
    )}

    {(definition.kind === 'privacy' || definition.kind === 'affiliate' || definition.kind === 'terms') && (
      <section class="page-section content-boundary prose"><p class="updated">Last updated 21 August 2026</p>{legalSections.map(([heading, copy], index) => <section><span>{String(index + 1).padStart(2, '0')}</span><div><h2>{heading}</h2><p>{copy}</p></div></section>)}</section>
    )}

    {definition.kind === 'info' && hubArticles.length > 0 && (
      <section class="page-section content-boundary">
        <h2>{publishedHeading}</h2>
        <div class="card-grid article-card-grid">
          {hubArticles.map((item) => (
            <a class="media-card" href={item.path}>
              <div class="media">
                <Picture
                  src={requireArticleArtwork(item.routeId).src}
                  alt={requireArticleArtwork(item.routeId).alt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[320, 528, 792, 1056]}
                  sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 50vw, 33vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="card-copy"><h3>{item.heading}</h3><p>{item.description}</p></div>
            </a>
          ))}
        </div>
      </section>
    )}

    {hubDatasetPages.length > 0 && (
      <section class="page-section content-boundary">
        <h2>{publishedHeading ?? 'Published pages'}</h2>
        <div class="card-grid article-card-grid">
          {hubDatasetPages.map((item) => {
            // Artwork is optional here: a dataset page ships on its data, and a
            // missing image must not keep it off its own hub.
            const art = articleArtwork[item.slug];
            return (
              <a class="media-card" href={item.path}>
                {art && (
                  <div class="media">
                    <Picture
                      src={art.src}
                      alt={art.alt}
                      formats={['avif']}
                      fallbackFormat="webp"
                      widths={[320, 528, 792, 1056]}
                      sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 50vw, 33vw"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="card-copy">
                  <h3>{item.heading}</h3>
                  <p>{item.description}</p>
                  {item.checkedAt ? (
                    <p class="card-checked">
                      Last verified <time datetime={item.checkedAt}>{formatAbsoluteTimestamp(item.checkedAt)}</time>
                    </p>
                  ) : addedAtOf(item) && (
                    <p class="card-checked">
                      Added <time datetime={addedAtOf(item)}>{formatAbsoluteTimestamp(addedAtOf(item))}</time>
                    </p>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {definition.kind === 'updates' && (
      <section class="page-section content-boundary">{timelineEntries.length ? <div class="timeline">{timelineEntries.map((item) => <article><time datetime={item.publishedAt}>{formatAbsoluteTimestamp(item.publishedAt)}</time><span>{item.version}</span><div><h2>{item.title}</h2><p>{item.summary}</p><a href={item.sourceUrl} rel="noopener">Source</a></div></article>)}</div> : <div class="data-empty"><strong>No timeline entry is published</strong><p>The timeline remains configured. An entry appears only with a version, summary, absolute publication time and source URL.</p></div>}</section>
    )}

    {definition.kind === 'guide' && (
      <section class="page-section content-boundary"><div class="data-empty"><strong>This guide is configured but not published</strong><p>The route is preserved for editorial work and stays out of the index. It moves into the published Guides index only after the full article and its sources are added to the editorial data.</p></div></section>
    )}

    {definition.kind === 'search' && (
      <section class="page-section content-boundary search-page" data-search-app>
        <div class="form-layout">
          <div class="search-panel">
            <form method="get" action="/search/" role="search" data-search-form>
              <label for="site-query">Game, guide or code</label>
              <div class="search-row">
                <input
                  id="site-query"
                  type="search"
                  name="q"
                  placeholder="Grow a Garden"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                  data-search-input
                />
                <button type="submit">Search</button>
              </div>
            </form>

            <p class="search-status" role="status" aria-live="polite" data-search-status></p>

            <div class="search-results" data-search-results>
              <div class="data-empty">
                <strong>Type a game, guide or code</strong>
                <p>Search covers every published code page, daily-link page, cheat sheet, answer sheet and guide on Freetins.</p>
              </div>
            </div>

            <noscript>
              <div class="data-empty">
                <strong>Search needs JavaScript</strong>
                <p>Browse <a href="/games/">all games A-Z</a>, <a href="/codes/">all codes</a>, <a href="/daily/">daily links</a>, <a href="/cheats/">cheats</a>, <a href="/answers/">answers</a> or <a href="/guides/">guides</a> instead.</p>
              </div>
            </noscript>

            <div class="search-shortcuts">
              <span>Most searched</span>
              {hotSearches.map((term) => (
                <a href={`/search/?q=${encodeURIComponent(term)}`}>{term}</a>
              ))}
            </div>
          </div>

          <aside>
            <h2>Published content only</h2>
            <p>Results point to published editorial pages and operational pages with at least one entry listed. Pages with nothing listed are excluded.</p>
            <p>{searchIndex.length} pages are indexed.</p>
          </aside>
        </div>
      </section>
    )}

    {definition.kind === 'alerts' && (
      <section class="page-section content-boundary">{operations.services.alerts.enabled && operations.services.alerts.subscriptionEndpoint ? <div class="form-layout"><form method="post" action={operations.services.alerts.subscriptionEndpoint}><label>Your email<input type="email" name="contact" autocomplete="email" required /></label><button type="submit">Subscribe</button></form><aside><h2>Active channels</h2><p>{operations.services.alerts.channels.join(', ')}</p></aside></div> : <div class="data-empty"><strong>Alerts are configured but not active</strong><p>No contact details are collected. The form will appear only after a delivery channel and HTTPS subscription endpoint pass configuration validation.</p></div>}</section>
    )}

    {definition.kind === 'submit' && (
      <section class="page-section content-boundary"><div class="data-empty"><strong>Submission intake is not active</strong><p>No form data is collected or queued. For a correction to an existing page, email <a href={`mailto:${contactEmail}`}>{contactEmail}</a> with the page URL and source.</p></div></section>
    )}

    {definition.kind === 'notTracked' && (
      <section class="page-section content-boundary"><div class="notice"><span>{definition.eyebrow ?? 'Freetins'}</span><h2>Request the game and it enters validation</h2><p>{definition.description}</p></div></section>
    )}

    {datasetRelated.length > 0 && (
      <section class="page-section content-boundary related-games">
        <h2 class="subhead">Guides and explainers</h2>
        <div class="related-grid">
          {datasetRelated.map((link) => (
            <a href={link.href}>
              <strong>{link.label}</strong>
              {link.description && <span>{link.description}</span>}
            </a>
          ))}
        </div>
      </section>
    )}

    {gameRelated.length > 0 && (
      <section class="page-section content-boundary related-games">
        <h2 class="subhead">More {game?.platform} code pages</h2>
        <div class="related-grid">
          {gameRelated.map((link) => (
            <a href={link.href}>
              <strong>{link.label}</strong>
              {link.description && <span>{link.description}</span>}
            </a>
          ))}
        </div>
      </section>
    )}

    {relatedLinks.length > 0 && <nav class="next-links content-boundary" aria-label="Related pages">{relatedLinks.map(([label, href]) => <a href={href}>{label}</a>)}</nav>}
  </article>

  {/* Both imports stay in one unconditional block. Astro hoists `<script>` at build
      time, and putting this one behind `readerReportsEnabled` drops its chunk from the
      output altogether — the control renders and nothing is listening. The script is
      inert without the control, so the cost of shipping it either way is one small
      chunk, which is the cheaper of the two mistakes. */}
  <script>
    import '../../scripts/search';
    import '../../scripts/code-reports';
  </script>
</BaseLayout>
)}

<style>
  .route-page { padding-bottom: clamp(54px, 7vw, 92px); }
  .page-head { padding: clamp(28px, 4vw, 52px) var(--page-gutter) 0; }
  .breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 6px; margin-bottom: 14px; color: var(--text-tertiary); font: 400 13px / 1.4 var(--font-core); }
  .breadcrumbs a { display: inline-flex; align-items: center; min-height: 32px; color: var(--text-tertiary); }
  .breadcrumbs a::after { margin-left: 6px; content: '/'; color: var(--text-caption); }
  .eyebrow { margin: 0 0 12px; color: var(--text-brand); font: 700 12px / 1.4 var(--font-core); letter-spacing: .12em; text-transform: uppercase; }
  h1 { max-width: 28ch; margin: 0; color: var(--text-primary); font: 600 var(--fs-h1) / var(--lh-h1) var(--font-display); letter-spacing: .02em; text-transform: uppercase; text-wrap: pretty; }
  .lede { max-width: 66ch; margin: 16px 0 0; color: var(--text-secondary); font: 400 var(--fs-body-lg) / var(--lh-body-lg) var(--font-core); text-wrap: pretty; }
  .stats { display: flex; flex-wrap: wrap; margin-top: 24px; border: 1px solid var(--border-subtle); background: var(--surface-raised); }
  .stats > div { min-width: 150px; flex: 1 1 150px; padding: 12px 16px; border-right: 1px solid var(--border-subtle); }
  .stats span, .section-title > span { display: block; color: var(--text-caption); font: 700 var(--fs-caption) / 1.4 var(--font-core); letter-spacing: .12em; text-transform: uppercase; }
  .stats strong { display: block; margin-top: 5px; color: var(--text-primary); font: 600 18px / 1.2 var(--font-display); font-variant-numeric: tabular-nums; }
