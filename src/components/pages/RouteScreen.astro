---
import { Picture } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Button from '../ui/Button.astro';
import EditorialArticle from './EditorialArticle.astro';
import { articleArtwork, requireArticleArtwork } from '../../data/article-images';
import { editorialArticles, getArticleByPath } from '../../data/articles';
import { listAllDatasetPages, listDatasetPages, type DatasetPageSummary, type DatasetSection } from '../../lib/datasetPages';
import { authorPerson, authorPersonId, authors, getAuthorBySlug, getSectionAuthor } from '../../data/authors';
import { hubIntroFor } from '../../data/hub-intros';
import { contactEmail, websiteId } from '../../data/site';
import EntrySource from '../ui/EntrySource.astro';
import {
  dailyLinkCatalogue,
  gameCatalogue,
  plannedGameCatalogue,
  publishedDailyLinkCatalogue,
  publishedGameCatalogue,
} from '../../data/home';
import {
  dailyArtwork,
  gameArtwork,
  gearArtwork,
  requireArtwork,
} from '../../data/site-images';
import type { RouteDefinition } from '../../data/routes';
import { gameTabsForSlug } from '../../data/game-tabs';
import { datasetLinksForGame, gameRelatedLinks } from '../../data/interlinks';
import { searchIndex } from '../../data/search';
import { hotSearches } from '../../data/site';
import {
  formatAbsoluteTimestamp,
  getCheatOperationalPage,
  getGameOperationalPage,
  getProduct,
  operations,
  type CodeEntry,
  type DailyLinkEntry,
  isLiveState,
  type EntryState,
  type ResolvedEntry,
  type VerificationMethod,
} from '../../data/operations';
import { canonicalUrl } from '../../lib/pageGraph';
import type { CheckerSnapshot } from '../../lib/checker-status';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  definition: RouteDefinition;
  checkerSnapshot?: CheckerSnapshot;
}

const { definition, checkerSnapshot } = Astro.props;
const codeCopyEntry = definition.kind === 'codes'
  ? (await getCollection('codes')).find((entry) => entry.id === definition.slug)
  : undefined;
const renderedCodeCopy = codeCopyEntry ? await render(codeCopyEntry) : null;
const CodeCopy = renderedCodeCopy?.Content;
const article = getArticleByPath(definition.path);
const hubArticles = definition.routeId === 'answers'
  ? editorialArticles.filter((item) => item.section === 'answers')
  : definition.routeId === 'guideIndex'
    ? editorialArticles.filter((item) => item.section === 'guides')
    : definition.routeId === 'cheats'
      ? editorialArticles.filter((item) => item.section === 'cheats')
      : definition.routeId === 'daily'
        ? editorialArticles.filter((item) => item.section === 'daily')
    : [];
/*
 * Dataset-backed pages live in their own collections and are not part of
 * editorialArticles, so the hubs list them separately or they ship as orphans.
 */
const hubDatasetSection: DatasetSection | null = definition.routeId === 'guideIndex'
  ? 'guides'
  : definition.routeId === 'daily'
    ? 'daily'
    : definition.routeId === 'updates'
      ? 'blog'
      : null;
/*
 * Most recently recorded first. The loader returns collection order, which is
 * effectively filename order, so without this a hub presents its oldest page as
 * its lead card. A page that predates the ledger carries a `checkedAt` baseline
 * and sorts on it; a new page has none and sorts on the date its first row was
 * added, after those. A hub never hides a page for want of a check.
 */
const addedAtOf = (item: DatasetPageSummary): string =>
  'addedAt' in item && typeof item.addedAt === 'string' ? item.addedAt : '';
const hubDatasetPages = (hubDatasetSection ? await listDatasetPages(hubDatasetSection) : [])
  .sort((left, right) => {
    if (left.checkedAt && right.checkedAt) return Date.parse(right.checkedAt) - Date.parse(left.checkedAt);
    if (left.checkedAt || right.checkedAt) return left.checkedAt ? -1 : 1;
    return (Date.parse(addedAtOf(right)) || 0) - (Date.parse(addedAtOf(left)) || 0);
  });

const publishedHeading = {
  answers: 'Published Answers',
  guideIndex: 'Published Guides',
  cheats: 'Published Cheats',
  daily: 'Published Daily Guides',
  updates: 'Published Posts',
}[definition.routeId];
const game = gameCatalogue.find((item) => item.slug === definition.slug);
const dailyGame = dailyLinkCatalogue.find((item) => item.slug === definition.slug);
const operationalPage = definition.slug ? getGameOperationalPage(definition.slug) : null;
const cheatPage = definition.slug ? getCheatOperationalPage(definition.slug) : null;
const product = definition.slug ? getProduct(definition.slug) : undefined;
const hubIntro = hubIntroFor(definition.routeId);
const profileAuthor = definition.kind === 'author' && definition.slug ? getAuthorBySlug(definition.slug) : undefined;
const profileArticles = profileAuthor
  ? editorialArticles.filter((item) => getSectionAuthor(item.section).slug === profileAuthor.slug)
  : [];
/*
 * Only an editor's own acts count under a name. Importer output (`manual-review`,
 * written by a script from a writer's date), reader signal and worker fetches are
 * events on the record, but none of them is something this person did.
 */
const nonEditorMethods = new Set<VerificationMethod>(['manual-review', 'reader-corroborated', 'automated-fetch']);
const profileAuthorEvents = definition.slug
  ? operations.verificationEvents.filter((event) => event.checkedBy === definition.slug && !nonEditorMethods.has(event.method)).length
  : 0;
/*
 * Only cheat games with a published sheet are listed. Naming a game the site has
 * nothing for advertises a promise the page cannot keep and sends crawlers into
 * an empty draft.
 */
const publishedCheatGames = operations.cheatGames
  .map((item) => ({ item, page: getCheatOperationalPage(item.slug) }))
  .filter((entry): entry is { item: typeof entry.item; page: NonNullable<typeof entry.page> } =>
    Boolean(entry.page?.isPublished));
const codeEntries = (operationalPage?.entries ?? []).filter(
  (item): item is ResolvedEntry<CodeEntry> => 'code' in item.entry,
);
const liveCodeEntries = codeEntries.filter((item) => isLiveState(item.state));
const expiredCodeEntries = codeEntries.filter((item) => item.state === 'expired');
/*
 * Whether the reader-report control is rendered at all. Configuration decides it, at
 * build time, so a page view costs no Function request and no KV read: the client
 * never asks the endpoint whether it exists (docs/adr/0005). When the flag is off
 * nothing renders — no markup, no note — because a thumb whose click cannot be
 * recorded is worse than no thumb.
 */
const readerReportsEnabled = operations.services.reports.enabled;
const dailyEntries = (operationalPage?.entries ?? []).filter(
  (item): item is ResolvedEntry<DailyLinkEntry> => 'url' in item.entry,
);
const timelineEntries = definition.slug ? operationalPage?.updates ?? [] : operations.updates;
const entryStateLabels: Record<EntryState, string> = {
  verified: '★ Verified',
  active: 'Active · as published',
  listed: 'Listed · awaiting editor verification',
  expired: 'Expired',
};
const awaitingLabel = 'Awaiting editor verification';
const gameRoot = game ? `/codes/${game.slug}/` : '/codes/grow-a-garden/';
const isGamePage = ['codes', 'values', 'updates'].includes(definition.kind) && Boolean(game);
/*
 * A tab bar with a single entry is just the page you are already on, so it is not
 * rendered. gameTabsForSlug returns an empty list in that case.
 */
const gameTabs = game ? gameTabsForSlug(game.slug) : [];
const currentTabId = definition.kind;
const gameArt = game
  ? requireArtwork(gameArtwork, game.slug, 'game')
  : undefined;
const dailyArt = dailyGame
  ? requireArtwork(dailyArtwork, dailyGame.slug, 'daily reward')
  : undefined;
const productArt = definition.kind === 'gearProduct' && definition.slug
  ? requireArtwork(gearArtwork, definition.slug, 'gear product')
  : undefined;
const categoryGearSlug = definition.kind === 'gearCategory'
  ? {
      roblox: 'roblox-gift-card-25-cad',
      mobile: 'controller-for-mobile-play',
      'pc-and-console': 'wired-gaming-headset-mid-range',
    }[definition.slug ?? '']
  : undefined;
const collectionArt = definition.kind === 'daily'
  ? requireArtwork(dailyArtwork, 'monopoly-go', 'daily reward')
  : definition.kind === 'gearCategory'
    ? categoryGearSlug
      ? requireArtwork(gearArtwork, categoryGearSlug, 'gear product')
      : undefined
    : undefined;
const guideArt = definition.kind === 'guide'
  ? requireArtwork(gameArtwork, 'grow-a-garden', 'game')
  : undefined;
const routeArtwork = gameArt ?? dailyArt ?? productArt ?? collectionArt ?? guideArt;
const showHeaderArtwork = ['browse', 'codes', 'values', 'dailyGame', 'daily', 'guide'].includes(definition.kind)
  && Boolean(routeArtwork);

const stats = (() => {
  switch (definition.kind) {
    case 'daily': return [['Configured', String(dailyLinkCatalogue.length)], ['Published', String(publishedDailyLinkCatalogue.length)], ['Listed links', String(publishedDailyLinkCatalogue.reduce((total, item) => total + item.liveCount, 0))], ['★ Verified', String(publishedDailyLinkCatalogue.reduce((total, item) => total + item.verifiedCount, 0))]];
    case 'browse': return [['Configured', String(gameCatalogue.length)], ['Published', String(publishedGameCatalogue.length)], ['Listed codes', String(publishedGameCatalogue.reduce((total, item) => total + item.liveCount, 0))], ['★ Verified', String(publishedGameCatalogue.reduce((total, item) => total + item.verifiedCount, 0))]];
    case 'codes': return [['Listed', String(operationalPage?.liveCount ?? 0)], ['★ Verified', String(operationalPage?.verifiedCount ?? 0)], ['Expired', String(operationalPage?.expiredCount ?? 0)], ['Last recorded', operationalPage?.latestCheckedAt ? formatAbsoluteTimestamp(operationalPage.latestCheckedAt) : awaitingLabel]];
    case 'az': return [['Published games', String(publishedGameCatalogue.length + publishedDailyLinkCatalogue.length)], ['Code pages', String(publishedGameCatalogue.length)], ['Daily-link pages', String(publishedDailyLinkCatalogue.length)], ['Cheat sheets', String(publishedCheatGames.length)]];
    case 'values': return [['Items published', String(operationalPage?.values.length ?? 0)], ['Source required', 'Every row'], ['Updated', operationalPage?.values[0] ? formatAbsoluteTimestamp(operationalPage.values[0].observedAt) : 'Not recorded'], ['State', operationalPage?.values.length ? 'Published' : 'Pending']];
    case 'search': return [['Published pages', String(editorialArticles.length + publishedGameCatalogue.length + publishedDailyLinkCatalogue.length)], ['Code games', String(publishedGameCatalogue.length)], ['Daily links', String(publishedDailyLinkCatalogue.length)], ['Editorial', String(editorialArticles.length)]];
    default: return [];
  }
})();

const legalCopy: Record<string, Array<[string, string]>> = {
  privacy: [
    ['What we collect', 'The published site does not currently collect alert subscriptions or code submissions. If you email us, we receive the information you choose to send. Cloudflare processes the technical request data needed to deliver and secure the site.'],
    ['How it is used', 'Information sent by email is used to answer the message, investigate a correction or review a source.'],
    ['Who we share data with', 'Cloudflare delivers and secures the site. No optional analytics, advertising or alert-delivery provider is configured in the current operational record.'],
    ['Your choices', 'Cookie choices can be reopened from the footer. You can ask us to delete information you submitted.'],
  ],
  affiliate: [
    ['Which links pay us', 'Some Gear links pay Freetins a commission when a purchase is completed. Those links are marked before you click.'],
    ['What money never buys', 'Payment never changes a code result, verification result, tier position or editorial recommendation.'],
    ['How a paid thing is labelled', 'Sponsored and affiliate placements carry a visible label in the module that contains them.'],
    ['How products get picked', 'A product must solve the specific problem named on the page before its commercial terms are considered.'],
  ],
  terms: [
    ['Using the site', 'You may read, link to and share individual Freetins pages. Automated extraction and republication require permission.'],
    ['Codes and links', 'A game developer controls whether a code or link works. When we publish a verification result, the record includes its source and absolute check time.'],
    ['Corrections', 'Report an error through Contact. We review the page, supplied source and current operational record before publishing a correction.'],
    ['Governing law', 'These terms are governed by the law of Ontario, Canada, without removing rights you hold where you live.'],
  ],
};

const pageLinks: Record<string, Array<[string, string]>> = {
  alerts: [['Manage alerts', '/alerts/'], ['Privacy', '/privacy/']],
  contact: [['How we verify', '/how-we-verify/'], ['Disclosure', '/disclosure/'], ['Blog', '/blog/']],
  search: [['Browse all codes', '/codes/'], ['All games A-Z', '/games/'], ['How we verify', '/how-we-verify/']],
  updates: [['How we verify', '/how-we-verify/'], ['Resources', '/resources/']],
  notTracked: [['Request this game', '/submit/'], ['Browse every game', '/games/'], ['Search Freetins', '/search/']],
  guide: [['Guides', '/guides/'], ['Resources', '/resources/'], ['How we verify', '/how-we-verify/']],
};

const relatedLinks = pageLinks[definition.kind] ?? [];
/*
 * Code pages carried no related links at all, so every game was a dead end apart
 * from the breadcrumb. Editorial coverage of the game comes first, then published
 * siblings on the same platform.
 */
const gameRelated = definition.kind === 'codes' && game?.slug ? gameRelatedLinks(game.slug) : [];

/*
 * Dataset pages were reachable only from their section hub and site search, so a
 * reader on a code page had no route to the guide covering the same game. The
 * match is on the game's own listing id, never on a similar slug.
 */
const datasetRelated = definition.kind === 'codes' && game
  ? datasetLinksForGame(game, await listAllDatasetPages())
  : [];
const legalSections = legalCopy[definition.kind] ?? [];

const crumbTrail: Array<[string, string]> = isGamePage
  ? [['Home', '/'], ['Codes', '/codes/'], [game?.name ?? 'Game', gameRoot]]
  : [['Home', '/']];

/*
 * The template renders definition.heading as the final aria-current crumb, so a
 * trail entry pointing at this very page would render it twice. On a game's own
 * codes page the last trail entry is the game root, which is this page, and it
 * produced "Home / Codes / Grow a Garden / Grow a Garden".
 *
 * Matched on the path, not on the label. The labels agreed only for as long as
 * the heading was the bare game name; the moment the heading became "Grow a
 * Garden codes" a label comparison stopped matching and the duplicate crumb
 * came back, this time as a link to the page the reader is already on. The path
 * is what "this is the current page" actually means.
 */
const crumbs = crumbTrail.filter(([, href], index) =>
  !(index === crumbTrail.length - 1 && href === definition.path));

const routeUrl = canonicalUrl(definition.path, Astro.site).toString();
const breadcrumbItems = [...crumbs.map(([label, href]) => ({ label, href })), { label: definition.heading, href: definition.path }];

/*
 * Game code pages carry a FAQPage so the counts on the page are machine-readable.
 * The answer is a tally of states, never a claim that a check happened: a listed
 * code is one no editor has tested yet, and the answer says so. dateModified on the
 * Dataset node comes from the same record the page renders, so the two can never
 * disagree.
 */
const codePageFaq = definition.kind === 'codes' && operationalPage?.game.redeemSteps.length
  ? [
      {
        question: `How do you redeem codes in ${operationalPage.game.name}?`,
        answer: operationalPage.game.redeemSteps
          .map((step, index) => `${index + 1}. ${step}`)
          .join(' '),
      },
      {
        question: `How many ${operationalPage.game.name} codes are listed right now?`,
        answer: liveCodeEntries.length > 0
          ? `${liveCodeEntries.length} of ${codeEntries.length} codes on record are live: ${operationalPage.verifiedCount} verified by an editor, ${liveCodeEntries.length - operationalPage.verifiedCount} listed and awaiting one, ${expiredCodeEntries.length} kept in the expired archive. A listed code has not been tested by a Freetins editor yet.`
          : `None of the ${codeEntries.length} codes on record is live: every one has been retired or has passed its expiry, and each stays on the page so you can tell a dead code from one that never existed.`,
      },
    ]
  : [];

/*
 * The code list is bound to the table the page actually renders: the published
 * rows plus the expired archive kept beside them, on the `codes` route only.
 * The Dataset node it replaces was gated on a recorded check instead, so it
 * appeared on a route with no table and vanished from a table with no check.
 */
const hasCodeList = definition.kind === 'codes' && codeEntries.length > 0;
/*
 * A recorded check is the only thing that may date this page. `latestCheckedAt`
 * comes from the record the table renders, so the date and the rows can never
 * disagree, and a page nobody has checked carries no date rather than the build
 * clock's (CLAUDE.md; docs/adr/0003-no-hand-typed-verification-claims.md).
 */
const recordedCheckAt = isGamePage ? operationalPage?.latestCheckedAt : undefined;
/*
 * `★ Verified` is the site's published word for a state, and the star is part of
 * how the table shows it, not part of what it says. A description reads the
 * label out loud, so the glyph comes off and the wording stays exactly as the
 * page publishes it.
 */
const spokenStateLabel = (state: EntryState) => entryStateLabels[state].replace('★ ', '');

/*
 * Merged into BaseLayout's single WebPage node rather than declared in a graph
 * of its own. A second script tag is a second graph, and two graphs on one page
 * are how one `@id` came to carry two names (src/lib/pageGraph.ts). The trail
 * ends at this page, so it belongs to this page's node; on a code page the code
 * record is what the page is about.
 */
const webPageProperties = {
  breadcrumb: { '@id': `${routeUrl}#breadcrumb` },
  ...(hasCodeList ? { mainEntity: { '@id': `${routeUrl}#codelist` } } : {}),
  ...(profileAuthor ? { mainEntity: { '@id': authorPersonId(profileAuthor, Astro.site) } } : {}),
  /*
   * `dateModified` sits here rather than on the list beside it: ItemList is an
   * Intangible and has no such property, while a WebPage is a CreativeWork and
   * does. Moving off Dataset would otherwise have dropped the page's only
   * machine-readable freshness signal on the way past.
   */
  ...(recordedCheckAt ? { dateModified: recordedCheckAt } : {}),
};

const routeSchemaNodes = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${routeUrl}#breadcrumb`,
    itemListElement: breadcrumbItems.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.label,
      item: new URL(crumb.href, Astro.site).toString(),
    })),
  },
  /*
   * An ItemList, not a Dataset. Dataset feeds Google Dataset Search — a
   * research-data vertical this page has no business in — and asks for
   * `license` and a real `distribution`, neither of which a rendered table of
   * codes has. Neither type earns a rich result here; the list is simply the
   * true description of what the page holds, which is what a machine reading it
   * needs. Every row carries its own published state, so nothing in the graph
   * says a code works that the table does not also say.
   */
  ...(hasCodeList && operationalPage
    ? [{
        '@type': 'ItemList',
        '@id': `${routeUrl}#codelist`,
        name: `${operationalPage.game.name} codes`,
        description: `Every ${operationalPage.game.name} code on record, published and expired, with the state of each.`,
        url: routeUrl,
        numberOfItems: codeEntries.length,
        itemListOrder: 'https://schema.org/ItemListUnordered',
        itemListElement: codeEntries.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: {
            '@type': 'Thing',
            name: item.entry.code,
            description: `${item.entry.reward} — ${spokenStateLabel(item.state)}`,
          },
        })),
        isPartOf: { '@id': websiteId },
      }]
    : []),
  /*
   * The profile page is about the person, so the Person node is minted where
   * the reader can see the standing behind it. The same node, under the same
   * id, travels with every byline that references it (src/data/authors.ts).
   */
  ...(profileAuthor ? [authorPerson(profileAuthor, Astro.site)] : []),
  ...(codePageFaq.length > 0
    ? [{
        '@type': 'FAQPage',
        '@id': `${routeUrl}#faq`,
        mainEntity: codePageFaq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }]
    : []),
];
---

{article ? (
  <EditorialArticle article={article} />
) : (
<BaseLayout
  title={definition.title}
  description={definition.description}
  noindex={definition.noindex ?? false}
  checkerStatus={operations.services.checker.enabled ? checkerSnapshot?.state ?? 'Degraded' : 'Unconfigured'}
  canonical={definition.canonical ?? true}
  image={routeArtwork?.socialImage}
  imageAlt={routeArtwork?.alt}
  webPage={webPageProperties}
  schemaNodes={routeSchemaNodes}
>
  <article class="route-page" data-route-kind={definition.kind}>
    <header class="page-head content-boundary">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {crumbs.map(([label, href]) => <a href={href}>{label}</a>)}
        <span aria-current="page">{definition.heading}</span>
      </nav>
      {definition.eyebrow && <p class="eyebrow">{definition.eyebrow}</p>}
      <h1>{definition.heading}</h1>
      <p class="lede">{definition.description}</p>
      {showHeaderArtwork && routeArtwork && (
        <div class="entity-art">
          <Picture
            src={routeArtwork.src}
            alt={routeArtwork.alt}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[480, 768, 1080, 1440, 1536]}
            sizes="(max-width: 767px) calc(100vw - (2 * var(--page-gutter))), min(100vw - (2 * var(--page-gutter)), 1672px)"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}
      {isGamePage && gameTabs.length > 0 && (
        <nav class="game-tabs" aria-label={`${game?.name} sections`}>
          {gameTabs.map((tab) => (
            <a href={tab.href} aria-current={tab.id === currentTabId ? 'page' : undefined}>{tab.label}</a>
          ))}
        </nav>
      )}
      {stats.length > 0 && (
        <div class="stats">
          {stats.map(([label, value]) => <div><span>{label}</span><strong>{value}</strong></div>)}
        </div>
      )}
    </header>

    {hubIntro && (
      <section class="page-section content-boundary hub-intro">
        <p class="hub-summary">{hubIntro.summary}</p>
        {hubIntro.paragraphs.map((copy) => <p>{copy}</p>)}
        <div class="hub-criteria">
          {hubIntro.criteria.map((item) => (
            <div><h2>{item.heading}</h2><p>{item.body}</p></div>
          ))}
        </div>
      </section>
    )}

    {definition.kind === 'browse' && (
      <section class="page-section content-boundary">
        <div class="section-title">
          <h2>Published Codes</h2>
          <span>{publishedGameCatalogue.length} games</span>
        </div>
        {publishedGameCatalogue.length > 0 ? <div class="card-grid code-card-grid">
          {publishedGameCatalogue.map((item) => (
            <a class="media-card" href={`/codes/${item.slug}/`}>
              <div class="media">
                <Picture
                  src={requireArtwork(gameArtwork, item.slug, 'game').src}
                  alt={requireArtwork(gameArtwork, item.slug, 'game').alt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[320, 528, 792, 1056]}
                  sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 50vw, 25vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="card-copy"><h3>{item.name}</h3><p>{item.liveCount} listed · {item.checkedLabel}</p></div>
            </a>
          ))}
        </div> : <div class="data-empty"><strong>No code page is published yet</strong><p>The route structure is configured, and a page appears here as soon as it lists a code with a source.</p></div>}
        {plannedGameCatalogue.length > 0 && (
          <div class="verification-queue">
            <h2>Pages waiting on data</h2>
            <p>{plannedGameCatalogue.length} configured game pages have no code listed yet. A page joins this list and the search index the moment its first code is recorded; nothing waits on an editor.</p>
          </div>
        )}
      </section>
    )}

    {definition.kind === 'az' && (
      <section class="page-section content-boundary">
        <div class="section-title"><h2>Published game pages</h2><span>{publishedGameCatalogue.length + publishedDailyLinkCatalogue.length} games</span></div>
        {publishedGameCatalogue.length + publishedDailyLinkCatalogue.length > 0 ? <div class="catalogue columns">
          {[...publishedGameCatalogue, ...publishedDailyLinkCatalogue].sort((left, right) => left.name.localeCompare(right.name)).map((item) => (
            <a href={item.platform === 'Mobile' ? `/daily/${item.slug}/` : `/codes/${item.slug}/`}><span>{item.name}</span><strong>{item.liveCount} listed</strong><time>{item.checkedLabel}</time></a>
          ))}
        </div> : <div class="data-empty"><strong>No operational game page is published yet</strong><p>A configured page joins this index as soon as it lists an entry with a source.</p></div>}
      </section>
    )}

    {definition.kind === 'daily' && (
      <section class="page-section content-boundary">
        <h2>Published daily-link games</h2>
        {publishedDailyLinkCatalogue.length > 0 ? <div class="card-grid">
          {publishedDailyLinkCatalogue.map((item) => {
            const art = requireArtwork(dailyArtwork, item.slug, 'daily reward');
            return (
              <a class="media-card" href={`/daily/${item.slug}/`}>
                <div class="media">
                  <Picture
                    src={art.src}
                    alt={art.alt}
                    formats={['avif']}
                    fallbackFormat="webp"
                    widths={[320, 528, 792, 1056]}
                    sizes="(max-width: 767px) calc(100vw - (2 * var(--page-gutter))), (max-width: 1199px) 50vw, 33vw"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="card-copy"><h3>{item.name}</h3><p>{item.liveCount} listed links · {item.checkedLabel}</p></div>
              </a>
            );
          })}
        </div> : <div class="data-empty"><strong>No individual reward link is published right now</strong><p>Reward links rotate within a day or two, so none appears until it has a destination and a source on record. The published daily guides below explain how each game reward system works and where its publisher posts, which stays useful between rotations.</p></div>}
        {hubArticles.length > 0 && (
          <div class="published-articles">
            <h2>{publishedHeading}</h2>
            <div class="card-grid article-card-grid">
            {hubArticles.map((item) => (
              <a class="media-card" href={item.path}>
                <div class="media">
                  <Picture
                    src={requireArticleArtwork(item.routeId).src}
                    alt={requireArticleArtwork(item.routeId).alt}
                    formats={['avif']}
                    fallbackFormat="webp"
                    widths={[320, 528, 792, 1056]}
                    sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 50vw, 33vw"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="card-copy"><h3>{item.heading}</h3><p>{item.description}</p></div>
              </a>
            ))}
            </div>
          </div>
        )}
      </section>
    )}

    {definition.kind === 'dailyGame' && (
      <section class="page-section content-boundary split-layout">
        <div>
          <h2>Published links</h2>
          {dailyEntries.filter((item) => isLiveState(item.state)).length > 0 ? <div class="daily-records">
            {dailyEntries.filter((item) => isLiveState(item.state)).map((item) => (
              <div class="daily-record">
                <a href={item.entry.url} rel="nofollow noopener">
                  <span>{item.entry.label}<small>{entryStateLabels[item.state]}</small></span>
                  {item.latestEvent && <time datetime={item.latestEvent.checkedAt}>{formatAbsoluteTimestamp(item.latestEvent.checkedAt)}</time>}
                </a>
                <span class="record-sources"><EntrySource entry={item.entry} /></span>
              </div>
            ))}
          </div> : <div class="data-empty"><strong>No reward link is published</strong><p>This page is configured, and it lists a claim link as soon as one is recorded with its URL and source.</p></div>}
        </div>
        <aside><h2>Claim and verification</h2><p>{operationalPage?.game.redeemSteps.length ? 'Follow the recorded claim steps for this game. Each link shows its state and the date it was recorded.' : 'Claim instructions have not been recorded yet.'}</p>{operationalPage?.game.redeemSteps.map((step, index) => <p><strong>{index + 1}.</strong> {step}</p>)}{operationalPage?.game.officialSourceUrl && <a href={operationalPage.game.officialSourceUrl} rel="noopener">Open the game</a>}{(operationalPage?.game.publisherChannels ?? []).map((channel) => <a href={channel.url} rel="noopener">{channel.label}</a>)}<a href="/daily/">All daily link games</a></aside>
      </section>
    )}

    {definition.kind === 'codes' && (
      <section class="page-section content-boundary split-layout wide-main">
        <div>
          <div class="section-title"><h2>Published codes</h2><span>{liveCodeEntries.length} records</span></div>
          <p class="visually-hidden" aria-live="polite" data-copy-live></p>
          {liveCodeEntries.length > 0 ? <div class="code-table" aria-label={`Published ${game?.name} codes`}>
            {liveCodeEntries.map((item) => (
              <div class="code-row">
                <div><code>{item.entry.code}</code><span>{item.entry.reward}</span><small>{entryStateLabels[item.state]}</small></div>
                <div>
                  {item.latestEvent && <time datetime={item.latestEvent.checkedAt}>{formatAbsoluteTimestamp(item.latestEvent.checkedAt)}</time>}
                  <span class="record-sources"><EntrySource entry={item.entry} /></span>
                  <button type="button" data-copy-code={item.entry.code}>Copy</button>
                  {readerReportsEnabled && (
                    <span class="code-reports" data-code-report={item.entry.id}>
                      <button type="button" class="thumb up" data-report-verdict="worked" aria-label={`Report that ${item.entry.code} worked`}>
                        <svg viewBox="0 0 16 16" aria-hidden="true" width="13" height="13"><path fill="currentColor" d="M6.2 14H4V6.6h2.2L9.4 2c.8 0 1.4.7 1.3 1.5l-.4 2.4h3.1c.9 0 1.5.8 1.3 1.6l-1.1 5A1.4 1.4 0 0 1 12.2 14H6.2ZM1 6.6h1.8V14H1a.6.6 0 0 1-.6-.6V7.2A.6.6 0 0 1 1 6.6Z"/></svg>
                      </button>
                      <button type="button" class="thumb down" data-report-verdict="failed" aria-label={`Report that ${item.entry.code} did not work`}>
                        <svg viewBox="0 0 16 16" aria-hidden="true" width="13" height="13"><path fill="currentColor" d="M9.8 2H12v7.4H9.8L6.6 14c-.8 0-1.4-.7-1.3-1.5l.4-2.4H2.6a1.4 1.4 0 0 1-1.3-1.6l1.1-5A1.4 1.4 0 0 1 3.8 2h6ZM15 9.4h-1.8V2H15c.3 0 .6.3.6.6v6.2a.6.6 0 0 1-.6.6Z"/></svg>
                      </button>
                      <span class="report-status" data-report-status aria-live="polite"></span>
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div> : <div class="data-empty"><strong>No code is published</strong><p>A single listed code brings this page into the index. None has been recorded for it yet.</p></div>}
          {readerReportsEnabled && <p class="report-note">Thumbs are reader reports, not verification. They are de-duplicated per address for the day, which stops repeat clicks but cannot separate people sharing a network. A code collecting failure reports is moved up the re-check queue; it is never relabelled by vote. See <a href="/how-we-verify/">how we verify</a>.</p>}
          {expiredCodeEntries.length > 0 && <><details class="expired-block"><summary><span class="subhead">Expired codes</span><span>{expiredCodeEntries.length} retired records</span></summary><p class="expired-note">Kept as a maintenance record so a code that stops working can be told apart from one that never existed. Retired codes are not a search destination and carry no claim of being usable.</p><div class="expired-list">
            {expiredCodeEntries.map((item) => <div><s>{item.entry.code}</s><span>{item.entry.reward}</span>{item.latestEvent && <time datetime={item.latestEvent.checkedAt}>{formatAbsoluteTimestamp(item.latestEvent.checkedAt)}</time>}</div>)}
          </div></details></>}
        </div>
        <aside><h2>Redeem and verify</h2><p>{operationalPage?.game.redeemSteps.length ? 'Follow the recorded redemption path. A code an editor has verified carries a star. Every other code is listed, awaiting editor verification, with its source line distinguishing publisher-confirmed from community-reported. Expired codes stay in the archive below.' : 'Redemption instructions have not been recorded yet.'}</p>{operationalPage?.game.redeemSteps.map((step, index) => <p><strong>{index + 1}.</strong> {step}</p>)}{operationalPage?.game.officialSourceUrl && <a href={operationalPage.game.officialSourceUrl} rel="noopener">Open the game</a>}{(operationalPage?.game.publisherChannels ?? []).map((channel) => <a href={channel.url} rel="noopener">{channel.label}</a>)}<a href="/how-we-verify/">How we verify</a></aside>
      </section>
    )}

    {definition.kind === 'codes' && CodeCopy && (
      <section class="page-section content-boundary route-editorial">
        <CodeCopy />
      </section>
    )}

    {definition.kind === 'cheats' && (
      <section class="page-section content-boundary">
        <h2>{publishedHeading}</h2>
        <div class="card-grid article-card-grid">
          {hubArticles.map((item) => (
            <a class="media-card" href={item.path}>
              <div class="media">
                <Picture
                  src={requireArticleArtwork(item.routeId).src}
                  alt={requireArticleArtwork(item.routeId).alt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[320, 528, 792, 1056]}
                  sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 50vw, 33vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="card-copy"><h3>{item.heading}</h3><p>{item.description}</p></div>
            </a>
          ))}
        </div>
        {publishedCheatGames.length > 0 && <><h2 class="secondary-list-heading">More cheat pages</h2>
        <div class="catalogue">{publishedCheatGames.map(({ item, page }) => (
          <a href={`/cheats/${item.slug}/`}><span>{item.name}<small>{item.platforms.join(', ')}</small></span><strong>{page.liveCount} listed</strong></a>
        ))}</div></>}
      </section>
    )}

    {definition.kind === 'cheat' && (
      <section class="page-section content-boundary split-layout wide-main">
        <div><h2>Published cheats</h2>{cheatPage?.entries.length ? <div class="code-table">{cheatPage.entries.map((item) => <div class="code-row"><div><strong>{item.entry.name}</strong><code>{item.entry.input}</code><small>{item.entry.platforms.join(', ')} · {entryStateLabels[item.state]}</small></div><div>{item.latestEvent && <time datetime={item.latestEvent.checkedAt}>{formatAbsoluteTimestamp(item.latestEvent.checkedAt)}</time>}<span class="record-sources">{item.entry.sourceUrls.map((url, index) => <a href={url} rel="noopener">Source {index + 1}</a>)}</span><button type="button" data-copy-code={item.entry.input}>Copy</button></div></div>)}</div> : <div class="data-empty"><strong>No cheat record is published</strong><p>The route remains configured, and rows appear as soon as a cheat is recorded with its platform scope and sources.</p></div>}</div>
        <aside><h2>Confirmed build</h2><p>{cheatPage?.game.confirmedBuild ?? 'No build has been confirmed for publication.'}</p><p>{cheatPage?.game.sourceUrls.length ? 'The sheet has game-level source records in addition to the source on every row.' : 'Game-level sources are still pending.'}</p><a href="/cheats/">All cheat games</a></aside>
      </section>
    )}

    {definition.kind === 'author' && profileAuthor && (
      <section class="page-section content-boundary">
        <div class="profile-detail">
          <div>
            <h2>What {profileAuthor.name} is accountable for</h2>
            <p>{profileAuthor.remit}</p>

            <h2 class="subhead">Verification record</h2>
            <p>{profileAuthorEvents > 0
              ? `${profileAuthorEvents} editor events are recorded under this name, each with a method and a date. The number is counted from the event log rather than entered as biography copy, so it cannot be inflated by editing this page.`
              : 'No editor events are recorded under this name yet. Rows no editor has tested are listed as awaiting editor verification.'}</p>
            <p>Every editor event recorded under this name carries a timestamp, a method and a result. The rules those events follow are set out in <a href="/how-we-verify/">how we verify</a>.</p>

            {profileArticles.length > 0 && <>
              <h2 class="subhead">Published pages by {profileAuthor.name}</h2>
              <div class="author-articles">
                {profileArticles.map((item) => (
                  <a href={item.path}><span>{item.heading}<small>{item.reviewLabel}</small></span></a>
                ))}
              </div>
            </>}

            <h2 class="subhead">Corrections</h2>
            <p>If a page in this section is wrong, email <a href={`mailto:${contactEmail}`}>{contactEmail}</a> with the page URL. Corrections to {profileAuthor.sections.join(', ')} content route to {profileAuthor.name} and are recorded as dated events in the page's history.</p>
          </div>
          <aside>
            <h2>Editorial team</h2>
            {authors.map((member) => (
              <p>
                {member.slug === profileAuthor.slug
                  ? <strong>{member.name}</strong>
                  : <a href={member.path}>{member.name}</a>}
                <br /><small>{member.role}</small>
              </p>
            ))}
            <a href="/about/">About Freetins</a>
          </aside>
        </div>
      </section>
