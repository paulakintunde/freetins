---
/*
 * Renderer for the dataset-backed collections.
 *
 * The body arrives already interpolated from the collection loader, so tables
 * and counts in the HTML are the dataset's, not the writer's. This component
 * supplies the frame: breadcrumbs, byline, jump navigation, FAQ, sources and
 * structured data whose dateModified comes from the dataset rather than the
 * build clock.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PreferredSource from '../ui/PreferredSource.astro';
/*
 * The article shell, shared with the editorial renderer. It lives in a
 * stylesheet rather than a scoped block here because a scoped block only ever
 * styles its own component: these class names are also EditorialArticle's, and
 * both renderers have to resolve to the same page furniture.
 */
import '../../styles/article.css';
import { articleArtwork } from '../../data/article-images';
import { dailyArtwork } from '../../data/site-images';
import { authorPerson, authorPersonId, getSectionAuthor } from '../../data/authors';
import { defaultSocialImage, organizationId } from '../../data/site';
import type { Dataset, DatasetCounts } from '../../lib/dataset';
import { DERIVED_CADENCE } from '../../lib/interpolate';
import { datasetMetaDescription } from '../../lib/metaDescription';
import { canonicalUrl, webPageId } from '../../lib/pageGraph';
import { fitTitle } from '../../lib/pageTitle';
import { splitAtArtAnchor } from '../../lib/articleArtSlot';
import ArticleArt from '../ArticleArt.astro';
import AdSlot from '../ui/AdSlot.astro';

interface EntryData {
  title: string;
  slug: string;
  permalink: string;
  category: string;
  categorySlug: string;
  focusKeyword: string;
  secondaryKeywords: string[];
  author: string;
  description?: string;
  featuredImage?: string;
  faq: { q: string; a: string }[];
  section: 'guides' | 'daily' | 'blog';
  dataset: Dataset;
  counts: DatasetCounts;
}

interface Props {
  entry: { id: string; data: EntryData };
}

const { entry } = Astro.props;
const { data } = entry;
const { dataset } = data;
const nofollowOfficialSources = data.permalink === '/daily/dice-dreams/';

/*
 * The writer's answer-first line, or the unverified summary cut to snippet
 * length. Bound raw, the summary put up to 870 characters of caveats in the
 * description tag and the search result opened on "Nothing on this page is
 * publisher confirmed".
 */
const metaDescription = datasetMetaDescription({
  description: data.description,
  unverifiedSummary: dataset.unverifiedSummary,
  title: data.title,
});

/*
 * The page's own headline, not the dataset subject. A subject names the thing
 * the dataset is about, so every page about one game carries the same one: the
 * three Steal a Brainrot pages each published <h1>Steal a Brainrot</h1> while
 * their titles already said which of the three you were reading. The
 * front-matter title is the headline, capped at 65 characters by
 * scripts/check-content, and the subject keeps the breadcrumb, where repeating
 * across sibling pages is the point.
 */
const headline = data.title;

/*
 * The brand suffix every other template carries. It was missing here alone, so
 * the dataset pages were the only results on the site that did not say who
 * published them.
 *
 * Appended by the renderer rather than typed by the writer, because a writer
 * cannot budget for eleven characters they never see, and because a suffix
 * typed twelve times is a suffix that will eventually be typed wrong. `fitTitle`
 * drops it again on a headline with no room, which is the honest outcome: the
 * writer's own words win the space, and scripts/check-content.mjs names the
 * pages that lost the suffix so they can be trimmed on their next edit.
 */
const documentTitle = fitTitle({ stem: data.title });

const { Content, headings } = await render(entry as never);

const jumpHeadings = headings.filter((heading) => heading.depth === 2);

const author = getSectionAuthor(data.section);
const artwork = articleArtwork[data.slug]
  ?? (data.section === 'daily' ? dailyArtwork[data.slug] : undefined);

/*
 * The loader stores the interpolated body's rendered HTML alongside the entry
 * (src/lib/datasetCollection.ts), which is what makes it possible to place the
 * artwork inside the body rather than around it. The markdown here is plain -
 * no imports, no components - so re-emitting it with `set:html` renders the
 * same DOM the `<Content />` component would.
 *
 * If that HTML is ever missing, `artSplit` is null, `<Content />` renders whole
 * and the artwork falls to the end of the body. That is the pre-existing
 * behaviour, so the page degrades to correct rather than to broken.
 */
const renderedHtml = (entry as { rendered?: { html?: string } }).rendered?.html ?? '';
const artSplit = artwork ? splitAtArtAnchor(renderedHtml) : null;

const sectionLabels = { guides: 'Guides', daily: 'Daily links', blog: 'Blog' };
const sectionPaths = { guides: '/guides/', daily: '/daily/', blog: '/blog/' };

const crumbs = [
  { label: 'Home', href: '/' },
  { label: sectionLabels[data.section], href: sectionPaths[data.section] },
  { label: dataset.subject, href: data.permalink },
];

const absoluteUrl = canonicalUrl(data.permalink, Astro.site).toString();
const entityId = `${absoluteUrl}#article`;

/*
 * The earliest recorded change is the publication date and the dataset's own
 * content_changed_at is the modification date, so a redeploy with no recheck
 * cannot roll either of them forward. A page written after the ledger types
 * neither: its rows' own dates stand in, and a page with no date at all
 * omits the claim rather than making one up.
 */
const rowDates = dataset.rows
  .flatMap((row) => [row.addedAt, row.lastVerifiedAt])
  .filter((value): value is string => Boolean(value))
  .sort();
const publishedAt = dataset.changes.length
  ? [...dataset.changes].map((change) => change.at).sort()[0] ?? ''
  : rowDates[0] ?? '';
const modifiedAt = dataset.contentChangedAt || rowDates.at(-1) || publishedAt;

const reviewFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
// The date a pre-ledger page typed is its as-published baseline and stays on
// screen; a page with none says what is true of it (docs/adr/0004).
const baselineLine = dataset.checkedAt
  ? `Last verified ${reviewFormatter.format(Date.parse(dataset.checkedAt))}`
  : 'Awaiting editor verification';

/*
 * The WebPage node is BaseLayout's, one per page. This template knows two
 * things about it that the layout cannot: the trail the page sits at the end
 * of, and the Article the page exists to carry. It adds those and declares no
 * page node of its own (src/lib/pageGraph.ts).
 */
const webPageProperties = {
  breadcrumb: { '@id': `${absoluteUrl}#breadcrumb` },
  mainEntity: { '@id': entityId },
};

const schemaNodes = [
  {
    '@type': 'Article',
    '@id': entityId,
    headline: dataset.subject,
    description: data.description ?? data.title,
    url: absoluteUrl,
    /*
     * Never omitted. A page with no artwork of its own still advertises the
     * site default in its own og:image, so leaving `image` out of the graph
     * described the page one way to a social crawler and another way to a
     * search one. Both now name the picture the page actually shows.
     */
    image: new URL(artwork?.socialImage ?? defaultSocialImage, Astro.site).toString(),
    ...(publishedAt && { datePublished: publishedAt }),
    ...(modifiedAt && { dateModified: modifiedAt }),
    author: { '@id': authorPersonId(author, Astro.site) },
    publisher: { '@id': organizationId },
    mainEntityOfPage: { '@id': webPageId(absoluteUrl) },
  },
  // The byline's own node, carried by every page that references it.
  authorPerson(author, Astro.site),
  {
    '@type': 'BreadcrumbList',
    '@id': `${absoluteUrl}#breadcrumb`,
    itemListElement: crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.label,
      item: new URL(crumb.href, Astro.site).toString(),
    })),
  },
  ...(data.faq.length
    ? [{
        '@type': 'FAQPage',
        '@id': `${absoluteUrl}#faq`,
        mainEntity: data.faq.map((pair) => ({
          '@type': 'Question',
          name: pair.q,
          acceptedAnswer: { '@type': 'Answer', text: pair.a },
        })),
      }]
    : []),
];
---

<BaseLayout
  title={documentTitle}
  description={metaDescription}
  image={artwork?.socialImage}
  imageAlt={artwork?.alt}
  webPage={webPageProperties}
  schemaNodes={schemaNodes}
>
  <article class="editorial-article">
    <header class="article-head content-boundary">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {crumbs.slice(0, -1).map((crumb) => <a href={crumb.href}>{crumb.label}</a>)}
        <span aria-current="page">{crumbs.at(-1)?.label}</span>
      </nav>
      <p class="eyebrow">{data.category}</p>
      <h1>{headline}</h1>
      <div class="article-meta">
        <span>{baselineLine}</span>
        <span class="byline">
          By <a href={author.path}>{author.name}</a>
          <span class="byline-role">{author.role}</span>
          <span class="byline-bio">{author.credential}</span>
        </span>
      </div>
    </header>

    <div class="article-reading-surface">
      <div class="article-layout content-boundary">
        <nav class="jump-nav" aria-label="On this page">
          <strong>On this page</strong>
          {jumpHeadings.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
          {data.faq.length > 0 && <a href="#frequently-asked-questions">Frequently asked questions</a>}
          <a href="#sources">Sources</a>
        </nav>

        <div class="article-body">
          {/*
           * The artwork sits one heading into the prose: above the second `<h2>`,
           * or the third when the first section is short (src/lib/articleArtSlot.ts).
           * In the page header it rendered 1198x798 against 839px of usable desktop
           * viewport, which put the byline 314px below the fold and the first line
           * of prose 509px below it - a reader saw a headline and a picture, and
           * neither the author nor the answer.
           */}
          {artSplit ? (
            <div class="markdown-body">
              <Fragment set:html={artSplit.before} />
              <ArticleArt art={artwork} />
              <Fragment set:html={artSplit.after} />
            </div>
          ) : (
            <>
              <div class="markdown-body"><Content /></div>
              {/* Fewer than two headings to anchor to: the artwork closes the body. */}
              <ArticleArt art={artwork} />
            </>
          )}

          {/*
           * The in-article block, below the prose and above the questions. It is
           * deliberately not at the top of the body: the artwork above already
           * argues that a reader who lands here should meet the byline and the
           * answer before anything else, and an ad in front of them would undo
           * that for the sake of one impression.
           */}
          <AdSlot placement="article-mid" />

          {data.faq.length > 0 && (
            <section id="frequently-asked-questions" class="article-section">
              <h2>Frequently asked questions</h2>
              {data.faq.map((pair) => (
                <div class="faq-item">
                  <h3>{pair.q}</h3>
                  <p>{pair.a}</p>
                </div>
              ))}
            </section>
          )}

          <section id="sources" class="article-section">
            <h2>Sources</h2>
            <p>
              Sources the writer listed for this page; each row's evidence line
              shows what backs it. {DERIVED_CADENCE}
            </p>
            <div class="link-directory">
              {dataset.officialSources.map((source) => (
                <a
                  href={source.url}
                  target="_blank"
                  rel={nofollowOfficialSources ? 'nofollow noopener noreferrer' : 'noopener noreferrer'}
                >
                  <strong>{source.note ?? source.type}</strong>
                  <span>Official channel</span>
                </a>
              ))}
            </div>
          </section>

          <AdSlot placement="article-end" />

          <PreferredSource />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
