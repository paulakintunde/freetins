---
import { Picture } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { articleArtwork } from '../../data/article-images';
import type { EditorialArticle as EditorialArticleData, ArticleLink } from '../../data/articles';
import BaseLayout from '../../layouts/BaseLayout.astro';
/*
 * The article shell, shared with the dataset renderer. It lives in a
 * stylesheet rather than a scoped block because a scoped block only ever
 * styles its own component, and these class names belong to both renderers.
 */
import '../../styles/article.css';
import { getSectionAuthor } from '../../data/authors';
import { gamePageForArticle, siblingArticlesFor } from '../../data/interlinks';
import { organizationId } from '../../data/site';

interface Props {
  article: EditorialArticleData;
}

const { article } = Astro.props;
const contentEntry = article.contentSlug
  ? (await getCollection('articles')).find((entry) => entry.id === article.contentSlug)
  : undefined;
if (article.contentSlug && !contentEntry) {
  throw new Error(`Missing Markdown article body for: ${article.contentSlug}`);
}
const renderedContent = contentEntry ? await render(contentEntry) : null;
const Content = renderedContent?.Content;
const markdownHeadings = (renderedContent?.headings ?? []).filter((heading) => heading.depth === 2);
// The byline follows the section, so a page cannot ship crediting the wrong desk.
const author = getSectionAuthor(article.section);
/*
 * Curated links first, then the game page this article covers, then other pages
 * in the same section. siblingArticlesFor skips anything already linked above.
 */
const relatedLinks = [
  ...article.related,
  ...gamePageForArticle(article),
  ...siblingArticlesFor(article),
];
const articleArt = articleArtwork[article.routeId];
const sectionLabels = {
  answers: 'Answers',
  guides: 'Guides',
  resources: 'Resources',
  cheats: 'Cheats',
  daily: 'Daily links',
  blog: 'Blog',
  legal: 'Legal',
  about: 'About',
};
const sectionPaths = {
  answers: '/answers/',
  guides: '/guides/',
  resources: '/resources/',
  cheats: '/cheats/',
  daily: '/daily/',
  blog: '/blog/',
  legal: '/about/',
  about: '/about/',
};
const sectionLabel = sectionLabels[article.section];
const sectionPath = sectionPaths[article.section];
const crumbs = article.section === 'resources' || article.section === 'legal' || article.section === 'about'
  ? [{ label: 'Home', href: '/' }, { label: sectionLabel, href: article.path }]
  : [
      { label: 'Home', href: '/' },
      { label: sectionLabel, href: sectionPath },
      { label: article.heading, href: article.path },
    ];
const absoluteUrl = new URL(article.path, Astro.site).toString();
const articleType = article.schemaType ?? (article.section === 'resources' ? 'CollectionPage' : 'Article');
const isWebPage = articleType === 'WebPage';
const entityId = `${absoluteUrl}${isWebPage ? '#webpage' : '#article'}`;
const elementSlug = (name: string) => name.toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');
const elementLetter = (name: string) => name.charAt(0).toUpperCase();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': articleType,
      '@id': entityId,
      ...(isWebPage ? { name: article.heading } : { headline: article.heading }),
      description: article.description,
      url: absoluteUrl,
      ...(articleArt && { image: new URL(articleArt.socialImage, Astro.site).toString() }),
      datePublished: article.publishedAt,
      dateModified: article.reviewedAt,
      author: {
        '@type': 'Person',
        name: author.name,
        url: new URL(author.path, Astro.site).toString(),
        jobTitle: author.role,
        description: author.credential,
      },
      publisher: { '@id': organizationId },
      ...(!isWebPage && { mainEntityOfPage: { '@id': `${absoluteUrl}#webpage` } }),
    },
    ...(!isWebPage
      ? [{
          '@type': 'WebPage',
          '@id': `${absoluteUrl}#webpage`,
          url: absoluteUrl,
          name: article.heading,
          description: article.description,
          breadcrumb: { '@id': `${absoluteUrl}#breadcrumb` },
          mainEntity: { '@id': entityId },
        }]
      : []),
    {
      '@type': 'BreadcrumbList',
      '@id': `${absoluteUrl}#breadcrumb`,
      itemListElement: crumbs.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.label,
        item: new URL(crumb.href, Astro.site).toString(),
      })),
    },
    ...(article.faq?.length
      ? [{
          '@type': 'FAQPage',
          '@id': `${absoluteUrl}#faq`,
          mainEntity: article.faq.map((item) => ({
            '@type': 'Question',
            name: item.question,
            acceptedAnswer: { '@type': 'Answer', text: item.answer },
          })),
        }]
      : []),
  ],
};

const linkAttributes = (link: ArticleLink) => link.href.startsWith('http')
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<BaseLayout
  title={article.title}
  description={article.description}
  image={articleArt?.socialImage}
  imageAlt={articleArt?.alt}
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

  <article class="editorial-article">
    <header class="article-head content-boundary">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {crumbs.slice(0, -1).map((crumb) => <a href={crumb.href}>{crumb.label}</a>)}
        <span aria-current="page">{crumbs.at(-1)?.label}</span>
      </nav>
      <p class="eyebrow">{article.eyebrow}</p>
      <h1>{article.heading}</h1>
      <p class="lede">{article.description}</p>
      {articleArt && (
        <div class="article-art">
          <Picture
            src={articleArt.src}
            alt={articleArt.alt}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[480, 768, 1080, 1440, 1536]}
            sizes="(max-width: 767px) calc(100vw - 40px), min(100vw - (2 * var(--page-gutter)), 1200px)"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}
      <div class="article-meta">
        <span>{article.reviewLabel}</span>
        <span class="byline">
          By <a href={author.path}>{author.name}</a>
          <span class="byline-role">{author.role}</span>
          <span class="byline-bio">{author.credential}</span>
        </span>
      </div>
    </header>

    <div class="article-reading-surface">
      <div class="quick-answer content-boundary">
        <strong>What to know</strong>
        <p>{article.quickAnswer}</p>
      </div>

      <div class="article-layout content-boundary">
      <nav class="jump-nav" aria-label="On this page">
        <strong>On this page</strong>
        {Content
          ? markdownHeadings.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)
          : article.sections.map((section) => <a href={`#${section.id}`}>{section.heading}</a>)}
        {Boolean(article.faq?.length) && <a href="#frequently-asked-questions">Frequently asked questions</a>}
        {article.sources.length > 0 && <a href="#sources">Sources</a>}
      </nav>

      <div class="article-body">
        {Content ? (
          <div class="markdown-body"><Content /></div>
        ) : article.sections.map((section) => (
          <section id={section.id} class="article-section">
            <h2>{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}

            {section.groups && (
              <div class="answer-groups">
                {section.groups.map((group) => (
                  <div>
                    <h3>{group.heading}</h3>
                    <p>{group.body}</p>
                  </div>
                ))}
              </div>
            )}

            {section.table && (
              <div class="table-scroll" tabindex="0" role="region" aria-label={section.table.caption}>
                <table>
                  <caption>{section.table.caption}</caption>
                  <thead>
                    <tr>{section.table.columns.map((column) => <th scope="col">{column}</th>)}</tr>
                  </thead>
                  <tbody>
                    {section.table.rows.map((row) => (
                      <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {section.steps && <ol class="steps">{section.steps.map((step) => <li>{step}</li>)}</ol>}
            {section.bullets && <ul class="bullets">{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}

            {section.links && (
              <div class="link-directory">
                {section.links.map((link) => (
                  <a href={link.href} {...linkAttributes(link)}>
                    <strong>{link.label}</strong>
                    {link.description && <span>{link.description}</span>}
                  </a>
                ))}
              </div>
            )}

            {section.elementIndex && (
              <div class="element-index" data-element-index>
                <div class="element-tools">
                  <label>
                    <span>Find an element or ingredient</span>
                    <input type="search" placeholder="Try life, metal or rain" data-element-search />
                  </label>
                  <output data-element-count aria-live="polite">{(section.elementIndex ?? []).length} elements</output>
                </div>
                <nav class="alphabet-nav" aria-label="Little Alchemy elements by letter">
                  {[...new Set((section.elementIndex ?? []).map((element) => elementLetter(element.name)))].map((letter) => (
                    <a href={`#elements-${letter.toLowerCase()}`}>{letter}</a>
                  ))}
                </nav>
                <div class="element-groups">
                  {[...new Set((section.elementIndex ?? []).map((element) => elementLetter(element.name)))].map((letter) => (
                    <section id={`elements-${letter.toLowerCase()}`} class="element-letter" data-element-group>
                      <h3>{letter}</h3>
                      <div class="element-grid">
                        {(section.elementIndex ?? [])
                          .filter((element) => elementLetter(element.name) === letter)
                          .map((element) => (
                            <article
                              id={`element-${elementSlug(element.name)}`}
                              class="element-card"
                              data-element-card
                              data-search={`${element.name} ${element.recipes.join(' ')}`.toLowerCase()}
                            >
                              <div class="element-title">
                                <h4><a href={`#element-${elementSlug(element.name)}`}>{element.name}</a></h4>
                              </div>
                              <ul>
                                {element.recipes.map((recipe) => <li>{recipe}</li>)}
                              </ul>
                            </article>
                          ))}
                      </div>
                    </section>
                  ))}
                </div>
                <p class="element-empty" data-element-empty hidden>No matching element or recipe was found.</p>
              </div>
            )}

            {section.note && <aside class="editor-note"><strong>Good to know</strong><p>{section.note}</p></aside>}
          </section>
        ))}

        {article.faq && article.faq.length > 0 && (
          <section id="frequently-asked-questions" class="article-section faq-section">
            <h2>Frequently asked questions</h2>
            {article.faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </section>
        )}

        {article.sources.length > 0 && (
          <section id="sources" class="article-section sources-section">
            <h2>Sources</h2>
            <p>Primary sources are preferred for current availability and product features. Older walkthrough details are labeled and cross-checked where possible.</p>
            <div class="source-list">
              {article.sources.map((source) => (
                <a href={source.href} {...linkAttributes(source)}>
                  <strong>{source.label}</strong>
                  {source.description && <span>{source.description}</span>}
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
      </div>

      {relatedLinks.length > 0 && (
        <section class="related content-boundary" aria-labelledby="related-heading">
          <h2 id="related-heading">Keep going</h2>
          <div class="link-directory">
            {relatedLinks.map((link) => (
              <a href={link.href}>
                <strong>{link.label}</strong>
                {link.description && <span>{link.description}</span>}
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>

</BaseLayout>
