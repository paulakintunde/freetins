---
import { Picture } from 'astro:assets';
import { articleArtwork } from '../../data/article-images';
import type { EditorialArticle as EditorialArticleData, ArticleLink } from '../../data/articles';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSectionAuthor } from '../../data/authors';
import { gamePageForArticle, siblingArticlesFor } from '../../data/interlinks';

interface Props {
  article: EditorialArticleData;
}

const { article } = Astro.props;
// The byline follows the section, so a page cannot ship crediting the wrong desk.
const author = getSectionAuthor(article.section);
/*
 * Curated links first, then the game page this article covers, then other pages
 * in the same section. siblingArticlesFor skips anything already linked above.
 */
const relatedLinks = [
  ...article.related,
  ...gamePageForArticle(article),
  ...siblingArticlesFor(article),
];
const articleArt = articleArtwork[article.routeId];
const sectionLabels = {
  answers: 'Answers',
  guides: 'Guides',
  resources: 'Resources',
  cheats: 'Cheats',
  daily: 'Daily links',
  legal: 'Legal',
  about: 'About',
};
const sectionPaths = {
  answers: '/answers/',
  guides: '/guides/',
  resources: '/resources/',
  cheats: '/cheats/',
  daily: '/daily/',
  legal: '/about/',
  about: '/about/',
};
const sectionLabel = sectionLabels[article.section];
const sectionPath = sectionPaths[article.section];
const crumbs = article.section === 'resources' || article.section === 'legal' || article.section === 'about'
  ? [{ label: 'Home', href: '/' }, { label: sectionLabel, href: article.path }]
  : [
      { label: 'Home', href: '/' },
      { label: sectionLabel, href: sectionPath },
      { label: article.heading, href: article.path },
    ];
const absoluteUrl = new URL(article.path, Astro.site).toString();
const articleType = article.schemaType ?? (article.section === 'resources' ? 'CollectionPage' : 'Article');
const isWebPage = articleType === 'WebPage';
const entityId = `${absoluteUrl}${isWebPage ? '#webpage' : '#article'}`;
const elementSlug = (name: string) => name.toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');
const elementLetter = (name: string) => name.charAt(0).toUpperCase();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': articleType,
      '@id': entityId,
      ...(isWebPage ? { name: article.heading } : { headline: article.heading }),
      description: article.description,
      url: absoluteUrl,
      ...(articleArt && { image: new URL(articleArt.socialImage, Astro.site).toString() }),
      datePublished: article.publishedAt,
      dateModified: article.reviewedAt,
      author: {
        '@type': 'Person',
        name: author.name,
        url: new URL(author.path, Astro.site).toString(),
        jobTitle: author.role,
        description: author.credential,
      },
      publisher: { '@id': 'https://freetins.com/#org' },
      ...(!isWebPage && { mainEntityOfPage: { '@id': `${absoluteUrl}#webpage` } }),
    },
    ...(!isWebPage
      ? [{
          '@type': 'WebPage',
          '@id': `${absoluteUrl}#webpage`,
          url: absoluteUrl,
          name: article.heading,
          description: article.description,
          breadcrumb: { '@id': `${absoluteUrl}#breadcrumb` },
          mainEntity: { '@id': entityId },
        }]
      : []),
    {
      '@type': 'BreadcrumbList',
      '@id': `${absoluteUrl}#breadcrumb`,
      itemListElement: crumbs.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.label,
        item: new URL(crumb.href, Astro.site).toString(),
      })),
    },
    ...(article.faq?.length
      ? [{
          '@type': 'FAQPage',
          '@id': `${absoluteUrl}#faq`,
          mainEntity: article.faq.map((item) => ({
            '@type': 'Question',
            name: item.question,
            acceptedAnswer: { '@type': 'Answer', text: item.answer },
          })),
        }]
      : []),
  ],
};

const linkAttributes = (link: ArticleLink) => link.href.startsWith('http')
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<BaseLayout
  title={article.title}
  description={article.description}
  image={articleArt?.socialImage}
  imageAlt={articleArt?.alt}
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

  <article class="editorial-article">
    <header class="article-head content-boundary">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {crumbs.slice(0, -1).map((crumb) => <a href={crumb.href}>{crumb.label}</a>)}
        <span aria-current="page">{crumbs.at(-1)?.label}</span>
      </nav>
      <p class="eyebrow">{article.eyebrow}</p>
      <h1>{article.heading}</h1>
      <p class="lede">{article.description}</p>
      {articleArt && (
        <div class="article-art">
          <Picture
            src={articleArt.src}
            alt={articleArt.alt}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[480, 768, 1080, 1440, 1536]}
            sizes="(max-width: 767px) calc(100vw - 40px), min(100vw - (2 * var(--page-gutter)), 1200px)"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}
      <div class="article-meta">
        <span>{article.reviewLabel}</span>
        <span class="byline">
          By <a href={author.path}>{author.name}</a>
          <span class="byline-role">{author.role}</span>
          <span class="byline-bio">{author.credential}</span>
        </span>
      </div>
    </header>

    <div class="article-reading-surface">
      <div class="quick-answer content-boundary">
        <strong>What to know</strong>
        <p>{article.quickAnswer}</p>
      </div>

      <div class="article-layout content-boundary">
      <nav class="jump-nav" aria-label="On this page">
        <strong>On this page</strong>
        {article.sections.map((section) => <a href={`#${section.id}`}>{section.heading}</a>)}
        {article.faq?.length && <a href="#frequently-asked-questions">Frequently asked questions</a>}
        {article.sources.length > 0 && <a href="#sources">Sources</a>}
      </nav>

      <div class="article-body">
        {article.sections.map((section) => (
          <section id={section.id} class="article-section">
            <h2>{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}

            {section.groups && (
              <div class="answer-groups">
                {section.groups.map((group) => (
                  <div>
                    <h3>{group.heading}</h3>
                    <p>{group.body}</p>
                  </div>
                ))}
              </div>
            )}

            {section.table && (
              <div class="table-scroll" tabindex="0" role="region" aria-label={section.table.caption}>
                <table>
                  <caption>{section.table.caption}</caption>
                  <thead>
                    <tr>{section.table.columns.map((column) => <th scope="col">{column}</th>)}</tr>
                  </thead>
                  <tbody>
                    {section.table.rows.map((row) => (
                      <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {section.steps && <ol class="steps">{section.steps.map((step) => <li>{step}</li>)}</ol>}
            {section.bullets && <ul class="bullets">{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}

            {section.links && (
              <div class="link-directory">
                {section.links.map((link) => (
                  <a href={link.href} {...linkAttributes(link)}>
                    <strong>{link.label}</strong>
                    {link.description && <span>{link.description}</span>}
                  </a>
                ))}
              </div>
            )}

            {section.elementIndex && (
              <div class="element-index" data-element-index>
                <div class="element-tools">
                  <label>
                    <span>Find an element or ingredient</span>
                    <input type="search" placeholder="Try life, metal or rain" data-element-search />
                  </label>
                  <output data-element-count aria-live="polite">{(section.elementIndex ?? []).length} elements</output>
                </div>
                <nav class="alphabet-nav" aria-label="Little Alchemy elements by letter">
                  {[...new Set((section.elementIndex ?? []).map((element) => elementLetter(element.name)))].map((letter) => (
                    <a href={`#elements-${letter.toLowerCase()}`}>{letter}</a>
                  ))}
                </nav>
                <div class="element-groups">
                  {[...new Set((section.elementIndex ?? []).map((element) => elementLetter(element.name)))].map((letter) => (
                    <section id={`elements-${letter.toLowerCase()}`} class="element-letter" data-element-group>
                      <h3>{letter}</h3>
                      <div class="element-grid">
                        {(section.elementIndex ?? [])
                          .filter((element) => elementLetter(element.name) === letter)
                          .map((element) => (
                            <article
                              id={`element-${elementSlug(element.name)}`}
                              class="element-card"
                              data-element-card
                              data-search={`${element.name} ${element.recipes.join(' ')}`.toLowerCase()}
                            >
                              <div class="element-title">
                                <h4><a href={`#element-${elementSlug(element.name)}`}>{element.name}</a></h4>
                              </div>
                              <ul>
                                {element.recipes.map((recipe) => <li>{recipe}</li>)}
                              </ul>
                            </article>
                          ))}
                      </div>
                    </section>
                  ))}
                </div>
                <p class="element-empty" data-element-empty hidden>No matching element or recipe was found.</p>
              </div>
            )}

            {section.note && <aside class="editor-note"><strong>Good to know</strong><p>{section.note}</p></aside>}
          </section>
        ))}

        {article.faq?.length && (
          <section id="frequently-asked-questions" class="article-section faq-section">
            <h2>Frequently asked questions</h2>
            {article.faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </section>
        )}

        {article.sources.length > 0 && (
          <section id="sources" class="article-section sources-section">
            <h2>Sources</h2>
            <p>Primary sources are preferred for current availability and product features. Older walkthrough details are labeled and cross-checked where possible.</p>
            <div class="source-list">
              {article.sources.map((source) => (
                <a href={source.href} {...linkAttributes(source)}>
                  <strong>{source.label}</strong>
                  {source.description && <span>{source.description}</span>}
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
      </div>

      {relatedLinks.length > 0 && (
        <section class="related content-boundary" aria-labelledby="related-heading">
          <h2 id="related-heading">Keep going</h2>
          <div class="link-directory">
            {relatedLinks.map((link) => (
              <a href={link.href}>
                <strong>{link.label}</strong>
                {link.description && <span>{link.description}</span>}
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>

</BaseLayout>

<style>
  .editorial-article {
    background: var(--surface-page);
  }

  .article-head {
    padding: clamp(28px, 4vw, 56px) var(--page-gutter) clamp(36px, 5vw, 64px);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
    color: var(--text-tertiary);
    font-size: 13px;
  }

  .breadcrumbs a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    color: var(--text-tertiary);
  }

  .breadcrumbs a::after {
    margin-left: 6px;
    color: var(--text-caption);
    content: '/';
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--text-brand);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 24ch;
    margin: 0;
    color: var(--text-primary);
    font: 650 var(--fs-h1) / 1.04 var(--font-display);
    letter-spacing: -.025em;
    text-wrap: balance;
  }

  .lede {
    max-width: 68ch;
    margin: 18px 0 0;
    color: var(--text-secondary);
    font-size: var(--fs-body-lg);
    line-height: 1.55;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 18px;
    color: var(--text-tertiary);
    font-size: 13px;
  }

  .article-meta a {
    color: var(--text-primary);
    font-weight: 600;
  }

  .byline a {
    display: inline-flex;
    min-height: 24px;
    align-items: center;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    max-width: 62ch;
  }

  .byline-role {
    border: 1px solid var(--border-subtle);
    padding: 2px 7px;
    color: var(--text-caption);
    font: 700 var(--fs-caption) / 1.4 var(--font-core);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .byline-bio {
    flex: 1 1 100%;
    color: var(--text-tertiary);
    font-size: 13px;
    line-height: 1.5;
  }

  @media (min-width: 620px) {
    /* Beside the name once there is room; wrapped underneath on narrow screens. */
    .byline-bio {
      flex: 1 1 auto;
      min-width: 24ch;
    }
  }

  .article-art {
    max-width: 1200px;
    margin-top: clamp(26px, 4vw, 44px);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--surface-raised);
    aspect-ratio: 3 / 2;
  }

  .article-art :global(picture),
  .article-art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .article-art :global(img) {
    object-fit: cover;
  }

  .quick-answer {
    padding: 22px var(--page-gutter);
    border-bottom: 1px solid #cfd8d2;
    background: #e9f6ee;
    color: var(--neutral-1000);
  }

  .quick-answer strong {
    display: block;
    margin-bottom: 6px;
    color: var(--green-800);
    font-size: 13px;
  }

  .quick-answer p {
    max-width: 72ch;
    margin: 0;
    line-height: 1.55;
  }

  .article-reading-surface {
    --surface-page: #fff;
    --surface-raised: #f7f9f7;
    --surface-sunken: #f2f5f3;
    --text-primary: #101512;
    --text-secondary: #3d4942;
    --text-tertiary: #657169;
    --text-caption: #5c6760;
    --text-disabled: #879089;
    --border-subtle: #dfe5e1;
    --border-strong: #b9c4bd;
    background: #fff;
    color: #101512;
    color-scheme: light;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(180px, 230px) minmax(0, 780px);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
    padding: clamp(36px, 5vw, 64px) var(--page-gutter) 0;
  }

  .jump-nav {
    position: sticky;
    top: 84px;
    display: grid;
    border-top: 2px solid var(--text-primary);
  }

  .jump-nav strong {
    padding: 14px 0 10px;
    color: var(--text-primary);
    font-size: 13px;
  }

  .jump-nav a {
    padding: 8px 0;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.35;
  }

  .article-body {
    min-width: 0;
  }

  .article-section {
    scroll-margin-top: 90px;
    padding: 0 0 clamp(40px, 6vw, 68px);
  }

  .article-section + .article-section {
    padding-top: clamp(36px, 5vw, 58px);
    border-top: 1px solid var(--border-subtle);
  }

  .article-section h2,
  .related h2 {
    max-width: 28ch;
    margin: 0 0 16px;
    color: var(--text-primary);
    font: 650 var(--fs-h3) / 1.16 var(--font-display);
    letter-spacing: -.015em;
    text-wrap: balance;
  }

  .article-section > p {
    max-width: 68ch;
    margin: 0 0 14px;
    color: var(--text-secondary);
    line-height: 1.72;
  }

  .answer-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 24px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
  }

  .answer-groups > div {
    min-height: 132px;
    padding: 18px;
    background: var(--surface-page);
  }

  .answer-groups h3 {
    margin: 0 0 8px;
    color: var(--text-primary);
    font-size: 16px;
  }

  .answer-groups p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.58;
  }

  .table-scroll {
    max-width: 100%;
    margin-top: 22px;
    overflow-x: auto;
    border: 1px solid var(--border-strong);
  }

  .table-scroll:focus-visible {
    outline: 2px solid var(--green-700);
    outline-offset: 3px;
  }

  table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.5;
  }

  caption {
    padding: 12px 14px;
    color: var(--text-primary);
    font-weight: 700;
    text-align: left;
  }

  thead th {
    position: sticky;
    top: 0;
    background: var(--neutral-50);
    color: var(--text-primary);
    font-size: 12px;
    letter-spacing: .03em;
    text-align: left;
  }

  th,
  td {
    padding: 12px 14px;
    border-top: 1px solid var(--border-subtle);
    vertical-align: top;
  }

  tbody th {
    width: 31%;
    color: var(--text-primary);
    font-weight: 650;
    text-align: left;
  }

  .steps,
  .bullets {
    display: grid;
    gap: 10px;
    margin: 22px 0 0;
    padding-left: 24px;
    color: var(--text-secondary);
    line-height: 1.62;
  }

  .steps li::marker {
    color: var(--green-700);
    font-weight: 700;
  }

  .editor-note {
    margin-top: 22px;
    padding: 16px 18px;
    border: 1px solid var(--border-strong);
    background: var(--neutral-50);
  }

  .editor-note strong {
    color: var(--text-primary);
    font-size: 13px;
  }

  .editor-note p {
    margin: 6px 0 0;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .link-directory {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 22px;
    border: 1px solid var(--border-subtle);
    background: var(--border-subtle);
  }

  .link-directory a {
    display: grid;
    align-content: start;
    min-height: 116px;
    padding: 18px;
    background: var(--surface-page);
    color: var(--text-primary);
    text-decoration: none;
  }

  .link-directory a:hover {
    background: var(--neutral-50);
  }

  .link-directory strong {
    font-size: 16px;
  }

  .link-directory span,
  .source-list span {
    margin-top: 7px;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.5;
  }

  .element-index {
    margin-top: 26px;
  }

  .element-tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: end;
    padding: 18px;
    border: 1px solid var(--border-strong);
    background: var(--surface-raised);
  }

  .element-tools label {
    display: grid;
    gap: 8px;
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 700;
  }

  .element-tools input {
    width: 100%;
    min-height: 46px;
    padding: 10px 13px;
    border: 1px solid var(--border-strong);
    border-radius: 0;
    background: #fff;
    color: var(--text-primary);
    font: inherit;
  }

  .element-tools input:focus-visible {
    outline: 2px solid var(--green-700);
    outline-offset: 2px;
  }

  .element-tools output {
    padding-bottom: 13px;
    color: var(--text-secondary);
    font-size: 13px;
    white-space: nowrap;
  }

  .alphabet-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 16px 0 20px;
  }

  .alphabet-nav a {
    /* 44px is the comfort target, and this is a primary control on the site's
       largest page. Letting the chips flex rather than fixing their width keeps
       the row count down at 360px: they grow to share the row instead of leaving
       a ragged gap, so raising the height costs no extra wrapping. */
    display: grid;
    min-width: 44px;
    height: 44px;
    flex: 1 1 44px;
    place-items: center;
    border: 1px solid var(--border-strong);
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .alphabet-nav a:hover {
    border-color: var(--green-700);
    background: var(--green-100);
  }

  .element-letter {
    scroll-margin-top: 90px;
    padding: 28px 0 8px;
    border-top: 1px solid var(--border-subtle);
  }

  .element-letter > h3 {
    margin: 0 0 14px;
    color: var(--green-800);
    font: 700 24px / 1 var(--font-display);
  }

  .element-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .element-letter {
    content-visibility: auto;
    contain-intrinsic-size: auto 480px;
  }

  .element-card {
    scroll-margin-top: 90px;
    padding: 14px;
    border: 1px solid var(--border-subtle);
    background: #fff;
  }

  .element-title {
    display: flex;
    gap: 9px;
    align-items: center;
  }

  .element-card h4 {
    margin: 0;
    font: 700 15px / 1.25 var(--font-display);
    text-transform: capitalize;
  }

  .element-card h4 a {
    display: inline-flex;
    min-width: 24px;
    min-height: 32px;
    align-items: center;
    color: var(--text-primary);
    text-decoration: none;
  }

  .element-card h4 a:hover {
    color: var(--green-800);
  }

  .element-card ul {
    display: grid;
    gap: 5px;
    margin: 11px 0 0;
    padding: 0;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.4;
    list-style: none;
  }

  .element-card li::before {
    margin-right: 6px;
    color: var(--green-700);
    content: '=';
  }

  .element-card[hidden],
  .element-letter[hidden],
  .element-empty[hidden] {
    display: none;
  }

  .element-empty {
    padding: 24px;
    border: 1px solid var(--border-strong);
    color: var(--text-secondary);
    text-align: center;
  }

  .faq-section details {
