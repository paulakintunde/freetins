---
import { env } from 'cloudflare:workers';
import RouteScreen from '../components/pages/RouteScreen.astro';
import { getRouteDefinition } from '../data/routes';
import { readCheckerSnapshot } from '../lib/checker-status';
import { applyOnDemandHeaders } from '../lib/response-headers';

export const prerender = false;

applyOnDemandHeaders(
  Astro.response.headers,
  'public, max-age=0, s-maxage=30, stale-while-revalidate=300',
);

const definition = getRouteDefinition('/status');
const checkerSnapshot = await readCheckerSnapshot(env.STATUS);
---

<RouteScreen definition={definition} checkerSnapshot={checkerSnapshot} />
