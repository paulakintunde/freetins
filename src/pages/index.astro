---
import { Picture } from 'astro:assets';
import AdSlot from '../components/ui/AdSlot.astro';
import Button from '../components/ui/Button.astro';
import { dailyGames, homeTiles, pulse, publishedGameCatalogue } from '../data/home';
import { homeHeroArtwork, partnerArtwork } from '../data/home-images';
import { getActiveSponsorships } from '../data/operations';
import { gameArtwork } from '../data/site-images';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Freetins - source-backed game codes and guides';
const description = 'Game codes, reward links, cheats, answers and guides, each entry with a clear state, a source record and the date it was recorded.';
const socialImage = '/og/freetins-home-game-codes.jpg';
const activeSponsorships = getActiveSponsorships();

const discoverySections = [
  {
    label: 'Cheats',
    href: '/cheats/',
    copy: 'Cheats cover built-in button sequences, console commands and unlock inputs, with the platform and save-file warnings that matter. Start here when you need an effect inside a game rather than a publisher reward code.',
    links: [
      { label: 'LEGO Jurassic World cheats', href: '/cheats/lego-jurassic-world/' },
      { label: 'GTA 5 cheats', href: '/cheats/gta-5/' },
      { label: 'Guitar Hero 3 cheats', href: '/cheats/guitar-hero-3/' },
    ],
  },
  {
    label: 'Answers',
    href: '/answers/',
    copy: 'Answers help when a puzzle, recipe or level blocks your progress. Each page states its coverage and distinguishes between similar game releases so you can use the right solution.',
    links: [
      { label: 'Little Alchemy element combinations', href: '/answers/little-alchemy/' },
      { label: 'Clear Vision 3 walkthrough', href: '/answers/clear-vision-3/' },
      { label: 'Guess the Emoji levels 1 to 10', href: '/answers/guess-emoji-levels-1-10/' },
    ],
  },
  {
    label: 'Guides',
    href: '/guides/',
    copy: 'Guides explain game systems, availability and setup in plain language. The direct answer comes first, followed by the steps, limits and first-party details that help you act on it.',
    links: [
      { label: 'GTA 5 radio stations guide', href: '/guides/gta-5-radio-stations/' },
      { label: 'Grow a Garden recipes', href: '/guides/grow-a-garden-recipes/' },
      { label: 'Best GBA emulators', href: '/guides/best-gba-emulators/' },
    ],
  },
] as const;

function requireArtwork<T>(artworks: Record<string, T>, name: string): T {
  const artwork = artworks[name];

  if (!artwork) {
    throw new Error(`Missing homepage artwork for ${name}`);
  }

  return artwork;
}
---

<BaseLayout
  title={title}
  description={description}
  image={socialImage}
  imageAlt="Freetins source-backed game codes and reward records"
>
  <section class="hero">
    <div class="hero-art">
      <Picture
        src={homeHeroArtwork.src}
        alt={homeHeroArtwork.alt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[480, 768, 1080, 1440, 1672]}
        sizes="100vw"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-boundary content-boundary">
      <div class="hero-copy">
        <div class="eyebrow">
          <span aria-hidden="true"></span>
          <span>A record behind every claim</span>
        </div>
        <h1>Game codes,<br />sourced and tracked</h1>
        <p>Every code page lists its entries with a source, a state and the date each was recorded. An editor's verification adds a star; nothing waits on it.</p>
        <div class="hero-actions">
          <Button href="/codes/">Find your game</Button>
          <Button href="/how-we-verify/" variant="secondary">How we verify</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section intro-section content-boundary">
    <div class="intro-copy">
      <h2>Publication status</h2>
      <p class="section-intro">Figures come directly from the operational record. Untested codes are clearly marked as awaiting editor verification.</p>
    </div>

    <div class="pulse-grid">
      {pulse.map((item) => (
        <div>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="page-section games-section content-boundary">
    <div class="section-heading">
      <h2>Published code pages</h2>
      <a href="/codes/">{publishedGameCatalogue.length} published games</a>
    </div>

    {homeTiles.length > 0 ? <div class="game-grid">
      {homeTiles.map((tile) => {
        const artwork = requireArtwork(gameArtwork, tile.slug);

        return (
          <a class="game-tile" href={tile.href}>
            <div class="game-media">
              <div class="tile-art">
                <Picture
                  src={artwork.src}
                  alt={artwork.alt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[320, 528, 792, 1056]}
                  sizes="(max-width: 767px) calc(100vw - 48px), (max-width: 1084px) 33vw, 25vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="tile-scrim" aria-hidden="true"></div>
              <div class="verified-label">
                <span aria-hidden="true"></span>
                <strong>{tile.checkedLabel}</strong>
              </div>
            </div>
            <div class="game-copy">
              <h3>{tile.name}</h3>
              <div>
                <span>{tile.verifiedCount} verified</span>
                <span>·</span>
                <span>{tile.listedCount} listed</span>
              </div>
            </div>
          </a>
        );
      })}
    </div> : <div class="data-empty"><strong>No code pages yet</strong><p>A game appears here as soon as its first code is recorded.</p></div>}
  </section>

  {activeSponsorships.length > 0 && (
  <section class="page-section sponsored-section content-boundary" data-ad-slot="FT-SPONSOR-ROW">
    <h2>Sponsorship</h2>
    <div class="sponsored-grid">
      {activeSponsorships.map((entry) => (
          <a class="sponsored-card" href={entry.targetUrl} rel="sponsored noopener">
            <div class="sponsored-media">
              <Picture
                src={partnerArtwork}
                alt=""
                formats={['avif']}
                fallbackFormat="webp"
                widths={[320, 528, 792, 1056]}
                sizes="(max-width: 767px) calc(100vw - 48px), (max-width: 1084px) 33vw, 25vw"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="sponsored-copy">
              <h3>{entry.title}</h3>
              <p>{entry.label} · {entry.disclosure}</p>
            </div>
          </a>
      ))}
    </div>
  </section>
  )}

  <section class="page-section content-boundary">
    <div class="section-heading daily-heading">
      <h2>Daily link games</h2>
      <a href="/daily/">All daily links</a>
    </div>
    {dailyGames.length > 0 ? <div class="daily-list">
      {dailyGames.map((game) => (
        <a href={game.href}>
          <span>{game.name}</span>
          <strong>{game.liveCount} listed links</strong>
          <time datetime={game.latestCheckedAt ?? undefined}>{game.checkedLabel}</time>
        </a>
      ))}
    </div> : <div class="data-empty"><strong>No daily-link page is published yet</strong><p>The section will populate as reward links are recorded.</p></div>}
  </section>

  <section class="page-section discovery-section content-boundary">
    <div class="section-heading">
      <h2>Explore cheats, answers and guides</h2>
      <a href="/games/">Browse all games</a>
    </div>
    <p class="discovery-intro">Codes are only one way into the site. These sections cover built-in cheats, exact puzzle answers and practical guides for the questions a reward code cannot solve.</p>
    <div class="discovery-grid">
      {discoverySections.map((section) => (
        <article class="discovery-card">
          <a class="discovery-category" href={section.href}>{section.label}</a>
          <p>{section.copy}</p>
          <div class="discovery-links">
            {section.links.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  {/*
    * The home ad block. This was a mock native card that printed the ad
    * provider's own name as a sponsored headline, which read as an advertisement
    * for AdSense rather than a place to put one. It is a real unit now, and it is
    * below the discovery grid rather than above it because nothing paid comes
    * before the codes a reader arrived for.
    *
    * It sits inside the page's content boundary like every section above it. A
    * fixed-size unit would have had to break the 32px gutter to fit a 300px
    * creative on a 360px phone; a responsive one takes the width it is given, so
    * the block can line up with the grid above instead of being the one thing on
    * the page whose edges do not.
    */}
  <section class="page-section content-boundary">
    <AdSlot placement="home-feed" />
  </section>
</BaseLayout>

<style>
  .data-empty {
    border: 1px dashed var(--border-strong);
    background: var(--surface-raised);
    padding: clamp(20px, 3vw, 30px);
  }

  .data-empty strong { color: var(--text-primary); }
  .data-empty p { max-width: 72ch; margin: 8px 0 0; color: var(--text-secondary); line-height: 1.6; }

  .hero {
    position: relative;
    width: 100%;
    height: clamp(450px, 33vw, 480px);
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-card);
  }

  .hero-art,
  .hero-scrim {
    position: absolute;
    inset: 0;
  }

  .hero-art :global(picture),
  .hero-art :global(img),
  .tile-art :global(picture),
  .tile-art :global(img),
  .sponsored-media :global(picture),
  .sponsored-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-art :global(img),
  .tile-art :global(img),
  .sponsored-media :global(img) {
    object-fit: cover;
  }

  .hero-art :global(img) {
    object-position: 68% center;
  }

  .hero-scrim {
    z-index: 1;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0.66) 42%, rgba(0, 0, 0, 0.12) 78%, transparent 100%);
    pointer-events: none;
  }

  .hero-boundary {
    position: relative;
    z-index: 2;
    display: flex;
    height: 100%;
    align-items: center;
    box-sizing: border-box;
    padding-block: clamp(24px, 2.2vw, 32px);
  }

  .hero-copy {
    max-width: min(680px, 60%);
    padding: 0 var(--page-gutter);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: clamp(10px, 1.2vw, 14px);
    color: #fff;
    font: 700 13px / 1.4 var(--font-core);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow > span:first-child {
    display: block;
    width: 7px;
    height: 7px;
    flex: none;
    background: var(--green-neon);
    animation: ftPulse 2.4s var(--ease-standard) infinite;
  }

  .hero h1 {
    margin: 0;
    color: #fff;
    font: 600 clamp(34px, 4vw, 54px) / 1.02 var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-wrap: pretty;
  }

  .hero-copy > p {
    max-width: 46ch;
    margin: clamp(12px, 1.2vw, 17px) 0 0;
    color: #d7dce1;
    font: 400 var(--fs-body-lg) / var(--lh-body-lg) var(--font-core);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(17px, 1.8vw, 23px);
  }

  .page-section {
    padding: clamp(30px, 4vw, 48px) var(--page-gutter) 0;
  }

  .intro-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(390px, 0.9fr);
    align-items: end;
    gap: clamp(24px, 4vw, 56px);
    padding-top: clamp(22px, 2.4vw, 30px);
  }

  .page-section > h2,
  .section-heading h2 {
    margin: 0;
    color: var(--text-primary);
    font: 600 var(--fs-h3) / var(--lh-h3) var(--font-display);
  }

  .intro-copy > h2 {
    margin: 0;
    color: var(--text-primary);
    font: 600 var(--fs-h2) / var(--lh-h2) var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .section-intro {
    max-width: 62ch;
    margin: 8px 0 0;
    color: var(--text-secondary);
    font: 400 var(--fs-body-lg) / var(--lh-body-lg) var(--font-core);
    text-wrap: pretty;
  }

  .pulse-grid {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--border-subtle);
    background: var(--surface-raised);
  }

  .pulse-grid > div {
    min-width: 120px;
    flex: 1 1 120px;
    border-right: 1px solid var(--border-subtle);
    padding: 12px 16px;
  }

  .pulse-grid > div:last-child {
    border-right: 0;
  }

  .pulse-grid strong {
    display: block;
    color: var(--text-primary);
    font: 600 23px / 1.1 var(--font-display);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  .pulse-grid span {
    display: block;
    margin-top: 5px;
    color: var(--text-tertiary);
    font: 400 13px / 1.38 var(--font-core);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 18px;
  }

  .games-section {
    padding-top: clamp(24px, 2.8vw, 34px);
  }

  .section-heading > a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--text-primary);
    font: 600 13px / 1 var(--font-core);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(228px, 1fr));
    gap: 28px 20px;
  }

  .game-tile {
    display: block;
    background: var(--surface-page);
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard);
  }

  .game-tile:hover {
    background: var(--surface-raised);
    text-decoration: none;
  }

  .game-media {
    position: relative;
    aspect-ratio: 528 / 320;
    overflow: hidden;
    background: var(--surface-card);
  }

  .tile-art {
    position: absolute;
    inset: 0;
    transition: transform 250ms var(--ease-standard);
  }

  .game-tile:hover .tile-art {
    transform: scale(1.04);
  }

  .tile-scrim {
    position: absolute;
    inset: auto 0 0;
    height: 62%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.82), transparent);
    pointer-events: none;
  }

  .verified-label {
    position: absolute;
    right: 12px;
    bottom: 11px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: none;
  }

  .verified-label span {
    width: 6px;
    height: 6px;
    flex: none;
    background: var(--green-neon);
  }

  .verified-label strong {
    color: #fff;
    font: 700 var(--fs-caption) / 1.4 var(--font-core);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .game-copy {
    padding: 13px 14px 16px;
  }

  .game-copy h3 {
    margin: 0;
    color: var(--text-primary);
    font: 600 16px / 1.35 var(--font-core);
    text-wrap: pretty;
  }

  .game-copy > div {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 6px;
    color: var(--text-tertiary);
    font: 400 13px / 1.38 var(--font-core);
    font-variant-numeric: tabular-nums;
  }

  .game-copy > div span:first-child {
    color: var(--text-brand);
    font-weight: 600;
  }

  .sponsored-section {
    padding-top: clamp(30px, 4vw, 44px);
  }

  .sponsored-section > h2 {
    margin-bottom: 10px;
    color: var(--text-caption);
    font: 700 var(--fs-caption) / 1.4 var(--font-core);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .sponsored-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 20px;
  }

  .sponsored-card {
    background: var(--surface-raised);
  }

  .sponsored-media {
    position: relative;
    aspect-ratio: 528 / 320;
    background: var(--surface-card);
  }

  .sponsored-copy {
    padding: 11px 13px 14px;
  }

  .sponsored-copy h3 {
    margin: 0;
    color: var(--text-primary);
    font: 600 14px / 1.35 var(--font-core);
  }

  .sponsored-copy p {
    margin: 4px 0 0;
    color: var(--text-caption);
    font: 400 12px / 1.4 var(--font-core);
  }

  .daily-heading {
    margin-bottom: 16px;
  }

  .daily-list {
    border: 1px solid var(--border-subtle);
  }

  .daily-list a {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--rowpad) 16px;
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard);
  }

  .daily-list a:last-child {
    border-bottom: 0;
  }

  .daily-list a:hover {
    background: var(--white-a08);
  }

  .daily-list a > span:first-child {
    min-width: 0;
    flex: 1 1 130px;
    color: var(--text-primary);
  }

  .daily-list strong {
    flex: none;
    color: var(--text-brand);
    font: 600 13px / 1 var(--font-core);
    font-variant-numeric: tabular-nums;
  }

  .daily-list time {
    width: 96px;
    flex: none;
    color: var(--text-tertiary);
    font: 400 13px / 1 var(--font-core);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .discovery-section {
    padding-top: clamp(34px, 4.5vw, 54px);
  }

  .discovery-intro {
    max-width: 72ch;
    margin: -6px 0 20px;
    color: var(--text-secondary);
    font: 400 var(--fs-body-lg) / var(--lh-body-lg) var(--font-core);
  }

  .discovery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .discovery-card {
    position: relative;
    border: 1px solid var(--border-subtle);
    background: var(--surface-raised);
    padding: 22px;
  }

  .discovery-card::before {
    position: absolute;
    top: -1px;
    right: -1px;
    left: -1px;
    height: 3px;
    background: var(--green-neon);
    content: '';
  }

  .discovery-category {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    color: var(--text-primary);
    font: 600 var(--fs-h4) / var(--lh-h4) var(--font-display);
    letter-spacing: .02em;
    text-transform: uppercase;
  }

  .discovery-card > p {
    margin: 10px 0 20px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .discovery-links {
    display: grid;
    border-top: 1px solid var(--border-subtle);
  }

  .discovery-links a {
    display: flex;
    min-height: 44px;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-primary);
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .hero {
      height: auto;
      min-height: 450px;
    }

    .hero-copy {
      max-width: 100%;
      padding-block: 38px;
    }

    .hero-boundary {
      padding-block: 0;
    }

    .intro-section {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 16px;
    }

    .page-section {
      padding-top: 26px;
    }

    .intro-copy > h2 {
      font-size: 28px;
      line-height: 1.05;
    }

    .game-grid,
    .sponsored-grid,
    .discovery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
