---
import RouteScreen from '../../components/pages/RouteScreen.astro';
import { getRouteDefinition } from '../../data/routes';
import { applyOnDemandHeaders } from '../../lib/response-headers';

export const prerender = false;

applyOnDemandHeaders(Astro.response.headers, 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const definition = getRouteDefinition('/alerts/manage');
---

<RouteScreen definition={definition} />
