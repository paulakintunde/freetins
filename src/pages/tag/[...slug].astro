---
/*
 * WordPress tag archives from the old site. Gone as a shape, not as a list of URLs:
 * see `goneRoutePrefixes` in src/data/gone.ts for why these return 410 rather than
 * redirecting to a hub.
 *
 * The rest parameter matches the bare `/tag/` as well as anything beneath it.
 * A named 301 in `public/_redirects` outranks this route, so an archive path that
 * does have a real successor can still be redirected explicitly.
 */
import GonePage from '../../components/pages/GonePage.astro';

export const prerender = false;
---

<GonePage variant="archive" />
