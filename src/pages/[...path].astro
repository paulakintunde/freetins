---
import RouteScreen from '../components/pages/RouteScreen.astro';
import { prerenderedRouteDefinitions, type RouteDefinition } from '../data/routes';

export function getStaticPaths() {
  return prerenderedRouteDefinitions.map((definition) => ({
    params: { path: definition.path.slice(1) },
    props: { definition },
  }));
}

interface Props {
  definition: RouteDefinition;
}

const { definition } = Astro.props;
---

<RouteScreen definition={definition} />
