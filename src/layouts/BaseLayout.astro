---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ConsentBanner from './partials/ConsentBanner.astro';
import Footer from './partials/Footer.astro';
import Header from './partials/Header.astro';
import OutageBanner, { type CheckerStatus } from './partials/OutageBanner.astro';
import { operations } from '../data/operations';
import {
  contactEmail,
  defaultSocialImage,
  defaultSocialImageAlt,
  googleSiteVerification,
  organizationId,
  siteOrigin,
  websiteId,
} from '../data/site';
import { adsensePublisherId } from '../data/advertising';
import { canonicalUrl, webPageId } from '../lib/pageGraph';

interface Props {
  title: string;
  description: string;
  checkerStatus?: CheckerStatus;
  consentMode?: 'gdpr' | 'california';
  image?: string | undefined;
  imageAlt?: string | undefined;
  noindex?: boolean;
  /** False omits the rel=canonical link; the 404 template is the one user. */
  canonical?: boolean;
  theme?: 'light' | 'dark';
  /**
   * Properties merged into this page's single WebPage node: the breadcrumb it
   * ends, the entity it is about, a narrower page type, the dates a template
   * knows and the layout does not. A template that needs any of these says so
   * here; it never declares a WebPage of its own (src/lib/pageGraph.ts).
   */
  webPage?: Record<string, unknown>;
  /**
   * The template's own nodes: Article, BreadcrumbList, FAQPage, Dataset. They
   * join the one graph this layout emits, because a second script tag with a
   * second graph is how one @id came to carry two names.
   */
  schemaNodes?: Record<string, unknown>[];
}

const {
  title,
  description,
  checkerStatus = operations.services.checker.enabled ? 'Degraded' : 'Unconfigured',
  consentMode = 'gdpr',
  image = defaultSocialImage,
  imageAlt = defaultSocialImageAlt,
  noindex = false,
  canonical: emitCanonical = true,
  theme = 'dark',
  webPage = {},
  schemaNodes = [],
} = Astro.props;
const hasPrimaryImage = typeof Astro.props.image === 'string';
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Freetins',
      url: siteOrigin,
      /*
       * The publisher logo. Every Article on the site points its `publisher` at
       * this node by id, so the property was missing from all of them at once.
       * The asset is the favicon already in `public/`, at the 512x512 Google asks
       * a publisher logo to clear — no new art, and nothing invented. `sameAs` is
       * still absent because the site has no profile anywhere to cite, and a
       * fabricated one would be worse than the gap.
       */
      logo: {
        '@type': 'ImageObject',
        url: new URL('/favicon.png', Astro.site),
        width: 512,
        height: 512,
      },
      description: 'Source-backed game codes, daily reward links, cheats, answers and guides with explicit publication states.',
      publishingPrinciples: `${siteOrigin}/how-we-verify/`,
      correctionsPolicy: `${siteOrigin}/how-we-verify/`,
      email: contactEmail,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteOrigin,
      name: 'Freetins',
      publisher: { '@id': organizationId },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteOrigin}/search/?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      /*
       * The page's one WebPage node. `name` is the document title, because that
       * is what a WebPage's name is: the string the <title> carries. A
       * template's heading is the Article's `headline` and belongs there.
       * Everything a template adds is merged in after, including a narrower
       * `@type` for a page that is a collection rather than a document.
       */
      '@type': 'WebPage',
      '@id': webPageId(canonical),
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': websiteId },
      ...(hasPrimaryImage
        ? {
          primaryImageOfPage: {
            '@type': 'ImageObject',
            url: socialImage,
            width: 1200,
            height: 630,
            caption: imageAlt,
          },
        }
        : {}),
      ...webPage,
    },
    ...schemaNodes,
  ],
};
---

<!doctype html>
<html lang="en" data-consent-region={consentMode} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {/*
      * How AdSense recognises the site. It is a name and nothing else: no script,
      * no cookie, no request, so it renders on every page whether or not
      * advertising is switched on and costs a reader nothing either way. The other
      * half of the same claim is `public/ads.txt`; both carry the one publisher id
      * `src/content/operations.json` records (src/data/advertising.ts).
      */}
    {adsensePublisherId && <meta name="google-adsense-account" content={adsensePublisherId} />}
    {emitCanonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Freetins" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <ClientRouter fallback="swap" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#ft-main">Skip to content</a>
    <Header currentPath={Astro.url.pathname} />
    <OutageBanner status={checkerStatus} statusUrl={operations.services.checker.enabled ? '/api/checker-status.json' : undefined} />
    <main id="ft-main">
      <slot />
    </main>
    <Footer />
    <ConsentBanner mode={consentMode} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 0;
    left: -9999px;
    z-index: 200;
    background: var(--green-600);
    color: #fff;
    padding: 14px 18px;
    font: 600 13px / 1 var(--font-core);
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .skip-link:focus {
    top: 8px;
    left: 8px;
  }

  main {
    min-height: 55vh;
  }
</style>
