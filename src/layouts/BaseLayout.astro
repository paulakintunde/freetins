---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ConsentBanner from './partials/ConsentBanner.astro';
import Footer from './partials/Footer.astro';
import Header from './partials/Header.astro';
import OutageBanner, { type CheckerStatus } from './partials/OutageBanner.astro';
import { operations } from '../data/operations';
import { contactEmail, googleSiteVerification, organizationId, siteOrigin, websiteId } from '../data/site';

interface Props {
  title: string;
  description: string;
  checkerStatus?: CheckerStatus;
  consentMode?: 'gdpr' | 'california';
  image?: string | undefined;
  imageAlt?: string | undefined;
  noindex?: boolean;
  theme?: 'light' | 'dark';
}

const {
  title,
  description,
  checkerStatus = operations.services.checker.enabled ? 'Degraded' : 'Unconfigured',
  consentMode = 'gdpr',
  image = '/og/freetins-home-game-codes.jpg',
  imageAlt = 'Freetins game codes and daily reward links',
  noindex = false,
  theme = 'dark',
} = Astro.props;
const hasPrimaryImage = typeof Astro.props.image === 'string';
const normalizedPathname = Astro.url.pathname === '/index.html'
  ? '/'
  : Astro.url.pathname.replace(/\.html$/, '');
const cleanPathname = normalizedPathname === '/'
  ? '/'
  : normalizedPathname.endsWith('/')
    ? normalizedPathname
    : `${normalizedPathname}/`;
const canonical = new URL(cleanPathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Freetins',
      url: siteOrigin,
      description: 'Source-backed game codes, daily reward links, cheats, answers and guides with explicit publication states.',
      publishingPrinciples: `${siteOrigin}/how-we-verify/`,
      correctionsPolicy: `${siteOrigin}/how-we-verify/`,
      email: contactEmail,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteOrigin,
      name: 'Freetins',
      publisher: { '@id': organizationId },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteOrigin}/search/?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': websiteId },
      ...(hasPrimaryImage
        ? {
          primaryImageOfPage: {
            '@type': 'ImageObject',
            url: socialImage,
            width: 1200,
            height: 630,
            caption: imageAlt,
          },
        }
        : {}),
    },
  ],
};
---

<!doctype html>
<html lang="en" data-consent-region={consentMode} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Freetins" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <ClientRouter fallback="swap" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#ft-main">Skip to content</a>
    <Header currentPath={Astro.url.pathname} />
    <OutageBanner status={checkerStatus} statusUrl={operations.services.checker.enabled ? '/api/checker-status.json' : undefined} />
    <main id="ft-main">
      <slot />
    </main>
    <Footer />
    <ConsentBanner mode={consentMode} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 0;
    left: -9999px;
    z-index: 200;
    background: var(--green-600);
    color: #fff;
    padding: 14px 18px;
    font: 600 13px / 1 var(--font-core);
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .skip-link:focus {
    top: 8px;
    left: 8px;
  }

  main {
    min-height: 55vh;
  }
</style>
