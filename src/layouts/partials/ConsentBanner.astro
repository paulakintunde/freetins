---
import { consentPurposes, consentVendors } from '../../data/site';

interface Props {
  mode?: 'gdpr' | 'california';
}

const { mode = 'gdpr' } = Astro.props;
const isGdpr = mode === 'gdpr';
const hasOptionalPurposes = consentPurposes.some((purpose) => !purpose.required);
const copy = isGdpr
  ? hasOptionalPurposes ? {
      eyebrow: 'Cookies',
      title: 'We use cookies to run ads on this site',
      body: 'Necessary storage keeps the site working. Configured advertising remains off until you allow it, and rejecting it does not change content.',
    } : {
      eyebrow: 'Site storage',
      title: 'Only necessary storage is active',
      body: 'Freetins stores your privacy choice and temporary interface preferences. No analytics, advertising or personalisation vendor is configured.',
    }
  : {
      eyebrow: 'Your privacy choices',
      title: hasOptionalPurposes ? 'Do not sell or share my personal information' : 'Optional tracking is not active',
      body: hasOptionalPurposes ? 'Configured advertising remains subject to your privacy choices and Global Privacy Control.' : 'No analytics, advertising or personalisation vendor is configured.',
    };
---

<section
  class="consent-banner"
  data-consent-banner
  data-consent-mode={mode}
  data-consent-optional={hasOptionalPurposes ? 'true' : 'false'}
  aria-label="Cookie choices"
>
  <div class="consent-inner content-boundary">
    <div class="consent-copy">
      <div class="consent-eyebrow">{copy.eyebrow}</div>
      <h2>{copy.title}</h2>
      <p>{copy.body}</p>
      <a href="/privacy/">Read the privacy page</a>
    </div>

    <div class="manage-panel" data-consent-manage hidden>
      <div class="purpose-list">
        {consentPurposes.map((purpose) => {
          const enabled = purpose.required || purpose.id === 'analytics';
          return (
            <div class="purpose-row">
              <div>
                <h3>{purpose.name}</h3>
                <p>{purpose.description}</p>
              </div>
              <button
                type="button"
                class:list={['purpose-toggle', { enabled, required: purpose.required }]}
                role="switch"
                aria-checked={enabled ? 'true' : 'false'}
                data-purpose={purpose.id}
                data-enabled={enabled ? 'true' : 'false'}
                disabled={purpose.required}
              >
                <span data-state>{purpose.required ? 'Always on' : enabled ? 'On' : 'Off'}</span>
              </button>
            </div>
          );
        })}
      </div>

      <div class="vendor-list">
        <h3>Named vendors</h3>
        {consentVendors.map((vendor) => (
          <div><span>{vendor.name}</span><span>{vendor.purpose}</span></div>
        ))}
      </div>
    </div>

    <div class="consent-actions">
      {isGdpr && hasOptionalPurposes && <button class="ghost-button" type="button" data-consent-reject>Reject all</button>}
      <button class="ghost-button" type="button" data-consent-toggle>Manage</button>
      <button class="accept-button" type="button" data-consent-accept>{isGdpr ? hasOptionalPurposes ? 'Accept all' : 'Continue' : 'Confirm choices'}</button>
    </div>
  </div>
</section>

<style>
  .consent-banner {
    position: sticky;
    bottom: 0;
    z-index: 60;
    border-top: 1px solid var(--border-strong);
    background: #0a0a0a;
  }

  .consent-inner {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 20px;
    padding: 16px var(--page-gutter);
  }

  .consent-copy {
    min-width: 0;
    flex: 1 1 300px;
  }

  .consent-eyebrow {
    color: var(--text-disabled);
    font: 700 10.5px / 1.4 var(--font-core);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .consent-copy h2 {
    margin: 8px 0 0;
    color: var(--text-primary);
    font: 600 15px / 1.4 var(--font-core);
  }

  .consent-copy p {
    max-width: 72ch;
    margin: 7px 0 0;
    color: var(--text-secondary);
    font: 400 13px / 1.55 var(--font-core);
  }

  .consent-copy a {
    display: inline-block;
    margin-top: 9px;
    color: var(--text-primary);
    font: 600 12.5px / 1.4 var(--font-core);
  }

  .manage-panel {
    min-width: 0;
    flex: 1 1 360px;
    border: 1px solid var(--border-subtle);
  }

  .purpose-row {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--border-subtle);
    padding: 11px 14px;
  }

  .purpose-row > div {
    min-width: 0;
    flex: 1 1 0;
  }

  .purpose-row h3,
  .vendor-list h3 {
    margin: 0;
    color: var(--text-primary);
    font: 600 13px / 1.4 var(--font-core);
  }

  .purpose-row p {
    margin: 3px 0 0;
    color: var(--text-tertiary);
    font: 400 12px / 1.45 var(--font-core);
  }

  .purpose-toggle {
    min-width: 74px;
    flex: none;
    border: 1px solid var(--border-strong);
    border-radius: 0;
    background: transparent;
    color: var(--text-secondary);
    padding: 10px 8px;
    font: 700 10px / 1 var(--font-core);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .purpose-toggle.enabled:not(.required) {
    border-color: var(--green-600);
    background: var(--green-600);
    color: #fff;
  }

  .purpose-toggle.required {
    border-color: var(--border-subtle);
    color: var(--text-disabled);
    cursor: default;
  }

  .vendor-list {
    padding: 12px 14px;
  }

  .vendor-list > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 7px;
    color: var(--text-tertiary);
    font: 400 12px / 1.4 var(--font-core);
  }

  .vendor-list > div span:last-child {
    color: var(--text-disabled);
  }

  .consent-actions {
    display: flex;
    flex: none;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 8px;
  }

  .consent-actions button {
    min-height: 44px;
    border-radius: 0;
    padding: 13px 16px;
    color: var(--text-primary);
    font: 600 11px / 1 var(--font-core);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .ghost-button {
    border: 1px solid var(--border-strong);
    background: transparent;
  }

  .ghost-button:hover {
    background: var(--white-a12);
  }

  .accept-button {
    border: 0;
    background: var(--green-600);
  }

  .accept-button:hover {
    background: var(--green-700);
  }
</style>
