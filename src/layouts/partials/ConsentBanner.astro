---
import { consentPurposes, consentVendors, edgeAnalytics } from '../../data/site';

interface Props {
  mode?: 'gdpr' | 'california';
}

const { mode = 'gdpr' } = Astro.props;
const isGdpr = mode === 'gdpr';
const hasOptionalPurposes = consentPurposes.some((purpose) => !purpose.required);

/**
 * This panel used to state flatly that no analytics vendor was configured. That was true
 * only because the site's own CSP was blocking the beacon Cloudflare injects at the edge.
 * Unblocking it makes the old sentence false, so the sentence is derived from
 * `edgeAnalytics` now instead of being asserted — turn the vendor off and the original
 * wording comes back on its own.
 *
 * It is described, not offered as a toggle: the injection happens after this build's HTML
 * is written, so a switch here could not actually stop it. See `edgeAnalytics`.
 */
const measurementClause = edgeAnalytics.enabled
  ? 'Page views are counted without cookies or cross-site identifiers.'
  : 'No analytics vendor is configured.';
const otherVendorClause = 'No advertising or personalisation vendor is configured.';

const copy = isGdpr
  ? hasOptionalPurposes ? {
      title: 'We use cookies to run ads on this site',
      body: 'Necessary storage keeps the site working. Configured advertising remains off until you allow it, and rejecting it does not change content.',
    } : {
      title: 'Only necessary storage is active',
      body: `Freetins stores your privacy choice and temporary interface preferences. ${measurementClause} ${otherVendorClause}`,
    }
  : {
      title: hasOptionalPurposes ? 'Do not sell or share my personal information' : 'Optional tracking is not active',
      body: hasOptionalPurposes
        ? 'Configured advertising remains subject to your privacy choices and Global Privacy Control.'
        : `${measurementClause} ${otherVendorClause}`,
    };
---

<section
  class:list={['consent-banner', { compact: !hasOptionalPurposes }]}
  data-consent-banner
  data-consent-mode={mode}
  data-consent-optional={hasOptionalPurposes ? 'true' : 'false'}
  aria-label="Cookie choices"
>
  <div class="consent-inner content-boundary">
    <div class="consent-copy">
      <p class="consent-title">{copy.title}</p>
      <p>{copy.body} <a href="/privacy/">Read the privacy page</a>.</p>
    </div>

    <div class="manage-panel" data-consent-manage hidden={true}>
      <div class="purpose-list">
        {consentPurposes.map((purpose) => {
          const enabled = purpose.required || purpose.id === 'analytics';
          return (
            <div class="purpose-row">
              <div>
                <p class="purpose-name" id={`consent-purpose-${purpose.id}`}>{purpose.name}</p>
                <p>{purpose.description}</p>
              </div>
              <button
                type="button"
                class:list={['purpose-toggle', { enabled, required: purpose.required }]}
                role="switch"
                aria-checked={enabled ? 'true' : 'false'}
                aria-labelledby={`consent-purpose-${purpose.id}`}
                data-purpose={purpose.id}
                data-enabled={enabled ? 'true' : 'false'}
                disabled={purpose.required}
              >
                <span data-state>{purpose.required ? 'Always on' : enabled ? 'On' : 'Off'}</span>
              </button>
            </div>
          );
        })}
      </div>

      <div class="vendor-list">
        <p class="vendor-title">Named vendors</p>
        {consentVendors.map((vendor) => (
          <div><span>{vendor.name}</span><span>{vendor.purpose}</span></div>
        ))}
      </div>
    </div>

    <div class="consent-actions">
      {hasOptionalPurposes && isGdpr && <button class="ghost-button" type="button" data-consent-reject>Reject all</button>}
      {hasOptionalPurposes && <button class="ghost-button" type="button" data-consent-toggle>Manage</button>}
      <button class="accept-button" type="button" data-consent-accept>{hasOptionalPurposes ? (isGdpr ? 'Accept all' : 'Confirm choices') : 'Got it'}</button>
    </div>
  </div>
</section>

<style>
  .consent-banner {
    position: sticky;
    bottom: 0;
    z-index: 60;
    border-top: 1px solid var(--border-strong);
    background: #0a0a0a;
  }

  .consent-inner {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 10px 20px;
    padding: 10px var(--page-gutter);
  }

  /* No optional processing: one line of copy and one dismiss control. */
  .compact .consent-inner {
    align-items: center;
    flex-wrap: nowrap;
    gap: 12px;
    padding-block: 8px;
  }

  .compact .consent-copy .consent-title {
    display: inline;
    font-size: var(--fs-body);
  }

  .compact .consent-copy p {
    display: inline;
    margin: 0;
  }

  .compact .consent-copy p:not(.consent-title)::before { content: ' '; }

  @media (max-width: 560px) {
    .compact .consent-inner { flex-wrap: wrap; }
  }

  .consent-copy {
    min-width: 0;
    flex: 1 1 300px;
  }

  .consent-copy .consent-title {
    margin: 0;
    color: var(--text-primary);
    font: 600 15px / 1.4 var(--font-core);
  }

  .consent-copy p {
    max-width: 72ch;
    margin: 5px 0 0;
    color: var(--text-secondary);
    font: 400 13px / 1.55 var(--font-core);
  }

  .consent-copy a {
    color: var(--text-primary);
    font-weight: 600;
    text-decoration: underline;
  }

  .manage-panel {
    min-width: 0;
    flex: 1 1 360px;
    border: 1px solid var(--border-subtle);
  }

  .purpose-row {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--border-subtle);
    padding: 11px 14px;
  }

  .purpose-row > div {
    min-width: 0;
    flex: 1 1 0;
  }

  .purpose-row .purpose-name,
  .vendor-list .vendor-title {
    margin: 0;
    color: var(--text-primary);
    font: 600 13px / 1.4 var(--font-core);
  }

  .purpose-row p {
    margin: 3px 0 0;
    color: var(--text-tertiary);
    font: 400 12px / 1.45 var(--font-core);
  }

  .purpose-toggle {
    min-width: 74px;
    flex: none;
    border: 1px solid var(--border-strong);
    border-radius: 0;
    background: transparent;
    color: var(--text-secondary);
    padding: 10px 8px;
    font: 700 var(--fs-caption) / 1 var(--font-core);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .purpose-toggle.enabled:not(.required) {
    border-color: var(--green-600);
    background: var(--green-600);
    color: #fff;
  }

  .purpose-toggle.required {
    border-color: var(--border-subtle);
    color: var(--text-disabled);
    cursor: default;
  }

  .vendor-list {
    padding: 12px 14px;
  }

  .vendor-list > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 7px;
    color: var(--text-tertiary);
    font: 400 12px / 1.4 var(--font-core);
  }

  .vendor-list > div span:last-child {
    color: var(--text-caption);
  }

  .consent-actions {
    display: flex;
    flex: none;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 8px;
  }

  .consent-actions button {
    min-height: 44px;
    border-radius: 0;
    padding: 13px 16px;
    color: var(--text-primary);
    font: 600 var(--fs-caption) / 1 var(--font-core);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .ghost-button {
    border: 1px solid var(--border-strong);
    background: transparent;
  }

  .ghost-button:hover {
    background: var(--white-a12);
  }

  .accept-button {
    border: 0;
    background: var(--green-600);
  }

  .accept-button:hover {
    background: var(--green-700);
  }
</style>
