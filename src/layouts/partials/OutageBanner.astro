---
export type CheckerStatus = 'Live' | 'Degraded' | 'Outage';

interface Props {
  status?: CheckerStatus;
}

const { status = 'Live' } = Astro.props;
const statusCopy = {
  Degraded: {
    title: 'Checks are running behind',
    body: 'Some verification checks are delayed. Published check times remain visible on every code page.',
  },
  Outage: {
    title: 'Hourly checks are currently unavailable',
    body: 'Published check times are frozen at the last successful run until the checker recovers.',
  },
} as const;

const copy = status === 'Live' ? null : statusCopy[status];
---

<aside
  class:list={['outage-banner', status.toLowerCase()]}
  data-outage-banner
  data-status-state={status}
  data-status-fingerprint={status}
  hidden={status === 'Live'}
>
  <div class="outage-inner content-boundary">
    <div>
      <h2 data-status-title>{copy?.title ?? 'Checker status'}</h2>
      <p data-status-message>{copy?.body ?? ''}</p>
    </div>
    <a href="/status">Checker status</a>
    <button type="button" aria-label="Dismiss status notice" data-outage-dismiss>&times;</button>
  </div>
</aside>

<style>
  .outage-banner {
    border-bottom: 1px solid var(--amber-500);
    background: var(--surface-raised);
  }

  .outage-banner.outage {
    border-color: var(--red-500);
  }

  .outage-inner {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 14px var(--page-gutter);
  }

  .outage-inner > div {
    min-width: 0;
    flex: 1;
  }

  h2 {
    margin: 0;
    color: var(--text-primary);
    font: 600 14px / 1.4 var(--font-core);
  }

  p {
    max-width: 76ch;
    margin: 5px 0 0;
    color: var(--text-secondary);
    font: 400 13px / 1.5 var(--font-core);
  }

  a {
    min-height: 44px;
    display: inline-flex;
    flex: none;
    align-items: center;
    color: var(--text-primary);
    font: 600 11px / 1 var(--font-core);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  button {
    width: 44px;
    height: 44px;
    flex: none;
    border: 1px solid var(--border-subtle);
    border-radius: 0;
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
  }
</style>
