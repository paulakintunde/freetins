---
export type CheckerStatus = 'Unconfigured' | 'Live' | 'Degraded' | 'Outage';

interface Props {
  status?: CheckerStatus;
  statusUrl?: string | undefined;
}

const { status = 'Unconfigured', statusUrl } = Astro.props;
const statusCopy = {
  Unconfigured: {
    title: 'Automated checking is not active',
    body: 'Operational pages use recorded manual evidence only. No hourly or real-time checker claim is being made.',
  },
  Degraded: {
    title: 'Checks are running behind',
    body: 'The configured checker reported a degraded state. Use the absolute verification time on each record.',
  },
  Outage: {
    title: 'Automated checks are unavailable',
    body: 'No new automated result is being recorded. Existing records retain their absolute last-check time and can become stale.',
  },
} as const;

const copy = status === 'Live' ? null : statusCopy[status];
---

{(copy || statusUrl) && (
  <aside class:list={['outage-banner', status.toLowerCase()]} data-outage-banner data-checker-status-url={statusUrl} hidden={status === 'Live'}>
    <div class="outage-inner content-boundary">
      <div>
        <h2 data-checker-title>{copy?.title ?? 'Automated checks are live'}</h2>
        <p data-checker-message>{copy?.body ?? 'The checker status endpoint reports normal operation.'}</p>
      </div>
      <a href="/how-we-verify/">How we verify</a>
      <button type="button" aria-label="Dismiss notice" data-outage-dismiss>&times;</button>
    </div>
  </aside>
)}

<style>
  .outage-banner {
    border-bottom: 1px solid var(--amber-500);
    background: var(--surface-raised);
  }

  .outage-banner.outage {
    border-color: var(--red-500);
  }

  .outage-inner {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 14px var(--page-gutter);
  }

  .outage-inner > div {
    min-width: 0;
    flex: 1;
  }

  h2 {
    margin: 0;
    color: var(--text-primary);
    font: 600 14px / 1.4 var(--font-core);
  }

  p {
    max-width: 76ch;
    margin: 5px 0 0;
    color: var(--text-secondary);
    font: 400 13px / 1.5 var(--font-core);
  }

  a {
    min-height: 44px;
    display: inline-flex;
    flex: none;
    align-items: center;
    color: var(--text-primary);
    font: 600 11px / 1 var(--font-core);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  button {
    width: 44px;
    height: 44px;
    flex: none;
    border: 1px solid var(--border-subtle);
    border-radius: 0;
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
  }
</style>
