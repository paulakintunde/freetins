---
export type CheckerStatus = 'Unconfigured' | 'Live' | 'Degraded' | 'Outage';

interface Props {
  status?: CheckerStatus;
  statusUrl?: string | undefined;
}

const { status = 'Unconfigured', statusUrl } = Astro.props;
const statusCopy = {
  Unconfigured: {
    title: 'Automated checking is not active',
    body: 'Operational pages use recorded manual evidence only. No hourly or real-time checker claim is being made.',
  },
  Degraded: {
    title: 'Checks are running behind',
    body: 'The configured checker reported a degraded state. Use the absolute verification time on each record.',
  },
  Outage: {
    title: 'Automated checks are unavailable',
    body: 'No new automated result is being recorded. Existing records retain their absolute last-check time and can become stale.',
  },
} as const;

const copy = status === 'Live' ? null : statusCopy[status];
---

{(copy || statusUrl) && (
  <aside class:list={['outage-banner', status.toLowerCase()]} data-outage-banner data-checker-status-url={statusUrl} hidden={status === 'Live'}>
    <div class="outage-inner content-boundary">
      {/*
        The notice sits above the H1 on every page. As an always-expanded block it
        cost 210px of a 740px mobile viewport, so the detail now lives behind a
        disclosure and the collapsed strip is a single line.
      */}
      <details class="outage-detail">
        <summary>
          <span class="marker" aria-hidden="true"></span>
          <span data-checker-title>{copy?.title ?? 'Automated checks are live'}</span>
        </summary>
        <div class="outage-body">
          <p data-checker-message>{copy?.body ?? 'The checker status endpoint reports normal operation.'}</p>
          <a href="/how-we-verify/">How we verify</a>
        </div>
      </details>
      <button type="button" aria-label="Dismiss notice" data-outage-dismiss>&times;</button>
    </div>
  </aside>
)}

<style>
  .outage-banner {
    border-bottom: 1px solid var(--amber-500);
    background: var(--surface-raised);
  }

  .outage-banner.outage {
    border-color: var(--red-500);
  }

  .outage-inner {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 0 var(--page-gutter);
  }

  .outage-detail {
    min-width: 0;
    flex: 1;
  }

  summary {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 9px;
    cursor: pointer;
    padding: 6px 0;
    color: var(--text-primary);
    font: 600 14px / 1.35 var(--font-core);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .marker {
    width: 7px;
    height: 7px;
    flex: none;
    background: var(--amber-500);
  }

  .outage-banner.outage .marker {
    background: var(--red-500);
  }

  /* A caret so the row reads as expandable without an icon font. */
  summary::after {
    width: 7px;
    height: 7px;
    flex: none;
    border-right: 1.5px solid var(--text-tertiary);
    border-bottom: 1.5px solid var(--text-tertiary);
    margin-left: 2px;
    content: '';
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform var(--dur-fast) var(--ease-standard);
  }

  details[open] summary::after {
    transform: rotate(-135deg) translate(-2px, -2px);
  }

  .outage-body {
    padding: 0 0 14px 16px;
  }

  p {
    max-width: 76ch;
    margin: 0;
    color: var(--text-secondary);
    font: 400 13px / 1.55 var(--font-core);
  }

  a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--text-primary);
    font: 600 var(--fs-caption) / 1 var(--font-core);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  button {
    width: 44px;
    height: 44px;
    flex: none;
    margin-top: 4px;
    border: 1px solid var(--border-subtle);
    border-radius: 0;
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
  }

  button:hover {
    background: var(--white-a12);
  }
</style>
