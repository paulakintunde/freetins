---
import Brand from '../../components/Brand.astro';
import { operations } from '../../data/operations';
import { drawerLinks, hotSearches } from '../../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const alertsActive = operations.services.alerts.enabled;

const normalizedCurrentPath = currentPath === '/index.html'
  ? '/'
  : currentPath.replace(/\.html$/, '').replace(/\/+$/, '');

const isActive = (href: string) => {
  const target = href.replace(/\/+$/, '');
  if (target === '') return normalizedCurrentPath === '';
  return normalizedCurrentPath === target || normalizedCurrentPath.startsWith(`${target}/`);
};
---

<div class="drawer-overlay" data-drawer-overlay hidden aria-hidden="true">
  <aside
    id="mobile-drawer"
    class="drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
    tabindex="-1"
  >
    <div class="drawer-header">
      <Brand compact />
      <button class="close-button" type="button" aria-label="Close menu" data-drawer-close>&times;</button>
    </div>

    <div class="drawer-search">
      <form action="/search/" method="get" role="search">
        <label class="visually-hidden" for="drawer-query">Search a game</label>
        <input id="drawer-query" name="q" type="search" placeholder="Search a game" />
        <button type="submit">Go</button>
      </form>
      <div class="search-chips" aria-label="Most searched games">
        {hotSearches.map((term) => (
          <a href={`/search/?q=${encodeURIComponent(term)}`}>{term}</a>
        ))}
      </div>
    </div>

    <nav class="drawer-nav" aria-label="Mobile navigation">
      {drawerLinks.map((link) => (
        <a href={link.href} data-drawer-link aria-current={isActive(link.href) ? 'page' : undefined}>
          <span>{link.label}</span>
          {link.count && <span class="nav-count">{link.count}</span>}
        </a>
      ))}
    </nav>

    <section class="push-prompt" data-push-prompt aria-labelledby="push-prompt-title">
      <p class="push-title" id="push-prompt-title">{alertsActive ? 'Code alerts are active' : 'Code alerts are not active yet'}</p>
      <p>{alertsActive
        ? `Available channels: ${operations.services.alerts.channels.join(', ')}. Choose games and provide delivery details on the Alerts page.`
        : 'The alert pathway is preserved, but no permission or contact detail is requested until a delivery service is configured.'}</p>
      <div class="push-actions">
        <a class="allow-button" href="/alerts/">{alertsActive ? 'Manage alerts' : 'See alert status'}</a>
      </div>
    </section>

    <div class="drawer-footer">
      <a href="/how-we-verify/">How we verify</a>
      <a href="/privacy/">Privacy</a>
      <a href="/disclosure/">Affiliate disclosure</a>
      <a href="/contact/">Contact</a>
    </div>
  </aside>
</div>

<style>
  .drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(0, 0, 0, 0.72);
  }

  .drawer {
    display: flex;
    width: min(88%, 340px);
    height: 100dvh;
    flex-direction: column;
    overflow: auto;
    border-right: 1px solid var(--border-subtle);
    background: #0a0a0a;
  }

  .drawer-header {
    display: flex;
    min-height: 56px;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid var(--border-subtle);
    padding: 9px 14px;
  }

  .close-button {
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-subtle);
    border-radius: 0;
    background: transparent;
    color: var(--text-primary);
    font: 400 18px / 1 var(--font-core);
    cursor: pointer;
  }

  .close-button:hover {
    background: var(--white-a12);
  }

  .drawer-search {
    border-bottom: 1px solid var(--border-subtle);
    padding: 14px;
  }

  .drawer-search form {
    display: flex;
  }

  .drawer-search input {
    min-width: 0;
    flex: 1;
    border: 1px solid var(--border-strong);
    border-radius: 0;
    background: var(--surface-raised);
    color: var(--text-primary);
    padding: 13px 14px;
  }

  .drawer-search input:focus-visible {
    border-color: var(--green-neon);
    outline: 2px solid var(--green-neon);
    outline-offset: -2px;
  }

  .drawer-search form button {
    flex: none;
    border: 0;
    border-radius: 0;
    background: var(--green-600);
    color: #fff;
    padding: 0 15px;
    font: 600 var(--fs-caption) / 1 var(--font-core);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .search-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 11px;
  }

  .search-chips a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    border: 1px solid var(--border-subtle);
    color: var(--text-tertiary);
    padding: 0 12px;
    font: 400 13px / 1 var(--font-core);
    text-decoration: none;
  }

  .search-chips a:hover {
    background: var(--white-a12);
    color: var(--text-primary);
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
  }

  .drawer-nav a {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid var(--border-subtle);
    padding: 0 14px;
    color: var(--text-primary);
    font: 400 15px / 1.3 var(--font-core);
    text-decoration: none;
  }

  .drawer-nav a:hover {
    background: var(--white-a08);
  }

  .drawer-nav a[aria-current='page'] {
    background: var(--white-a08);
    box-shadow: inset 3px 0 0 var(--green-600);
    font-weight: 600;
  }

  .nav-count {
    color: var(--text-brand);
    font: 600 12px / 1 var(--font-core);
    font-variant-numeric: tabular-nums;
  }

  .push-prompt {
    margin: 14px;
    border: 1px solid var(--border-strong);
    background: var(--surface-raised);
    padding: 15px;
  }

  .push-prompt .push-title {
    margin: 0;
    color: var(--text-primary);
    font: 600 14px / 1.4 var(--font-core);
  }

  .push-prompt p {
    margin: 7px 0 0;
    color: var(--text-tertiary);
    font: 400 13px / 1.5 var(--font-core);
  }

  .push-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 13px;
  }

  .push-actions a {
    min-height: 44px;
    border-radius: 0;
    padding: 13px 14px;
    font: 600 var(--fs-caption) / 1 var(--font-core);
    letter-spacing: 0.06em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .allow-button {
    flex: 1 1 auto;
    border: 0;
    background: var(--green-600);
    color: #fff;
  }

  .drawer-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: auto;
    border-top: 1px solid var(--border-subtle);
    padding: 14px;
  }

  .drawer-footer a {
    color: var(--text-tertiary);
    font: 400 12.5px / 1.4 var(--font-core);
  }

  @media (min-width: 1084px) {
    .drawer-overlay {
      display: none;
    }
  }
</style>
