---
import Brand from '../../components/Brand.astro';
import { drawerLinks, hotSearches } from '../../data/site';
---

<div class="drawer-overlay" data-drawer-overlay hidden aria-hidden="true">
  <aside id="mobile-drawer" class="drawer" aria-label="Mobile navigation" tabindex="-1">
    <div class="drawer-header">
      <Brand compact />
      <button class="close-button" type="button" aria-label="Close menu" data-drawer-close>&times;</button>
    </div>

    <div class="drawer-search">
      <form action="/search" method="get" role="search">
        <label class="visually-hidden" for="drawer-query">Search a game</label>
        <input id="drawer-query" name="q" type="search" placeholder="Search a game" />
        <button type="submit">Go</button>
      </form>
      <div class="search-chips" aria-label="Most searched games">
        {hotSearches.map((term) => (
          <a href={`/search?q=${encodeURIComponent(term)}`}>{term}</a>
        ))}
      </div>
    </div>

    <nav class="drawer-nav" aria-label="Mobile navigation">
      {drawerLinks.map((link) => (
        <a href={link.href} data-drawer-link>
          <span>{link.label}</span>
          {link.count && <span class="nav-count">{link.count}</span>}
        </a>
      ))}
    </nav>

    <section class="push-prompt" data-push-prompt>
      <h2>Get a ping when a code drops</h2>
      <p>One notification per drop for the games you pick. No digests, no marketing.</p>
      <div class="push-actions">
        <button class="allow-button" type="button" data-push-allow>Allow</button>
        <button class="not-now-button" type="button" data-push-dismiss>Not now</button>
      </div>
    </section>

    <div class="push-allowed" data-push-allowed hidden>
      <span aria-hidden="true"></span>
      <p>Notifications on. Pick your games in <a href="/alerts">Alerts</a>.</p>
    </div>

    <div class="drawer-footer">
      <a href="/how-we-verify">How we verify</a>
      <a href="/privacy">Privacy</a>
      <a href="/affiliate-disclosure">Affiliate disclosure</a>
      <a href="/contact">Contact</a>
    </div>
  </aside>
</div>

<script>
  const overlay = document.querySelector<HTMLElement>('[data-drawer-overlay]');
  const drawer = document.querySelector<HTMLElement>('#mobile-drawer');
  const openButton = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-drawer-close]');

  if (overlay && drawer && openButton && closeButton) {
    let returnFocus: HTMLElement | null = null;

    const focusableElements = () =>
      Array.from(
        drawer.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((element) => !element.hidden);

    const closeDrawer = () => {
      if (overlay.hidden) return;
      overlay.hidden = true;
      overlay.setAttribute('aria-hidden', 'true');
      openButton.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('drawer-open');
      returnFocus?.focus();
    };

    const openDrawer = () => {
      returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : openButton;
      overlay.hidden = false;
      overlay.setAttribute('aria-hidden', 'false');
      openButton.setAttribute('aria-expanded', 'true');
      document.body.classList.add('drawer-open');
      requestAnimationFrame(() => closeButton.focus());
    };

    openButton.addEventListener('click', openDrawer);
    closeButton.addEventListener('click', closeDrawer);
    overlay.addEventListener('pointerdown', (event) => {
      if (event.target === overlay) closeDrawer();
    });

    drawer.querySelectorAll<HTMLElement>('[data-drawer-link]').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', (event) => {
      if (overlay.hidden) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closeDrawer();
        return;
      }

      if (event.key !== 'Tab') return;
      const elements = focusableElements();
      const first = elements[0];
      const last = elements.at(-1);
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    const pushPrompt = drawer.querySelector<HTMLElement>('[data-push-prompt]');
    const pushAllowed = drawer.querySelector<HTMLElement>('[data-push-allowed]');
    const allowPush = drawer.querySelector<HTMLButtonElement>('[data-push-allow]');
    const dismissPush = drawer.querySelector<HTMLButtonElement>('[data-push-dismiss]');

    const showPushAllowed = () => {
      if (pushPrompt) pushPrompt.hidden = true;
      if (pushAllowed) pushAllowed.hidden = false;
    };

    if ('Notification' in window && Notification.permission === 'granted') {
      showPushAllowed();
    }

    allowPush?.addEventListener('click', async () => {
      if (!('Notification' in window)) {
        if (pushPrompt) pushPrompt.querySelector('p')!.textContent = 'Notifications are not available in this browser.';
        return;
      }

      const permission = await Notification.requestPermission();
      if (permission === 'granted') showPushAllowed();
    });

    dismissPush?.addEventListener('click', () => {
      if (pushPrompt) pushPrompt.hidden = true;
    });
  }
</script>

<style>
  .drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(0, 0, 0, 0.72);
  }

  .drawer {
    display: flex;
    width: min(88%, 340px);
    height: 100dvh;
    flex-direction: column;
    overflow: auto;
    border-right: 1px solid var(--border-subtle);
    background: #0a0a0a;
  }

  .drawer-header {
    display: flex;
    min-height: 56px;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid var(--border-subtle);
    padding: 9px 14px;
  }

  .close-button {
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-subtle);
    border-radius: 0;
    background: transparent;
    color: var(--text-primary);
    font: 400 18px / 1 var(--font-core);
    cursor: pointer;
  }

  .close-button:hover {
    background: var(--white-a12);
  }

  .drawer-search {
    border-bottom: 1px solid var(--border-subtle);
    padding: 14px;
  }

  .drawer-search form {
    display: flex;
  }

  .drawer-search input {
    min-width: 0;
    flex: 1;
    border: 1px solid var(--border-strong);
    border-radius: 0;
    background: var(--surface-raised);
    color: var(--text-primary);
    padding: 13px 14px;
    outline: none;
  }

  .drawer-search form button {
    flex: none;
    border: 0;
    border-radius: 0;
    background: var(--green-600);
    color: #fff;
    padding: 0 15px;
    font: 600 11px / 1 var(--font-core);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .search-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 11px;
  }

  .search-chips a {
    border: 1px solid var(--border-subtle);
    color: var(--text-tertiary);
    padding: 9px 10px;
    font: 400 12px / 1 var(--font-core);
    text-decoration: none;
  }

  .search-chips a:hover {
    background: var(--white-a12);
    color: var(--text-primary);
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
  }

  .drawer-nav a {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid var(--border-subtle);
    padding: 0 14px;
    color: var(--text-primary);
    font: 400 15px / 1.3 var(--font-core);
    text-decoration: none;
  }

  .drawer-nav a:hover {
    background: var(--white-a08);
  }

  .nav-count {
    color: var(--text-brand);
    font: 600 12px / 1 var(--font-core);
    font-variant-numeric: tabular-nums;
  }

  .push-prompt {
    margin: 14px;
    border: 1px solid var(--border-strong);
    background: var(--surface-raised);
    padding: 15px;
  }

  .push-prompt h2 {
    margin: 0;
    color: var(--text-primary);
    font: 600 14px / 1.4 var(--font-core);
  }

  .push-prompt p {
    margin: 7px 0 0;
    color: var(--text-tertiary);
    font: 400 13px / 1.5 var(--font-core);
  }

  .push-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 13px;
  }

  .push-actions button {
    min-height: 44px;
    border-radius: 0;
    padding: 13px 14px;
    font: 600 11px / 1 var(--font-core);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .allow-button {
    flex: 1 1 auto;
    border: 0;
    background: var(--green-600);
    color: #fff;
  }

  .not-now-button {
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text-secondary);
  }

  .push-allowed {
    align-items: center;
    gap: 10px;
    margin: 14px;
    border: 1px solid var(--border-subtle);
    padding: 14px;
  }

  .push-allowed:not([hidden]) {
    display: flex;
  }

  .push-allowed > span {
    width: 7px;
    height: 7px;
    flex: none;
    background: var(--green-neon);
  }

  .push-allowed p {
    margin: 0;
    color: var(--text-secondary);
    font: 400 13px / 1.5 var(--font-core);
  }

  .push-allowed a {
    color: var(--text-primary);
    font-weight: 600;
  }

  .drawer-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: auto;
    border-top: 1px solid var(--border-subtle);
    padding: 14px;
  }

  .drawer-footer a {
    color: var(--text-tertiary);
    font: 400 12.5px / 1.4 var(--font-core);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 1084px) {
    .drawer-overlay {
      display: none;
    }
  }
</style>
