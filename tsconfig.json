{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true
  },
  "include": [".astro/types.d.ts", "src/**/*.ts", "src/**/*.astro", "workers/**/*.ts", "astro.config.mjs"],
  "exclude": ["dist", "node_modules", "_ds", "uploads", "support.js", "image-slot.js", "*.dc.html", "freetins-handoff.html"]
}
